<%# PARTIAL hero reutilizable. Uso: include('parciales/hero', { icono, titulo, subtitulo, stats:[{label,value}], grad }) — grad opcional %>
<div class="rsp-hero" <% if (typeof grad !== 'undefined' && grad) { %>style="background:<%= grad %>"<% } %>>
  <div class="rsp-hero-content">
    <div style="width:84px;height:84px;border-radius:20px;background:rgba(255,255,255,.14);display:flex;align-items:center;justify-content:center;font-size:42px;box-shadow:0 6px 20px rgba(0,0,0,.25);border:1px solid rgba(255,255,255,.2)"><%= icono || '📊' %></div>
    <div style="flex:1;min-width:240px">
      <h1 class="rsp-hero-title"><%= titulo %></h1>
      <% if (typeof subtitulo !== 'undefined' && subtitulo) { %><p class="rsp-hero-sub"><%= subtitulo %></p><% } %>
      <% if (typeof stats !== 'undefined' && stats && stats.length) { %>
      <div class="rsp-hero-stats">
        <% stats.forEach(function(s) { %><span><%= s.label %>: <strong><%= s.value %></strong></span><% }); %>
      </div>
      <% } %>
    </div>
  </div>
</div>
