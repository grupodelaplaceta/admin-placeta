<!-- ═══ CONTABILIDAD ═══ -->
<div class="rsp-hero" style="background:linear-gradient(135deg,#3e2723 0%,#795548 100%)">
  <div class="rsp-hero-content">
    <div style="width:80px;height:80px;border-radius:16px;background:rgba(255,255,255,.13);display:flex;align-items:center;justify-content:center;font-size:38px">📒</div>
    <div>
      <h1 class="rsp-hero-title">Contabilidad de Entidades</h1>
      <p class="rsp-hero-sub">Plan contable · Libro diario (asientos) · Libro mayor · Conciliación · Obligatorio para entidades (punto 13)</p>
      <div class="rsp-hero-stats">
        <span>Cuentas del plan: <strong><%= plan.length %></strong></span>
        <span>Asientos: <strong><%= asientos.length %></strong></span>
      </div>
    </div>
  </div>
</div>

<!-- Filtro por entidad -->
<form method="get" style="display:flex;gap:8px;margin:14px 0;flex-wrap:wrap">
  <input name="entidad_eip" class="form-input" style="max-width:240px" placeholder="EIP de la entidad (EIP-XJETNL)" value="<%= filtroEIP %>">
  <button class="btn btn-primary">Libro mayor + estado</button>
  <a href="/rsp/contabilidad" class="btn btn-secondary">Limpiar</a>
  <% if (esAdmin) { %>
  <button type="button" class="btn btn-success" style="margin-left:auto" onclick="abrirModalAsiento()">➕ Nuevo asiento</button>
  <% } %>
</form>

<% if (fin) { %>
<div class="rsp-kpis" style="margin-top:0">
  <div class="rsp-kpi"><div class="rsp-kpi-icon" style="background:rgba(0,200,83,.12)">💵</div><div><div class="rsp-kpi-value"><%= fin.ingresos.toLocaleString() %></div><div class="rsp-kpi-label">Ingresos</div></div></div>
  <div class="rsp-kpi"><div class="rsp-kpi-icon" style="background:rgba(255,80,80,.12)">💸</div><div><div class="rsp-kpi-value"><%= fin.gastos.toLocaleString() %></div><div class="rsp-kpi-label">Gastos</div></div></div>
  <div class="rsp-kpi"><div class="rsp-kpi-icon" style="background:rgba(55,2,179,.12)">📊</div><div><div class="rsp-kpi-value" style="color:<%= fin.resultado>=0?'#1a7a4a':'#b82929' %>"><%= fin.resultado.toLocaleString() %></div><div class="rsp-kpi-label">Resultado</div></div></div>
  <div class="rsp-kpi"><div class="rsp-kpi-icon" style="background:rgba(41,121,255,.12)">🏦</div><div><div class="rsp-kpi-value"><%= fin.activo.toLocaleString() %></div><div class="rsp-kpi-label">Activo</div></div></div>
</div>
<% } %>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
  <!-- ASIENTOS -->
  <div class="table-container">
    <div style="padding:12px 16px;font-weight:700;font-size:13px;border-bottom:1px solid #e8e4f0">📕 Libro diario (asientos)</div>
    <table>
      <thead><tr><th>Asiento</th><th>Fecha</th><th>Entidad</th><th>Concepto</th><th>Debe</th><th>Haber</th></tr></thead>
      <tbody>
        <% if (!asientos || asientos.length === 0) { %>
        <tr><td colspan="6" style="text-align:center;color:#999;padding:20px">Sin asientos.</td></tr>
        <% } %>
        <% (asientos||[]).slice(0,15).forEach(function(a) { %>
        <tr onclick="window.location='/rsp/contabilidad/asiento/<%= a.id %>'" style="cursor:pointer">
          <td style="font-size:11px"><%= a.id %></td>
          <td style="font-size:11px"><%= a.fecha %></td>
          <td><%= a.entidad_eip %></td>
          <td style="font-size:12px;max-width:180px"><%= a.concepto %></td>
          <td style="color:#1a7a4a"><%= a.total_debe %></td>
          <td style="color:#b82929"><%= a.total_haber %></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <!-- LIBRO MAYOR (si hay EIP) -->
  <div class="table-container">
    <div style="padding:12px 16px;font-weight:700;font-size:13px;border-bottom:1px solid #e8e4f0">📗 Libro mayor <%= fin ? '— ' + filtroEIP : '' %></div>
    <% if (fin) { %>
    <table>
      <thead><tr><th>Cuenta</th><th>Nombre</th><th>Debe</th><th>Haber</th><th>Saldo</th><th>Mov.</th></tr></thead>
      <tbody>
        <% (mayor||[]).forEach(function(c) { %>
        <tr>
          <td><strong><%= c.cuenta %></strong></td>
          <td style="font-size:12px"><%= c.nombre %></td>
          <td><%= c.debe %></td>
          <td><%= c.haber %></td>
          <td style="color:<%= c.saldo>=0?'#1a7a4a':'#b82929' %>"><%= c.saldo %></td>
          <td><%= c.movimientos %></td>
        </tr>
        <% }); %>
        <% if (!mayor || mayor.length===0) { %><tr><td colspan="6" style="text-align:center;color:#999;padding:20px">Sin movimientos para esta entidad.</td></tr><% } %>
      </tbody>
    </table>
    <% } else { %>
    <div style="padding:20px;text-align:center;color:#999">Introduce un EIP para ver el libro mayor y el estado financiero.</div>
    <% } %>
  </div>
</div>

<div class="table-container" style="margin-top:16px">
  <div style="padding:12px 16px;font-weight:700;font-size:13px;border-bottom:1px solid #e8e4f0">📋 Plan contable</div>
  <table>
    <thead><tr><th>Código</th><th>Cuenta</th><th>Tipo</th><th>Grupo</th></tr></thead>
    <tbody>
      <% (plan||[]).forEach(function(c) { %>
      <tr><td><strong><%= c.codigo %></strong></td><td><%= c.nombre %></td><td><span class="badge badge-purple"><%= c.tipo %></span></td><td style="font-size:12px"><%= c.grupo %></td></tr>
      <% }); %>
    </tbody>
  </table>
</div>

<!-- MODAL ASIENTO -->
<div id="modalAsiento" style="display:none;position:fixed;inset:0;background:rgba(10,5,30,.55);z-index:200;align-items:center;justify-content:center">
  <div style="background:#fff;border-radius:16px;max-width:640px;width:92%;max-height:90vh;overflow:auto;padding:24px">
    <h3 style="margin:0 0 16px">➕ Nuevo asiento</h3>
    <div style="display:grid;gap:10px">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
        <div><label class="form-label">Entidad (EIP) *</label><input id="asi_eip" class="form-input" placeholder="EIP-XJETNL"></div>
        <div><label class="form-label">Nombre entidad</label><input id="asi_nombre" class="form-input"></div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 2fr;gap:10px">
        <div><label class="form-label">Fecha *</label><input id="asi_fecha" type="date" class="form-input"></div>
        <div><label class="form-label">Concepto *</label><input id="asi_concepto" class="form-input"></div>
      </div>
      <div><label class="form-label">Líneas (cuenta | debe | haber | concepto), una por línea</label>
        <textarea id="asi_lineas" class="form-input" rows="5" placeholder="572 | 100 | 0 | Aportación inicial&#10;100 | 0 | 100 | Capital social"></textarea>
      </div>
    </div>
    <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:16px">
      <button class="btn btn-secondary" onclick="document.getElementById('modalAsiento').style.display='none'">Cancelar</button>
      <button class="btn btn-primary" onclick="crearAsiento()">Contabilizar</button>
    </div>
  </div>
</div>

<script>
function abrirModalAsiento(){ document.getElementById('modalAsiento').style.display='flex'; }
document.getElementById('modalAsiento').addEventListener('click', function(e){ if(e.target===this) this.style.display='none'; });
async function crearAsiento(){
  const lineas = document.getElementById('asi_lineas').value.trim().split('\n').map(l => {
    const [cuenta, debe, haber, ...resto] = l.split('|').map(s => s.trim());
    return { cuenta, debe: parseFloat(debe)||0, haber: parseFloat(haber)||0, concepto: resto.join('|') || '' };
  }).filter(l => l.cuenta);
  const payload = {
    entidad_eip: document.getElementById('asi_eip').value.trim(),
    entidad_nombre: document.getElementById('asi_nombre').value.trim(),
    fecha: document.getElementById('asi_fecha').value,
    concepto: document.getElementById('asi_concepto').value.trim(),
    lineas,
  };
  if(!payload.entidad_eip || !payload.fecha || !payload.concepto){ alert('Entidad, fecha y concepto son obligatorios'); return; }
  try {
    const r = await fetch('/rsp/contabilidad/api/asientos', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload) });
    const j = await r.json();
    if(!j.success) throw new Error(j.error);
    alert('✅ Asiento contabilizado: ' + j.asiento.id);
    window.location = '/rsp/contabilidad/asiento/' + j.asiento.id;
  } catch(e){ alert('Error: ' + e.message); }
}
</script>
