<%# PARTIAL kpis. Uso: include('parciales/kpis', { kpis:[{icono,valor,label,color}], cols }) — cols opcional %>
<div class="rsp-kpis" <% if (typeof cols !== 'undefined' && cols) { %>style="grid-template-columns:repeat(<%= cols %>,1fr)"<% } %>>
  <% (kpis || []).forEach(function(k) { %>
  <div class="rsp-kpi">
    <div class="rsp-kpi-icon" style="background:<%= k.color || 'rgba(124,58,237,.12)' %>"><%= k.icono || '📊' %></div>
    <div>
      <div class="rsp-kpi-value" <% if (k.valorColor) { %>style="color:<%= k.valorColor %>"<% } %>><%= k.valor %></div>
      <div class="rsp-kpi-label"><%= k.label %></div>
    </div>
  </div>
  <% }); %>
</div>
