<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo || 'RSP — Red de Servicios de La Placeta' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin-v5.css">
  <link rel="stylesheet" href="/css/rsp-vivid.css">
  <link rel="icon" href="/img/favicon-rsp.png" type="image/png">
</head>
<body class="<%= workspaceActivo ? 'workspace-active' : '' %><%= workspaceActivo && workspaceActivo.id === 'rsp' ? ' rsp-theme' : '' %>">
  <a class="skip-link" href="#contenido-principal">Saltar al contenido</a>
  <% if (usuario) { %>
  <!-- ═══ SIDEBAR ═══ -->
  <aside class="sidebar" id="sidebar"
    <% if (workspaceActivo) { %>
    data-workspace="<%= workspaceActivo.id %>"
    style="--ws-color: <%= workspaceActivo.color %>; --ws-dark: <%= workspaceActivo.colorDark %>"
    <% } %>
  >
    <!-- Workspace Switcher -->
    <div class="sidebar-switcher">
      <button class="ws-switcher-btn" onclick="toggleWorkspaceSwitcher()" title="Cambiar de workspace">
        <% if (workspaceActivo) { %>
        <% if (workspaceActivo.logo) { %>
        <img src="<%= workspaceActivo.logo %>" alt="" class="ws-switcher-logo" onerror="this.style.display='none';this.nextElementSibling.style.display=''">
        <span class="ws-switcher-icon" style="display:none"><%= workspaceActivo.icono %></span>
        <% } else { %>
        <span class="ws-switcher-icon"><%= workspaceActivo.icono %></span>
        <% } %>
        <span class="ws-switcher-info">
          <span class="ws-switcher-name"><%= workspaceActivo.nombre %></span>
          <span class="ws-switcher-hint">Cambiar workspace ▾</span>
        </span>
        <% } else { %>
        <span class="ws-switcher-icon">🏛️</span>
        <span class="ws-switcher-info">
          <span class="ws-switcher-name">RSP</span>
          <span class="ws-switcher-hint">Panel Principal</span>
        </span>
        <% } %>
      </button>
      <!-- Dropdown workspaces -->
      <div class="ws-dropdown" id="wsDropdown">
        <div class="ws-dropdown-header">Tus Workspaces</div>
        <a href="/dashboard" class="ws-option <%= !workspaceActivo ? 'active' : '' %>" data-ws="inicio">
          <span class="ws-option-icon">🏛️</span>
          <span class="ws-option-info">
            <span class="ws-option-name">Panel Principal</span>
            <span class="ws-option-desc">Inicio y resumen general</span>
          </span>
        </a>
        <% workspacesDisponibles && workspacesDisponibles.forEach(function(ws) { %>
        <a href="/<%= ws.id %>" class="ws-option <%= workspaceActivo && workspaceActivo.id === ws.id ? 'active' : '' %>"
           data-ws="<%= ws.id %>"
           style="--ws-opt-color: <%= ws.color %>">
          <% if (ws.logo) { %>
          <img src="<%= ws.logo %>" alt="" class="ws-option-img" onerror="this.style.display='none';this.nextElementSibling.style.display=''">
          <span class="ws-option-icon" style="display:none"><%= ws.icono %></span>
          <% } else { %>
          <span class="ws-option-icon"><%= ws.icono %></span>
          <% } %>
          <span class="ws-option-info">
            <span class="ws-option-name"><%= ws.nombre %></span>
            <span class="ws-option-desc"><%= ws.descripcion %></span>
          </span>
        </a>
        <% }); %>
      </div>
    </div>

    <!-- Navegación del Workspace -->
    <nav class="sidebar-nav">
      <% if (workspaceActivo) { %>
        <% workspaceActivo.secciones && workspaceActivo.secciones.forEach(function(seccion) { %>
        <div class="nav-section">
          <span class="nav-section-title"><%= seccion.titulo %></span>
          <% seccion.enlaces && seccion.enlaces.forEach(function(enlace) { %>
          <a href="<%= enlace.url %>"
             class="nav-item <%= pathActual === enlace.url || (enlace.url !== '/' + workspaceActivo.id && pathActual.startsWith(enlace.url + '/')) ? 'active' : '' %>">
            <span class="nav-icon"><%= enlace.icono %></span>
            <span class="nav-label"><%= enlace.texto %></span>
          </a>
          <% }); %>
        </div>
        <% }); %>
      <% } else { %>
        <!-- Vista global: mostrar acceso rápido a todos los workspaces -->
        <div class="nav-section">
          <span class="nav-section-title">🏛️ INICIO</span>
          <a href="/dashboard" class="nav-item <%= pathActual === '/dashboard' ? 'active' : '' %>">
            <span class="nav-icon">📊</span>
            <span class="nav-label">Panel Principal</span>
          </a>
        </div>
        <% workspacesDisponibles && workspacesDisponibles.forEach(function(ws) { %>
        <div class="nav-section">
          <span class="nav-section-title"><%= ws.icono %> <%= ws.nombre %></span>
          <% if (ws.secciones && ws.secciones[0]) { %>
            <% ws.secciones[0].enlaces && ws.secciones[0].enlaces.slice(0, 4).forEach(function(enlace) { %>
            <a href="<%= enlace.url %>" class="nav-item">
              <span class="nav-icon"><%= enlace.icono %></span>
              <span class="nav-label"><%= enlace.texto %></span>
            </a>
            <% }); %>
          <% } %>
          <a href="/<%= ws.id %>" class="nav-item nav-item-more">
            <span class="nav-icon">→</span>
            <span class="nav-label">Ver todo</span>
          </a>
        </div>
        <% }); %>
      <% } %>
    </nav>

    <!-- Footer -->
    <div class="sidebar-footer">
      <div class="user-info">
        <div class="user-avatar"><%= (usuario.nombre || 'U').charAt(0).toUpperCase() %></div>
        <div class="user-data">
          <div class="user-name"><%= usuario.nombre %></div>
          <div class="user-roles"><%= (roles || []).slice(0, 2).join(', ') %></div>
        </div>
      </div>
      <div class="sidebar-footer-actions">
        <a href="/dashboard" class="footer-btn" title="Panel Principal">🏛️</a>
        <a href="/logout" class="logout-btn" title="Cerrar sesión">🚪</a>
      </div>
    </div>
  </aside>

  <!-- ═══ MAIN CONTENT ═══ -->
  <main class="main-content" id="contenido-principal">
    <div class="content-header">
      <button class="hamburger" onclick="toggleSidebar()">☰</button>
      <div class="content-breadcrumb">
        <% if (workspaceActivo) { %>
        <a href="/dashboard" class="breadcrumb-link">Inicio</a>
        <span class="breadcrumb-sep">›</span>
        <a href="/<%= workspaceActivo.id %>" class="breadcrumb-link active">
          <% if (workspaceActivo.logo) { %>
          <img src="<%= workspaceActivo.logo %>" alt="" class="breadcrumb-logo" onerror="this.style.display='none';this.nextElementSibling.style.display=''">
          <span style="display:none"><%= workspaceActivo.icono %></span>
          <% } else { %>
          <span><%= workspaceActivo.icono %></span>
          <% } %>
          <%= workspaceActivo.nombre %>
        </a>
        <% if (typeof seccionActual !== 'undefined' && seccionActual) { %>
        <span class="breadcrumb-sep">›</span>
        <span class="breadcrumb-current"><%= seccionActual %></span>
        <% } %>
        <% } else { %>
        <span class="breadcrumb-current">🏛️ Panel Principal</span>
        <% } %>
      </div>
      <div class="header-actions">
        <% if (workspaceActivo) { %>
        <span class="badge-entidad" style="background: <%= workspaceActivo.color %>15; color: <%= workspaceActivo.color %>">
          <%= workspaceActivo.icono %> <%= workspaceActivo.nombre %>
        </span>
        <% } else { %>
        <span class="badge-entidad">🏛️ RSP</span>
        <% } %>

        <!-- Buscador global de ciudadanos (estilo agente bancario) -->
        <div class="global-search" id="globalSearch">
          <input type="text" class="global-search-input" id="globalSearchInput" placeholder="🔍 Buscar ciudadano: DIP, PlacetaID, nombre…" autocomplete="off">
          <div class="global-search-dd" id="globalSearchDD"></div>
        </div>

        <!-- Campana de notificaciones -->
        <div class="bell-wrap">
          <button class="bell-btn" onclick="toggleBell(event)" title="Notificaciones">
            🔔
            <span class="bell-count" id="bellCount" style="display:none">0</span>
          </button>
          <div class="bell-dropdown" id="bellDropdown">
            <div class="bell-dd-header">
              <span>🔔 Notificaciones</span>
              <button class="btn-link" onclick="marcarTodasBell()" style="font-size:11px">Marcar leídas</button>
            </div>
            <div class="bell-dd-list" id="bellList">
              <div class="bell-dd-empty">Cargando…</div>
            </div>
          </div>
        </div>

        <!-- Chip de usuario -->
        <div class="user-chip" title="Tu sesión">
          <div class="uc-avatar"><%= (usuario.nombre || 'U').charAt(0).toUpperCase() %></div>
          <div>
            <div class="uc-name"><%= usuario.nombre %></div>
            <div class="uc-role"><%= (roles || []).slice(0, 1).join(', ') || 'usuario' %></div>
          </div>
        </div>
      </div>
    </div>
    <div class="content-body">
      <%- body %>
    </div>
  </main>

  <!-- Toast root -->
  <div id="toast-root"></div>

  <!-- Modal genérico -->
  <div class="modal-overlay" id="modalRoot">
    <div class="modal-box" id="modalBox"></div>
  </div>

  <script src="/js/admin.js"></script>
  <script>
    // ── Helpers globales UI ─────────────────────────────────────────
    function toast(msj, tipo) {
      const root = document.getElementById('toast-root');
      if (!root) return alert(msj);
      const icons = { success: '✅', error: '❌', warning: '⚠️' };
      const el = document.createElement('div');
      el.className = 'toast ' + (tipo || 'success');
      el.innerHTML = '<span class="toast-ico">' + (icons[tipo] || 'ℹ️') + '</span><span class="toast-msg"></span>';
      el.querySelector('.toast-msg').textContent = msj;
      root.appendChild(el);
      setTimeout(() => { el.style.opacity = '0'; el.style.transition = 'opacity .3s'; setTimeout(() => el.remove(), 320); }, 3200);
    }
    function abrirModal(html) {
      document.getElementById('modalBox').innerHTML = html;
      document.getElementById('modalRoot').classList.add('open');
    }
    function cerrarModal() { document.getElementById('modalRoot').classList.remove('open'); }
    document.getElementById('modalRoot').addEventListener('click', function (e) { if (e.target === this) cerrarModal(); });

    // ── Campana de notificaciones ───────────────────────────────────
    const NIVEL_EMOJI = { accion: '🔴', pendiente: '🟡', info: '🔵', completado: '🟢' };
    function toggleBell(ev) {
      ev.stopPropagation();
      const dd = document.getElementById('bellDropdown');
      const open = dd.classList.toggle('open');
      if (open) cargarBell();
    }
    document.addEventListener('click', function (ev) {
      if (!document.getElementById('bellDropdown').contains(ev.target)) {
        document.getElementById('bellDropdown').classList.remove('open');
      }
    });
    async function cargarBell() {
      try {
        const r = await fetch('/api/notificaciones/mis');
        const j = await r.json();
        const list = document.getElementById('bellList');
        const count = document.getElementById('bellCount');
        if (!j.success) { list.innerHTML = '<div class="bell-dd-empty">Sin acceso</div>'; return; }
        const noLeidas = j.estado ? j.estado.noLeidas : 0;
        count.style.display = noLeidas > 0 ? 'flex' : 'none';
        count.textContent = noLeidas;
        if (!j.notificaciones || !j.notificaciones.length) {
          list.innerHTML = '<div class="bell-dd-empty">No hay notificaciones 🎉</div>';
          return;
        }
        list.innerHTML = j.notificaciones.map(function (n) {
          const unread = !n.leida ? ' unread' : '';
          const emoji = NIVEL_EMOJI[n.nivel] || '🔵';
          const time = n.fecha ? n.fecha.slice(0, 16).replace('T', ' ') : '';
          return '<div class="bell-item' + unread + '" onclick="leerBell(\'' + n.id + '\')">' +
            '<span class="bell-ico">' + emoji + '</span>' +
            '<div class="bell-txt"><div class="bell-title">' + (n.titulo || '') + '</div>' +
            (n.mensaje ? '<div class="bell-msg">' + n.mensaje + '</div>' : '') +
            '<div class="bell-time">' + time + (n.servicio ? ' · ' + n.servicio : '') + '</div></div></div>';
        }).join('');
      } catch (e) { document.getElementById('bellList').innerHTML = '<div class="bell-dd-empty">Error</div>'; }
    }
    async function leerBell(id) {
      await fetch('/api/notificaciones/' + id + '/leida', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ leida: true }) });
      cargarBell();
    }
    async function marcarTodasBell() {
      await fetch('/api/notificaciones/mis', { method: 'GET' });
      const r = await fetch('/rsp/notificaciones/api/notificaciones/marcar-todas', { method: 'POST', headers: { 'Content-Type': 'application/json' } }).catch(() => null);
      cargarBell();
    }
    // Cargar contador de la campana al inicio
    fetch('/api/notificaciones/mis').then(r => r.json()).then(j => {
      if (j.success && j.estado && j.estado.noLeidas > 0) {
        document.getElementById('bellCount').style.display = 'flex';
        document.getElementById('bellCount').textContent = j.estado.noLeidas;
      }
    }).catch(() => {});

    // ── Buscador global de ciudadanos (estilo agente bancario) ──────
    function escHTML(s) {
      return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
    const gsInput = document.getElementById('globalSearchInput');
    if (gsInput) {
      let gsTimer = null;
      gsInput.addEventListener('input', function () {
        clearTimeout(gsTimer);
        const q = this.value.trim();
        if (q.length < 2) { document.getElementById('globalSearchDD').classList.remove('open'); return; }
        gsTimer = setTimeout(function () { buscarCiudadanos(q); }, 350);
      });
      gsInput.addEventListener('focus', function () { if (this.value.trim().length >= 2) document.getElementById('globalSearchDD').classList.add('open'); });
      gsInput.addEventListener('keydown', function (ev) { if (ev.key === 'Enter') { ev.preventDefault(); buscarCiudadanos(this.value.trim()); } });
      document.addEventListener('click', function (ev) {
        const box = document.getElementById('globalSearch');
        if (!box.contains(ev.target)) document.getElementById('globalSearchDD').classList.remove('open');
      });
    }
    async function buscarCiudadanos(q, ddId) {
      const dd = document.getElementById(ddId || 'globalSearchDD');
      if (!dd || !q || q.length < 2) return;
      dd.innerHTML = '<div class="gs-loading">Buscando…</div>';
      dd.classList.add('open');
      try {
        const r = await fetch('/api/buscar-ciudadanos?q=' + encodeURIComponent(q));
        const j = await r.json();
        if (!j.success || !j.results || !j.results.length) {
          dd.innerHTML = '<div class="gs-empty">Sin resultados para «' + escHTML(q) + '»</div>';
          return;
        }
        dd.innerHTML = '<div class="gs-header">' + j.total + ' coincidencia' + (j.total !== 1 ? 's' : '') + '</div>' +
          j.results.map(function (m) {
            const badge = m.enPlacetaID ? '<span class="gs-badge gs-badge-ok">✔ PlacetaID</span>' : '<span class="gs-badge gs-badge-warn">· Sin PlacetaID</span>';
            const cuentas = m.cuentas.length ? m.cuentas.length + ' cuenta' + (m.cuentas.length !== 1 ? 's' : '') : '0 cuentas';
            return '<a class="gs-item" href="javascript:void(0)" onclick="verFichaCiudadano(\'' + escHTML(m.dip) + '\')">' +
              '<div class="gs-item-main"><span class="gs-item-name">' + escHTML(m.nombre) + '</span>' + badge + '</div>' +
              '<div class="gs-item-sub">' + escHTML(m.dip) + (m.placetaId && m.placetaId !== m.dip ? ' · ' + escHTML(m.placetaId) : '') + '</div>' +
              '<div class="gs-item-meta">' + cuentas + (m.esEmpresa ? ' · 🏢 empresa' : '') + (m.declaraciones ? ' · 📄 ' + m.declaraciones + ' declarac.' : '') + '</div>' +
              '</a>';
          }).join('');
      } catch (e) {
        dd.innerHTML = '<div class="gs-empty">Error de búsqueda</div>';
      }
    }
    function verFichaCiudadano(dip) {
      ['globalSearchDD', 'rspHeroSearchDD'].forEach(function (id) {
        const el = document.getElementById(id);
        if (el) el.classList.remove('open');
      });
      abrirModal(
        '<div style="text-align:left">' +
        '<div class="modal-title-row"><h3 style="margin:0">👤 Ficha ciudadano</h3><button class="modal-close-btn" onclick="cerrarModal()">✕</button></div>' +
        '<div id="fichaCiudadano" style="min-height:120px;margin-top:12px">Cargando…</div>' +
        '</div>'
      );
      fetch('/api/buscar-ciudadanos?q=' + encodeURIComponent(dip))
        .then(r => r.json())
        .then(j => {
          const m = (j.results || []).find(x => x.dip === dip);
          const box = document.getElementById('fichaCiudadano');
          if (!m) { box.innerHTML = 'No encontrado'; return; }
          const cuentas = m.cuentas.map(c => '<tr><td class="text-mono">' + escHTML(c.id) + '</td><td>' + escHTML(c.type) + '</td><td class="text-mono">' + escHTML(c.eip || '—') + '</td></tr>').join('');
          box.innerHTML =
            '<p style="font-size:15px"><strong>' + escHTML(m.nombre) + '</strong> · <span class="text-mono">' + escHTML(m.dip) + '</span>' +
            (m.placetaId && m.placetaId !== m.dip ? ' · <span class="text-mono">' + escHTML(m.placetaId) + '</span>' : '') + '</p>' +
            '<p style="font-size:13px">' + (m.enPlacetaID ? '✅ Registrado en PlacetaID' : '⚠️ Sin registro PlacetaID (usa el alta automática)') +
            (m.esEmpresa ? ' · 🏢 Tiene empresas' : '') + (m.declaraciones ? ' · 📄 ' + m.declaraciones + ' declaraciones' : '') + '</p>' +
            (m.cuentas.length ? '<div class="table-container" style="border:none;padding:0"><table><thead><tr><th>Cuenta</th><th>Tipo</th><th>EIP</th></tr></thead><tbody>' + cuentas + '</tbody></table></div>' : '<p>Sin cuentas</p>') +
            '<div style="display:flex;gap:8px;margin-top:14px;flex-wrap:wrap">' +
            '<a class="btn-sm btn-primary" href="/tributos/contribuyentes">👤 Contribuyentes</a>' +
            '<a class="btn-sm btn-primary" href="/tributos/declaraciones">📄 Declaraciones</a>' +
            '<a class="btn-sm btn-primary" href="/administracion/placetaid">🪪 PlacetaID</a>' +
            '<a class="btn-sm btn-primary" href="/administracion/empresas">🏢 Empresas</a>' +
            '<a class="btn-sm btn-primary" href="/administracion/placetaid/sincronizacion">🔄 Alta PlacetaID</a>' +
            '</div>';
        })
        .catch(() => { document.getElementById('fichaCiudadano').innerHTML = 'Error'; });
    }
  </script>
  <% } else { %>
  <%- body %>
  <% } %>
</body>
</html>
