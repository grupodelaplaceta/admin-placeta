<!-- ═══ COMPROBACIÓN ═══ -->
<div class="rsp-hero" style="background:linear-gradient(135deg,#0b3d2e 0%,#166534 100%)">
  <div class="rsp-hero-content">
    <div style="width:80px;height:80px;border-radius:16px;background:rgba(255,255,255,.13);display:flex;align-items:center;justify-content:center;font-size:38px">🔍</div>
    <div>
      <h1 class="rsp-hero-title">Comprobación del Ecosistema</h1>
      <p class="rsp-hero-sub">Banco ↔ Contabilidad ↔ Facturación ↔ Nóminas ↔ Tributos ↔ Declaraciones · 🟢 Conciliado · 🟡 Diferencia · 🔴 Inconsistencia</p>
      <div class="rsp-hero-stats">
        <span>🟢 OK: <strong><%= estado.ok %></strong></span>
        <span>🟡 Diferencias: <strong><%= estado.diferencia %></strong></span>
        <span>🔴 Inconsistencias: <strong><%= estado.inconsistencia %></strong></span>
        <span>Total: <strong><%= estado.total %></strong></span>
      </div>
    </div>
  </div>
</div>

<div style="display:flex;gap:8px;margin:14px 0;flex-wrap:wrap">
  <% if (esAdmin) { %>
  <button class="btn btn-primary" onclick="ejecutar()">▶️ Ejecutar comprobación global</button>
  <% } %>
  <a href="/rsp/comprobacion" class="btn btn-sm <%= !filtroResultado?'btn-primary':'btn-secondary' %>">Todas</a>
  <a href="/rsp/comprobacion?resultado=inconsistencia" class="btn btn-sm <%= filtroResultado==='inconsistencia'?'btn-primary':'btn-secondary' %>">🔴 Inconsistencias</a>
  <a href="/rsp/comprobacion?resultado=diferencia" class="btn btn-sm <%= filtroResultado==='diferencia'?'btn-primary':'btn-secondary' %>">🟡 Diferencias</a>
</div>

<div class="table-container">
  <table>
    <thead><tr><th>Comprobación</th><th>Tipo</th><th>Resultado</th><th>Esperado</th><th>Encontrado</th><th>Diferencia</th><th>Detalle</th></tr></thead>
    <tbody>
      <% if (!checks || checks.length === 0) { %>
      <tr><td colspan="7" style="text-align:center;color:#999;padding:24px">Sin comprobaciones. Ejecuta la comprobación global.</td></tr>
      <% } %>
      <% (checks||[]).forEach(function(c) { %>
      <tr>
        <td style="font-size:11px"><strong><%= c.id %></strong></td>
        <td><span class="badge badge-purple"><%= c.tipo %></span></td>
        <td>
          <% if (c.resultado==='ok') { %><span class="badge badge-success">🟢 Conciliado</span><% } else if (c.resultado==='diferencia') { %><span class="badge badge-warning">🟡 Diferencia</span><% } else { %><span class="badge badge-danger">🔴 Inconsistencia</span><% } %>
        </td>
        <td><%= (c.importe_esperado||0).toLocaleString() %></td>
        <td><%= (c.importe_encontrado||0).toLocaleString() %></td>
        <td style="color:<%= Math.abs(c.diferencia)>0.01 ? '#b82929':'#1a7a4a' %>"><%= (c.diferencia||0).toLocaleString() %></td>
        <td style="font-size:11px;max-width:260px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= JSON.stringify(c.detalle||{}) %></td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<script>
async function ejecutar(){
  if(!confirm('¿Ejecutar la comprobación global del ecosistema?')) return;
  try {
    const r = await fetch('/rsp/comprobacion/api/ejecutar', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({}) });
    const j = await r.json();
    if(!j.success) throw new Error(j.error);
    alert('✅ Comprobación ejecutada\n🔴 Inconsistencias: ' + j.inconsistencias + '\n🟡 Diferencias: ' + j.diferencias + '\nTotal: ' + j.total);
    window.location.reload();
  } catch(e){ alert('Error: ' + e.message); }
}
</script>
