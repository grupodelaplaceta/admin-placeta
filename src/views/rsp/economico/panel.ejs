<!-- ═══ DASHBOARD ECONÓMICO DEL GRUPO (FASE 22) ═══ -->
<%- include('../../parciales/hero', {
  icono: '📈',
  titulo: 'Dashboard Económico del Grupo',
  subtitulo: 'Visión consolidada: liquidez · ingresos · gastos · impuestos · nóminas · patrimonio · ayudas · educación · junior · fundación',
  stats: [
    { label: 'Liquidez', value: p.liquidez.total.toLocaleString() + ' Pz' },
    { label: 'Ingresos', value: p.resultado.ingresos.toLocaleString() + ' Pz' },
    { label: 'Gastos', value: p.resultado.gastos.toLocaleString() + ' Pz' },
    { label: 'Resultado', value: p.resultado.balance.toLocaleString() + ' Pz' }
  ],
  grad: 'linear-gradient(135deg,#0b3d2e 0%,#166534 55%,#16a34a 100%)'
}) %>

<!-- Filtro periodo -->
<form method="get" style="display:flex;gap:8px;align-items:center;margin-bottom:6px;flex-wrap:wrap">
  <label class="form-label" style="margin:0">Periodo:</label>
  <input type="month" name="periodo" class="form-input" style="max-width:170px" value="<%= periodo %>">
  <button class="btn btn-primary btn-sm">Filtrar</button>
</form>

<!-- ═══ KPIs PRINCIPALES ═══ -->
<div class="rsp-kpis" style="grid-template-columns:repeat(auto-fit,minmax(170px,1fr))">
  <div class="rsp-kpi">
    <div class="rsp-kpi-icon" style="background:rgba(34,197,94,.12)">💧</div>
    <div><div class="rsp-kpi-value"><%= p.liquidez.total.toLocaleString() %></div><div class="rsp-kpi-label">Liquidez total (Pz)</div></div>
  </div>
  <div class="rsp-kpi">
    <div class="rsp-kpi-icon" style="background:rgba(34,197,94,.12)">💵</div>
    <div><div class="rsp-kpi-value"><%= p.resultado.ingresos.toLocaleString() %></div><div class="rsp-kpi-label">Ingresos</div></div>
  </div>
  <div class="rsp-kpi">
    <div class="rsp-kpi-icon" style="background:rgba(239,68,68,.12)">💸</div>
    <div><div class="rsp-kpi-value"><%= p.resultado.gastos.toLocaleString() %></div><div class="rsp-kpi-label">Gastos</div></div>
  </div>
  <div class="rsp-kpi">
    <div class="rsp-kpi-icon" style="background:rgba(59,130,246,.12)">🧮</div>
    <div><div class="rsp-kpi-value" style="color:<%= p.resultado.balance>=0 ? '#16a34a' : '#dc2626' %>"><%= p.resultado.balance.toLocaleString() %></div><div class="rsp-kpi-label">Resultado</div></div>
  </div>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:18px">
  <!-- LIQUIDEZ -->
  <div class="rsp-card">
    <div class="rsp-card-header"><span>💧 Liquidez</span></div>
    <div style="padding:16px 20px">
      <div class="rsp-info-grid" style="grid-template-columns:1fr 1fr">
        <div class="rsp-info-card"><strong><%= p.liquidez.total.toLocaleString() %> Pz</strong><p>Total</p></div>
        <div class="rsp-info-card"><strong><%= p.liquidez.empresas.toLocaleString() %> Pz</strong><p>Empresas</p></div>
        <div class="rsp-info-card"><strong><%= p.liquidez.personas.toLocaleString() %> Pz</strong><p>Personas</p></div>
        <div class="rsp-info-card"><strong><%= p.liquidez.cuentas %> / <%= p.liquidez.operaciones %></strong><p>Cuentas / Operaciones</p></div>
      </div>
    </div>
  </div>

  <!-- IMPUESTOS -->
  <div class="rsp-card">
    <div class="rsp-card-header"><span>🧮 Impuestos</span></div>
    <div style="padding:16px 20px">
      <div class="rsp-info-grid" style="grid-template-columns:1fr 1fr">
        <div class="rsp-info-card"><strong><%= p.impuestos.iva.toLocaleString() %> Pz</strong><p>IVA</p></div>
        <div class="rsp-info-card"><strong><%= p.impuestos.desgravaciones.toLocaleString() %> Pz</strong><p>Desgravaciones</p></div>
        <div class="rsp-info-card"><strong><%= p.impuestos.retribuciones.toLocaleString() %> Pz</strong><p>Retribuciones 250</p></div>
        <div class="rsp-info-card"><strong style="color:#16a34a"><%= p.impuestos.neto.toLocaleString() %> Pz</strong><p>Neto impuestos</p></div>
      </div>
    </div>
  </div>

  <!-- NÓMINAS -->
  <div class="rsp-card">
    <div class="rsp-card-header"><span>📄 Nóminas</span></div>
    <div style="padding:16px 20px">
      <div class="rsp-info-grid" style="grid-template-columns:1fr 1fr">
        <div class="rsp-info-card"><strong><%= p.nominas.total %> / <%= p.nominas.pagadas %></strong><p>Totales / Pagadas</p></div>
        <div class="rsp-info-card"><strong><%= p.nominas.neto.toLocaleString() %> Pz</strong><p>Neto</p></div>
        <div class="rsp-info-card"><strong><%= p.nominas.retenciones.toLocaleString() %> Pz</strong><p>Retenciones</p></div>
        <div class="rsp-info-card"><strong><%= p.nominas.cotizacionEmpresa.toLocaleString() %> Pz</strong><p>Cotización empresa</p></div>
      </div>
    </div>
  </div>

  <!-- FUNDACIÓN / AYUDAS -->
  <div class="rsp-card">
    <div class="rsp-card-header"><span>🏛️ Fundación y ayudas</span></div>
    <div style="padding:16px 20px">
      <div class="rsp-info-grid" style="grid-template-columns:1fr 1fr">
        <div class="rsp-info-card"><strong><%= p.ayudas.solicitudes %> / <%= p.ayudas.concedidas %> / <%= p.ayudas.pagadas %></strong><p>Solicitudes / Concedidas / Pagadas</p></div>
        <div class="rsp-info-card"><strong><%= p.ayudas.totalConcedido.toLocaleString() %> Pz</strong><p>Total concedido</p></div>
        <div class="rsp-info-card"><strong><%= p.fundacion.presupuesto.toLocaleString() %> Pz</strong><p>Presupuesto programas</p></div>
        <div class="rsp-info-card"><strong><%= p.junior.campanasActivas %> · <%= p.fundacion.desviado.toLocaleString() %> Pz</strong><p>Campañas activas · Desviado</p></div>
      </div>
    </div>
  </div>

  <!-- CONTABILIDAD -->
  <div class="rsp-card">
    <div class="rsp-card-header"><span>📒 Contabilidad</span></div>
    <div style="padding:16px 20px">
      <div class="rsp-info-grid" style="grid-template-columns:1fr 1fr">
        <div class="rsp-info-card"><strong><%= p.contabilidad.asientos %></strong><p>Asientos</p></div>
        <div class="rsp-info-card"><strong><%= p.contabilidad.ingresos.toLocaleString() %> Pz</strong><p>Ingresos</p></div>
        <div class="rsp-info-card"><strong><%= p.contabilidad.gastos.toLocaleString() %> Pz</strong><p>Gastos</p></div>
        <div class="rsp-info-card"><strong style="color:<%= p.contabilidad.resultado>=0 ? '#16a34a' : '#dc2626' %>"><%= p.contabilidad.resultado.toLocaleString() %> Pz</strong><p>Resultado</p></div>
      </div>
    </div>
  </div>

  <!-- COMPROBACIÓN -->
  <div class="rsp-card">
    <div class="rsp-card-header"><span>🔍 Comprobación del ecosistema</span></div>
    <div style="padding:16px 20px">
      <div class="rsp-info-grid" style="grid-template-columns:1fr 1fr">
        <div class="rsp-info-card"><strong style="color:#16a34a"><%= p.comprobacion.ok %></strong><p>🟢 Conciliados</p></div>
        <div class="rsp-info-card"><strong style="color:#b45309"><%= p.comprobacion.diferencia %></strong><p>🟡 Diferencias</p></div>
        <div class="rsp-info-card"><strong style="color:#dc2626"><%= p.comprobacion.inconsistencia %></strong><p>🔴 Inconsistencias</p></div>
        <div class="rsp-info-card"><strong><%= p.comprobacion.total %></strong><p>Total comprobaciones</p></div>
      </div>
    </div>
  </div>
</div>

<!-- ═══ SALDO POR ENTIDAD ═══ -->
<div class="rsp-section-title" style="margin-top:24px">🏦 Saldo por entidad</div>
<div class="table-container">
  <table>
    <thead><tr><th>Entidad</th><th>Cuentas</th><th style="text-align:right">Saldo (Pz)</th><th>% del total</th></tr></thead>
    <tbody>
      <% (porEntidad.porEntidad || []).sort((a,b) => b.saldo - a.saldo).forEach(function(e) { %>
      <tr>
        <td><span style="margin-right:6px"><%= e.icono %></span><strong><%= e.nombre %></strong></td>
        <td><%= e.cuentas %></td>
        <td style="text-align:right"><strong><%= e.saldo.toLocaleString() %></strong></td>
        <td>
          <div style="display:flex;align-items:center;gap:8px">
            <div style="flex:1;height:8px;background:#f0ecff;border-radius:6px;overflow:hidden;max-width:200px">
              <div style="height:100%;width:<%= porEntidad.total > 0 ? Math.round((e.saldo / porEntidad.total) * 100) : 0 %>%;background:linear-gradient(90deg,#16a34a,#22c55e);border-radius:6px"></div>
            </div>
            <span style="font-size:11px;color:#888"><%= porEntidad.total > 0 ? Math.round((e.saldo / porEntidad.total) * 100) : 0 %>%</span>
          </div>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<!-- ═══ FILTROS / NOTA ═══ -->
<div class="rsp-alert rsp-alert-success" style="margin-top:18px">
  <span>💡 El Dashboard Económico consolida automáticamente Banco, Contabilidad, Facturas, Nóminas, Tributos, Fundación y Junior. Los filtros por Grupo/Entidad/Departamento/Proyecto se irán afinando con la clasificación de cuentas.</span>
</div>
