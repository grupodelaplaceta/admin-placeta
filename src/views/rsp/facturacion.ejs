<div class="rsp-hero" style="padding:20px 24px">
  <div class="rsp-hero-content" style="gap:14px">
    <img src="/img/rsp-logo.png" alt="RSP" class="rsp-hero-logo" style="width:52px;height:52px;padding:5px">
    <div>
      <h1 class="rsp-hero-title" style="font-size:18px">📄 Facturación RSP</h1>
      <p class="rsp-hero-sub">Facturas por uso de servicios · <strong>GDLP-AP64-583</strong></p>
    </div>
  </div>
</div>

<!-- KPIs -->
<div class="rsp-kpis">
  <div class="rsp-kpi">
    <div class="rsp-kpi-icon" style="background:rgba(55,2,179,.12)">📄</div>
    <div><div class="rsp-kpi-value"><%= total %></div><div class="rsp-kpi-label">Total</div></div>
  </div>
  <div class="rsp-kpi">
    <div class="rsp-kpi-icon" style="background:rgba(255,109,0,.12)">⏳</div>
    <div><div class="rsp-kpi-value" style="color:<%= pendientes > 0 ? '#e65100' : '#00c853' %>"><%= pendientes %></div><div class="rsp-kpi-label">Pendientes</div></div>
  </div>
  <div class="rsp-kpi">
    <div class="rsp-kpi-icon" style="background:rgba(0,200,83,.12)">✅</div>
    <div><div class="rsp-kpi-value"><%= pagadas %></div><div class="rsp-kpi-label">Pagadas</div></div>
  </div>
  <div class="rsp-kpi">
    <div class="rsp-kpi-icon" style="background:rgba(55,2,179,.12)">💰</div>
    <div><div class="rsp-kpi-value"><%= totalFacturado.toFixed(2) %></div><div class="rsp-kpi-label">Total Facturado (Pz)</div></div>
  </div>
</div>

<!-- Acciones -->
<% if (esAdmin) { %>
<div class="rsp-acciones" style="grid-template-columns:1fr">
  <button class="rsp-btn rsp-btn-primary" onclick="generarFactura()" style="justify-content:center">
    <span style="font-size:16px">📄</span> Generar Nueva Factura
  </button>
</div>
<% } %>

<!-- Filtros -->
<div class="rsp-filtros">
  <form method="GET" action="/rsp/facturacion" style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
    <select name="entidad" onchange="this.form.submit()">
      <option value="">Todas las entidades</option>
      <option value="banco" <%= filtroEntidad === 'banco' ? 'selected' : '' %>>🏦 Banco</option>
      <option value="tributos" <%= filtroEntidad === 'tributos' ? 'selected' : '' %>>📊 Tributos</option>
      <option value="junta" <%= filtroEntidad === 'junta' ? 'selected' : '' %>>⚖️ Junta</option>
      <option value="administracion" <%= filtroEntidad === 'administracion' ? 'selected' : '' %>>📋 Admin</option>
    </select>
    <select name="estado" onchange="this.form.submit()">
      <option value="">Todos</option>
      <option value="pendiente" <%= filtroEstado === 'pendiente' ? 'selected' : '' %>>⏳ Pendiente</option>
      <option value="pagada" <%= filtroEstado === 'pagada' ? 'selected' : '' %>>✅ Pagada</option>
    </select>
    <% if (filtroEntidad || filtroEstado) { %>
    <a href="/rsp/facturacion" class="rsp-link">✕ Limpiar</a>
    <% } %>
  </form>
</div>

<% if (facturas.length === 0) { %>
<div class="rsp-empty">
  <div class="rsp-empty-icon">📄</div>
  <h3>Sin facturas</h3>
  <p>Genera una nueva factura desde el botón superior.</p>
</div>
<% } else { %>
<div class="rsp-card">
  <div class="rsp-table-wrap">
  <table class="rsp-table">
    <thead>
      <tr>
        <th>Factura</th>
        <th>Entidad</th>
        <th>Periodo</th>
        <th>Uso</th>
        <th>Base</th>
        <th>IVA</th>
        <th>Total</th>
        <th>Estado</th>
        <th>Acción</th>
      </tr>
    </thead>
    <tbody>
      <% facturas.forEach(f => { %>
      <tr>
        <td style="font-family:monospace;font-size:10px;color:#888"><%= f.id %></td>
        <td><span class="rsp-badge rsp-badge-purple"><%= f.entidad %></span></td>
        <td style="font-size:10px;white-space:nowrap">
          <%= new Date(f.periodoInicio).toLocaleDateString('es-ES') %> — <%= new Date(f.periodoFin).toLocaleDateString('es-ES') %>
        </td>
        <td style="text-align:center;font-size:11px">
          <strong><%= f.detalle.conexiones %></strong>
          <span style="color:#999">(<%= f.detalle.consultas %>C + <%= f.detalle.modificaciones %>M)</span>
        </td>
        <td style="font-size:12px"><%= f.detalle.baseTotal.toFixed(2) %> Pz</td>
        <td style="font-size:12px"><%= f.detalle.iva.toFixed(2) %> Pz</td>
        <td><strong style="font-size:15px;color:#3702b3"><%= f.detalle.total.toFixed(2) %> Pz</strong></td>
        <td><span class="rsp-badge <%= f.estado === 'pagada' ? 'rsp-badge-green' : 'rsp-badge-orange' %>"><%= f.estado === 'pagada' ? '✅ Pagada' : '⏳ Pendiente' %></span></td>
        <td>
          <% if (f.estado === 'pendiente' && esAdmin) { %>
          <button class="rsp-action-btn rsp-action-pagar" onclick="pagarFactura('<%= f.id %>')">💳 Pagar</button>
          <% } else { %>
          <button class="rsp-action-btn rsp-action-ver" onclick="verFactura('<%= f.id %>')">👁️ Ver</button>
          <% } %>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<p style="font-size:12px;color:#999;margin-top:8px">
  Total: <strong><%= total %></strong> facturas ·
  Pendientes: <strong><%= pendientes %></strong> ·
  Pagadas: <strong><%= pagadas %></strong> ·
  Total facturado: <strong><%= totalFacturado.toFixed(2) %> Pz</strong>
</p>
<% } %>

<script>
// ── Generar Factura ────────────────────────────────────────────────────
function generarFactura() {
  mostrarModal('📄 Generar Factura', `
    <p style="margin-bottom:12px">Selecciona la entidad y periodo para generar la factura:</p>
    <select id="facEntidad" class="form-input" style="width:100%;margin-bottom:8px">
      <option value="banco">🏦 Banco</option>
      <option value="tributos">📊 Tributos</option>
      <option value="junta">⚖️ Junta</option>
      <option value="administracion">📋 Administración</option>
    </select>
    <div class="grid-2" style="gap:8px;margin-bottom:12px">
      <input type="date" id="facDesde" class="form-input" placeholder="Desde">
      <input type="date" id="facHasta" class="form-input" placeholder="Hasta">
    </div>
    <button class="btn-primary" onclick="crearFactura()">📄 Generar Factura</button>
  `);
}

async function crearFactura() {
  const entidad = document.getElementById('facEntidad')?.value;
  const desde = document.getElementById('facDesde')?.value;
  const hasta = document.getElementById('facHasta')?.value;
  if (!entidad) return mostrarToast('Selecciona una entidad', 'error');

  try {
    const r = await apiFetch('/rsp/api/facturas/generar', {
      method: 'POST', body: JSON.stringify({ entidad, periodoInicio: desde, periodoFin: hasta })
    });
    if (r.success) {
      mostrarToast('✅ Factura ' + r.factura.id + ' generada: ' + r.factura.detalle.total.toFixed(2) + ' Pz', 'success');
      setTimeout(() => location.reload(), 1000);
    } else {
      mostrarToast(r.error || 'Error', 'error');
    }
  } catch (e) { mostrarToast('Error de red', 'error'); }
}

// ── Pagar Factura ──────────────────────────────────────────────────────
async function pagarFactura(id) {
  if (!confirm('¿Pagar la factura ' + id + '? Se descontará de los fondos RSP.')) return;
  try {
    const r = await apiFetch('/rsp/api/facturas/' + id + '/pagar', { method: 'POST' });
    if (r.success) {
      mostrarToast('✅ Factura pagada. Nuevo saldo: ' + r.nuevoSaldo.toFixed(2) + ' Pz', 'success');
      setTimeout(() => location.reload(), 1000);
    } else {
      mostrarToast(r.error || 'Error', 'error');
    }
  } catch (e) { mostrarToast('Error de red', 'error'); }
}

// ── Ver Factura ────────────────────────────────────────────────────────
function verFactura(id) {
  const facturas = <%- JSON.stringify(facturas) %>;
  const f = facturas.find(x => x.id === id);
  if (!f) return mostrarToast('No encontrada', 'error');

  mostrarModal('📄 ' + f.id, `
    <div class="grid-2" style="gap:8px;font-size:13px">
      <p><strong>Entidad:</strong> <span class="badge badge-purple">${f.entidad}</span></p>
      <p><strong>Estado:</strong> <span class="badge ${f.estado === 'pagada' ? 'badge-success' : 'badge-warning'}">${f.estado === 'pagada' ? '✅ Pagada' : '⏳ Pendiente'}</span></p>
      <p><strong>Periodo:</strong> ${new Date(f.periodoInicio).toLocaleDateString('es-ES')} — ${new Date(f.periodoFin).toLocaleDateString('es-ES')}</p>
      <p><strong>Emitida:</strong> ${new Date(f.emitida).toLocaleString('es-ES')}</p>
    </div>
    <hr style="margin:12px 0;border:none;border-top:1px solid #f0ecf8">
    <div style="font-size:13px">
      <p><strong>Detalle:</strong></p>
      <p style="margin-left:12px">• Consultas: ${f.detalle.consultas} × ${<%= tarifas.consulta.precio %>} Pz = ${f.detalle.baseConsultas.toFixed(2)} Pz</p>
      <p style="margin-left:12px">• Modificaciones: ${f.detalle.modificaciones} × ${<%= tarifas.modificacion.precio %>} Pz = ${f.detalle.baseModificaciones.toFixed(2)} Pz</p>
      <p style="margin-left:12px">• Base total: <strong>${f.detalle.baseTotal.toFixed(2)} Pz</strong></p>
      <p style="margin-left:12px">• IVA ${<%= tarifas.iva %>}: <strong>${f.detalle.iva.toFixed(2)} Pz</strong></p>
      <p style="margin-top:8px;font-size:16px;font-weight:700;color:var(--p)">TOTAL: ${f.detalle.total.toFixed(2)} Pz</p>
    </div>
    ${f.estado === 'pagada' ? `<p style="margin-top:8px;font-size:11px;color:#888">Pagada el ${new Date(f.pagadaEn).toLocaleString('es-ES')}</p>` : ''}
  `);
}
</script>
