<% if (sinConexion) { %>
<div class="info-card mb-16" style="border-left:4px solid var(--danger,#e53935)">
  <h4>⚠️ Sin conexión con el backend del banco</h4>
  <p style="font-size:13px;color:var(--text-light)">No se pudo leer el estado del banco (API de La Placeta). Comprueba que <code>https://api.banco.laplaceta.org</code> responde.</p>
</div>
<% } %>

<!-- ── Configuración variable del banco ─────────────────────────────── -->
<div class="info-card mb-16" style="background:linear-gradient(135deg,#f3f0ff,#fbfaff);border:1px solid #ddd4f2">
  <div class="flex justify-between" style="align-items:center">
    <div>
      <h4 style="margin:0">⚙️ Configuración variable del Banco</h4>
      <p style="font-size:12px;color:var(--text-light);margin:4px 0 0">Comisiones, RBU, IVA y límites. Se guarda en la tesorería del backend del banco y la usan la app y los servicios.</p>
    </div>
    <span id="configMsg" style="font-size:13px;font-weight:600"></span>
  </div>
  <form id="configForm" class="grid grid-3 mt-16" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:12px">
    <% campos.forEach(function(c){ %>
    <label style="font-size:12px;color:var(--text-light)">
      <%= c.label %>
      <input type="<%= c.tipo %>" step="any" name="<%= c.key %>" value="<%= c.valor %>" class="form-input" style="margin-top:4px">
    </label>
    <% }); %>
    <div style="display:flex;gap:8px;align-items:flex-end">
      <button type="submit" class="btn-primary">💾 Guardar configuración</button>
    </div>
  </form>
</div>

<!-- ── Transferencias recientes y reversiones ───────────────────────── -->
<div class="info-card">
  <div class="flex justify-between" style="align-items:center">
    <h4 style="margin:0">🔄 Transferencias recientes</h4>
    <span style="font-size:12px;color:var(--text-light)">Últimas <%= filas.length %> operaciones · las reversiones se registran en auditoría</span>
  </div>
  <% if (filas.length === 0) { %>
    <p style="font-size:13px;color:var(--text-light);margin-top:12px">No hay transferencias registradas.</p>
  <% } else { %>
  <div style="overflow-x:auto;margin-top:12px">
    <table class="table" style="width:100%;border-collapse:collapse;font-size:13px">
      <thead>
        <tr style="text-align:left;color:var(--text-light);border-bottom:1px solid #e7e0f2">
          <th style="padding:8px">Fecha</th>
          <th style="padding:8px">Origen → Destino</th>
          <th style="padding:8px">Importe</th>
          <th style="padding:8px">IVA</th>
          <th style="padding:8px">Estado</th>
          <th style="padding:8px"></th>
        </tr>
      </thead>
      <tbody>
        <% filas.forEach(function(f){ %>
        <tr style="border-bottom:1px solid #f0ebf7" data-tx="<%= f.id %>">
          <td style="padding:8px;white-space:nowrap"><%= new Date(f.createdAt).toLocaleString('es-ES',{day:'2-digit',month:'2-digit',year:'2-digit',hour:'2-digit',minute:'2-digit'}) %></td>
          <td style="padding:8px">
            <div><%= f.origen %></div>
            <div style="color:var(--text-light);font-size:11px">→ <%= f.destino %></div>
          </td>
          <td style="padding:8px;font-weight:700"><%= Number(f.amountPz).toLocaleString('es-ES') %> Pz</td>
          <td style="padding:8px"><%= f.ivaPz ? Number(f.ivaPz).toLocaleString('es-ES') + ' Pz' : '—' %></td>
          <td style="padding:8px">
            <% if (f.esReversal) { %>
              <span class="badge" style="background:#e8f5e9;color:#2e7d32">REVERSIÓN</span>
            <% } else if (f.status === 'Reversed') { %>
              <span class="badge" style="background:#fdecea;color:#c62828">Revertida</span>
            <% } else { %>
              <span class="badge" style="background:#e8f5e9;color:#2e7d32">Liquidada</span>
            <% } %>
            <div style="font-size:11px;color:var(--text-light);margin-top:2px"><%= f.concepto %></div>
          </td>
          <td style="padding:8px">
            <% if (!f.esReversal && f.status !== 'Reversed') { %>
              <button class="btn-sm btn-warning" onclick="revertir('<%= f.id %>','<%= (f.concepto||'').replace(/'/g,"") %>')">↩️ Revertir</button>
            <% } %>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>

<script>
async function revertir(txId, concepto) {
  if (!confirm('¿Revertir la transferencia ' + txId + ' (' + concepto + ')?\nSe devolverá el importe al origen y se anulará el IVA si procede. Esta acción queda registrada.')) return;
  const res = await fetch('/rsp/api/banco/revertir-transferencia', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ transactionId: txId })
  });
  const data = await res.json().catch(() => ({}));
  if (res.ok && data.success) {
    alert('✅ ' + (data.message || 'Transferencia revertida'));
    location.reload();
  } else {
    alert('❌ ' + (data.error || 'No se pudo revertir'));
  }
}

document.getElementById('configForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const msg = document.getElementById('configMsg');
  const form = e.target;
  const payload = {};
  form.querySelectorAll('input').forEach(i => { payload[i.name] = i.value; });
  msg.textContent = 'Guardando…';
  msg.style.color = '#6c5878';
  const res = await fetch('/rsp/api/banco/config', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(payload)
  });
  const data = await res.json().catch(() => ({}));
  if (res.ok && data.success) {
    msg.textContent = '✅ Guardado';
    msg.style.color = '#2e7d32';
  } else {
    msg.textContent = '❌ ' + (data.error || 'Error');
    msg.style.color = '#c62828';
  }
  setTimeout(() => { msg.textContent = ''; }, 4000);
});
</script>
