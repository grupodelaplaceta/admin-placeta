<!-- ═══ FUNDACIÓN ═══ -->
<div class="rsp-hero" style="background:linear-gradient(135deg,#7a1fa2 0%,#ab47bc 100%)">
  <div class="rsp-hero-content">
    <div style="width:80px;height:80px;border-radius:16px;background:rgba(255,255,255,.13);display:flex;align-items:center;justify-content:center;font-size:38px">🏛️</div>
    <div>
      <h1 class="rsp-hero-title">Fundación Banco de La Placeta</h1>
      <p class="rsp-hero-sub">Programas · Ayudas · Becas · RBU · Campañas de desvío de fondos</p>
      <div class="rsp-hero-stats">
        <span>Solicitudes: <strong><%= estado.solicitudes %></strong></span>
        <span>Concedidas: <strong><%= estado.concedidas %></strong></span>
        <span>Pagadas: <strong><%= estado.pagadas %></strong></span>
        <span>Concedido: <strong><%= estado.totalConcedido.toLocaleString() %> Pz</strong></span>
        <span>Campañas activas: <strong><%= estado.campanasActivas %></strong></span>
      </div>
    </div>
  </div>
</div>

<div style="display:flex;gap:8px;margin:14px 0;flex-wrap:wrap">
  <a href="#solicitudes" class="btn btn-sm btn-secondary">📨 Solicitudes</a>
  <a href="#programas" class="btn btn-sm btn-secondary">📦 Programas</a>
  <a href="#campanas" class="btn btn-sm btn-secondary">📢 Campañas</a>
  <% if (esAdmin) { %>
  <button class="btn btn-primary" style="margin-left:auto" onclick="abrirModalSol()">➕ Nueva solicitud</button>
  <% } %>
</div>

<!-- SOLICITUDES -->
<h2 id="solicitudes" class="rsp-section-title">📨 Solicitudes de ayuda / beca / RBU</h2>
<div class="table-container">
  <table>
    <thead><tr><th>Solicitud</th><th>Solicitante</th><th>Programa</th><th>Solicitado</th><th>Concedido</th><th>RBU</th><th>Estado</th><th></th></tr></thead>
    <tbody>
      <% if (!solicitudes || solicitudes.length === 0) { %>
      <tr><td colspan="8" style="text-align:center;color:#999;padding:24px">No hay solicitudes.</td></tr>
      <% } %>
      <% (solicitudes||[]).forEach(function(s) { %>
      <tr onclick="window.location='/rsp/fundacion/solicitud/<%= s.id %>'" style="cursor:pointer">
        <td style="font-size:11px"><strong><%= s.id %></strong></td>
        <td><%= s.solicitante_nombre || s.solicitante_dip %></td>
        <td><%= s.programa_id || '—' %></td>
        <td><%= (s.importe_solicitado||0).toLocaleString() %></td>
        <td><strong><%= (s.importe_concedido||0).toLocaleString() %></strong></td>
        <td><%= s.rbu ? '🧒' : '' %></td>
        <td><span class="badge <%= s.estado==='concedida'?'badge-success':(s.estado==='pagada'?'badge-success':(s.estado==='denegada'?'badge-danger':'badge-warning')) %>"><%= s.estado %></span></td>
        <td><a href="/rsp/fundacion/solicitud/<%= s.id %>" class="btn btn-sm btn-secondary">Ver</a></td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<!-- PROGRAMAS -->
<h2 id="programas" class="rsp-section-title" style="margin-top:24px">📦 Programas</h2>
<div class="rsp-kpis">
  <% (programas||[]).forEach(function(p) { %>
  <div class="rsp-kpi">
    <div class="rsp-kpi-icon" style="background:rgba(171,71,188,.12)">📦</div>
    <div>
      <div class="rsp-kpi-value" style="font-size:16px"><%= p.nombre %></div>
      <div class="rsp-kpi-label"><%= p.tipo %> · <%= p.presupuesto.toLocaleString() %> Pz · <%= p.estado %></div>
    </div>
  </div>
  <% }); %>
  <% if (!programas || programas.length === 0) { %><div style="color:#999;font-size:13px">Sin programas.</div><% } %>
</div>

<!-- CAMPAÑAS -->
<h2 id="campanas" class="rsp-section-title" style="margin-top:24px">📢 Campañas de desvío de fondos</h2>
<div class="table-container">
  <table>
    <thead><tr><th>Campaña</th><th>Nombre</th><th>Inicio</th><th>Fin</th><th>Estado</th><th>Ingresos</th><th>Desviado</th><th>IVA</th><th></th></tr></thead>
    <tbody>
      <% if (!campanas || campanas.length === 0) { %>
      <tr><td colspan="9" style="text-align:center;color:#999;padding:24px">No hay campañas.</td></tr>
      <% } %>
      <% (campanas||[]).forEach(function(c) { %>
      <tr>
        <td style="font-size:11px"><strong><%= c.id %></strong></td>
        <td><%= c.nombre %></td>
        <td style="font-size:11px"><%= c.fecha_inicio ? c.fecha_inicio.slice(0,10) : '—' %></td>
        <td style="font-size:11px"><%= c.fecha_fin ? c.fecha_fin.slice(0,10) : '—' %></td>
        <td><span class="badge <%= c.estado==='activa'?'badge-success':(c.estado==='cerrada'?'badge-outline':'badge-warning') %>"><%= c.estado %></span></td>
        <td><%= (c.ingresos_elegibles||[]).length %></td>
        <td><strong><%= (c.total_desviado||0).toLocaleString() %> Pz</strong></td>
        <td><%= c.iva_responsabilidad %></td>
        <td>
          <% if (esAdmin && c.estado === 'activa') { %>
          <button class="btn btn-sm btn-secondary" onclick="registrarIngreso('<%= c.id %>')">＋ ingreso</button>
          <% } %>
          <% if (esAdmin) { %>
          <button class="btn btn-sm btn-ghost" onclick="cambiarCampana('<%= c.id %>', '<%= c.estado %>')">↔️</button>
          <% } %>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<!-- MODAL SOLICITUD -->
<div id="modalSol" style="display:none;position:fixed;inset:0;background:rgba(10,5,30,.55);z-index:200;align-items:center;justify-content:center">
  <div style="background:#fff;border-radius:16px;max-width:560px;width:92%;max-height:90vh;overflow:auto;padding:24px">
    <h3 style="margin:0 0 16px">➕ Nueva solicitud</h3>
    <div style="display:grid;gap:12px">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
        <div><label class="form-label">Solicitante (DIP) *</label><input id="sol_dip" class="form-input" placeholder="23749931M"></div>
        <div><label class="form-label">Nombre</label><input id="sol_nombre" class="form-input"></div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
        <div><label class="form-label">Programa</label>
          <select id="sol_programa" class="form-input"><option value="">— Sin programa —</option><% (programas||[]).forEach(function(p){ %><option value="<%= p.id %>"><%= p.nombre %></option><% }); %></select>
        </div>
        <div><label class="form-label">Importe solicitado (Pz)</label><input id="sol_importe" type="number" class="form-input" value="0"></div>
      </div>
      <label style="display:flex;align-items:center;gap:8px;font-size:13px"><input type="checkbox" id="sol_rbu"> Es una RBU (renta básica universal)</label>
    </div>
    <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:18px">
      <button class="btn btn-secondary" onclick="document.getElementById('modalSol').style.display='none'">Cancelar</button>
      <button class="btn btn-primary" onclick="crearSol()">Crear solicitud</button>
    </div>
  </div>
</div>

<script>
function abrirModalSol(){ document.getElementById('modalSol').style.display='flex'; }
document.getElementById('modalSol').addEventListener('click', function(e){ if(e.target===this) this.style.display='none'; });
async function crearSol(){
  const payload = {
    solicitante_dip: document.getElementById('sol_dip').value.trim(),
    solicitante_nombre: document.getElementById('sol_nombre').value.trim(),
    programa_id: document.getElementById('sol_programa').value || null,
    importe_solicitado: parseFloat(document.getElementById('sol_importe').value) || 0,
    rbu: document.getElementById('sol_rbu').checked,
  };
  if(!payload.solicitante_dip){ alert('El DIP del solicitante es obligatorio'); return; }
  try {
    const r = await fetch('/rsp/fundacion/api/solicitudes', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload) });
    const j = await r.json();
    if(!j.success) throw new Error(j.error);
    window.location = '/rsp/fundacion/solicitud/' + j.solicitud.id;
  } catch(e){ alert('Error: ' + e.message); }
}
async function registrarIngreso(id){
  const concepto = prompt('Concepto del ingreso elegible:');
  if(!concepto) return;
  const importe = prompt('Importe (Pz):');
  if(!importe) return;
  const r = await fetch('/rsp/fundacion/api/campanas/' + id + '/ingreso', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ concepto, importe: parseFloat(importe) }) });
  const j = await r.json();
  if(!j.success){ alert('Error: ' + j.error); return; }
  window.location.reload();
}
async function cambiarCampana(id, actual){
  const estado = prompt('Nuevo estado (programada, activa, cerrada, cancelada):', actual);
  if(!estado) return;
  const r = await fetch('/rsp/fundacion/api/campanas/' + id + '/estado', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ estado }) });
  const j = await r.json();
  if(!j.success){ alert('Error: ' + j.error); return; }
  window.location.reload();
}
</script>
