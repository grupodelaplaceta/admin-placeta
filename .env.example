# ── RSP Web · configuración ─────────────────────────────────────────────
# Copia este archivo a .env.local y ajusta los valores.

# URL del backend RSP que expone las APIs JSON (BFF).
VITE_API_URL=http://localhost:4000

# true  → proveedor local (snapshot del banco, sin backend). Solo para dev local.
# false → (POR DEFECTO) habla con el backend real (BFF) en VITE_API_URL.
VITE_USE_MOCK=false

# Prefijo de nombre de aplicación (se usa en títulos y metadatos).
VITE_APP_NAME=RSP
