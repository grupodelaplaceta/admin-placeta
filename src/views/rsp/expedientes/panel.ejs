<!-- ═══ EXPEDIENTES ═══ -->
<div class="rsp-hero" style="background:linear-gradient(135deg,#0d3b1f 0%,#1a7a4a 100%)">
  <div class="rsp-hero-content">
    <div style="width:80px;height:80px;border-radius:16px;background:rgba(255,255,255,.13);display:flex;align-items:center;justify-content:center;font-size:38px">🗂️</div>
    <div>
      <h1 class="rsp-hero-title">Expedientes Transversales</h1>
      <p class="rsp-hero-sub">EXP-<%= new Date().getFullYear() %>-000001 · Relacionan persona, entidad, operaciones, documentos, firmas, pagos y resoluciones</p>
      <div class="rsp-hero-stats">
        <% ESTADOS_EXP.forEach(function(e) { %>
        <span><%= e %>: <strong><%= estado.porEstado[e] || 0 %></strong></span>
        <% }); %>
      </div>
    </div>
  </div>
</div>

<div style="display:flex;justify-content:space-between;align-items:center;margin:14px 0;flex-wrap:wrap;gap:10px">
  <div style="display:flex;gap:8px">
    <a href="/rsp/expedientes" class="btn btn-sm <%= !filtroEstado?'btn-primary':'btn-secondary' %>">Todos</a>
    <% ESTADOS_EXP.forEach(function(e) { %>
    <a href="/rsp/expedientes?estado=<%= e %>" class="btn btn-sm <%= filtroEstado===e?'btn-primary':'btn-secondary' %>"><%= e %></a>
    <% }); %>
  </div>
  <% if (esAdmin) { %>
  <button class="btn btn-primary" onclick="abrirModalExp()">➕ Nuevo expediente</button>
  <% } %>
</div>

<div class="table-container">
  <table>
    <thead>
      <tr><th>Expediente</th><th>Título</th><th>Tipo</th><th>Persona</th><th>Entidad</th><th>Prioridad</th><th>Estado</th><th>Relaciones</th><th></th></tr>
    </thead>
    <tbody>
      <% if (!expedientes || expedientes.length === 0) { %>
      <tr><td colspan="9" style="text-align:center;color:#999;padding:28px">No hay expedientes.</td></tr>
      <% } %>
      <% (expedientes||[]).forEach(function(e) { %>
      <tr onclick="window.location='/rsp/expedientes/<%= e.id %>'" style="cursor:pointer">
        <td><strong><%= e.id %></strong></td>
        <td><%= e.titulo %></td>
        <td><span class="badge badge-purple"><%= e.tipo %></span></td>
        <td><%= e.persona_dip || '—' %></td>
        <td><%= e.entidad_eip || '—' %></td>
        <td><span class="badge <%= e.prioridad==='critica'?'badge-danger':(e.prioridad==='alta'?'badge-warning':'badge-info') %>"><%= e.prioridad %></span></td>
        <td><span class="badge <%= e.estado==='abierto'?'badge-warning':(e.estado==='cerrado'||e.estado==='archivado'?'badge-outline':'badge-success') %>"><%= e.estado %></span></td>
        <td><%= (e.relacion_ids||[]).length %></td>
        <td><a href="/rsp/expedientes/<%= e.id %>" class="btn btn-sm btn-secondary">Ver</a></td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<div id="modalExp" style="display:none;position:fixed;inset:0;background:rgba(10,5,30,.55);z-index:200;align-items:center;justify-content:center">
  <div style="background:#fff;border-radius:16px;max-width:560px;width:92%;max-height:90vh;overflow:auto;padding:24px">
    <h3 style="margin:0 0 16px">➕ Nuevo expediente</h3>
    <div style="display:grid;gap:12px">
      <div><label class="form-label">Título *</label><input id="exp_titulo" class="form-input" placeholder="Título del expediente"></div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
        <div><label class="form-label">Tipo</label>
          <select id="exp_tipo" class="form-input"><option value="general">General</option><option value="subvencion">Subvención</option><option value="ayuda">Ayuda</option><option value="sancion">Sanción</option><option value="reclamacion">Reclamación</option><option value="contrato">Contrato</option><option value="otro">Otro</option></select>
        </div>
        <div><label class="form-label">Prioridad</label>
          <select id="exp_prioridad" class="form-input"><option value="normal">Normal</option><option value="baja">Baja</option><option value="alta">Alta</option><option value="critica">Crítica</option></select>
        </div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
        <div><label class="form-label">Persona (DIP)</label><input id="exp_dip" class="form-input" placeholder="23749931M"></div>
        <div><label class="form-label">Entidad (EIP)</label><input id="exp_eip" class="form-input" placeholder="EIP-XJETNL"></div>
      </div>
      <div><label class="form-label">Estado</label>
        <select id="exp_estado" class="form-input"><option value="abierto">Abierto</option><option value="en_tramite">En trámite</option><option value="resuelto">Resuelto</option><option value="cerrado">Cerrado</option></select>
      </div>
    </div>
    <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:18px">
      <button class="btn btn-secondary" onclick="document.getElementById('modalExp').style.display='none'">Cancelar</button>
      <button class="btn btn-primary" onclick="crearExp()">Crear</button>
    </div>
  </div>
</div>

<script>
function abrirModalExp(){ document.getElementById('modalExp').style.display='flex'; }
document.getElementById('modalExp').addEventListener('click', function(e){ if(e.target===this) this.style.display='none'; });
async function crearExp(){
  const payload = {
    titulo: document.getElementById('exp_titulo').value.trim(),
    tipo: document.getElementById('exp_tipo').value,
    prioridad: document.getElementById('exp_prioridad').value,
    persona_dip: document.getElementById('exp_dip').value.trim() || null,
    entidad_eip: document.getElementById('exp_eip').value.trim() || null,
    estado: document.getElementById('exp_estado').value,
  };
  if(!payload.titulo){ alert('El título es obligatorio'); return; }
  try {
    const r = await fetch('/rsp/expedientes/api/expedientes', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload) });
    const j = await r.json();
    if(!j.success) throw new Error(j.error);
    window.location = '/rsp/expedientes/' + j.expediente.id;
  } catch(e){ alert('Error: ' + e.message); }
}
</script>
