# ── RSP Web · configuración ─────────────────────────────────────────────
# Copia este archivo a .env.local y ajusta los valores.

# URL del backend RSP que expone las APIs JSON (admin-placeta).
VITE_API_URL=http://localhost:3002

# true  → usa datos de demostración locales (sin backend). Ideal para desarrollo.
# false → habla con el backend real en VITE_API_URL.
VITE_USE_MOCK=true

# Prefijo de nombre de aplicación (se usa en títulos y metadatos).
VITE_APP_NAME=RSP
