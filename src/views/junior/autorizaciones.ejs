<div class="junior-section">
  <div style="background:linear-gradient(135deg,#880e4f,#e91e63);color:#fff;border-radius:16px;padding:24px 28px;margin-bottom:16px">
    <div style="display:flex;align-items:center;gap:16px;flex-wrap:wrap">
      <div style="width:64px;height:64px;background:rgba(255,255,255,.15);border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:32px">📝</div>
      <div>
        <h4 style="font-size:20px;font-weight:700">Autorizaciones</h4>
        <p style="font-size:13px;opacity:.7"><%= autorizaciones.length %> documento<%= autorizaciones.length !== 1 ? 's' : '' %> pendiente<%= autorizaciones.length !== 1 ? 's' : '' %></p>
      </div>
    </div>
  </div>

  <% if (autorizaciones.length === 0) { %>
  <div class="info-card mb-16" style="text-align:center;padding:40px">
    <div style="font-size:48px;margin-bottom:12px">✅</div>
    <h3 style="font-size:16px;margin-bottom:8px;color:#333">Sin autorizaciones pendientes</h3>
    <p style="font-size:13px;color:#888;margin-bottom:16px">No hay documentos de autorización pendientes de firmar.</p>
    <a href="/junior" class="btn btn-primary">📊 Volver al Dashboard</a>
  </div>
  <% } else { %>
  <div style="display:grid;gap:12px">
    <% autorizaciones.forEach(a => { %>
    <div class="entidad-card" style="border-left:4px solid <%= a.estado === 'Oficial' ? '#22a06b' : '#e91e63' %>">
      <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap">
        <div style="width:44px;height:44px;background:#fce4ec;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:20px">📄</div>
        <div style="flex:1;min-width:160px">
          <h4 style="font-size:14px;margin:0"><%= a.titulo || 'Documento' %></h4>
          <p style="font-size:11px;color:#888;margin:2px 0 0">
            Tipo: <%= a.tipo || '—' %> · 
            Creado: <%= a.createdAt ? new Date(a.createdAt).toLocaleDateString('es-ES') : '—' %>
          </p>
        </div>
        <span class="badge <%= a.estado === 'Oficial' ? 'badge-success' : 'badge-warning' %>"><%= a.estado || 'Pendiente' %></span>
      </div>
    </div>
    <% }); %>
  </div>
  <% } %>
</div>
