<%- include('../parciales/hero', {
  icono: '🏦',
  titulo: 'Banco de La Placeta',
  subtitulo: 'Gestión bancaria, cuentas, operaciones y cumplimiento normativo',
  stats: [
    { label: 'Cuentas', value: totalCuentas },
    { label: 'Activas', value: cuentasActivas },
    { label: 'Masa monetaria', value: saldoTotal.toLocaleString() + ' Pz' }
  ],
  grad: 'linear-gradient(135deg,#1f005f 0%,#3702b3 55%,#6a2be0 100%)'
}) %>

<%- include('../parciales/kpis', { kpis: [
  { icono: '📋', valor: totalCuentas, label: 'Total cuentas', color: 'rgba(124,58,237,.12)' },
  { icono: '✅', valor: cuentasActivas, label: 'Activas', color: 'rgba(34,197,94,.12)' },
  { icono: '💰', valor: saldoTotal.toLocaleString() + ' Pz', label: 'Masa monetaria', color: 'rgba(249,115,22,.12)' },
  { icono: '👥', valor: typeof totalUsuarios !== 'undefined' ? totalUsuarios : '—', label: 'Usuarios', color: 'rgba(59,130,246,.12)' },
  { icono: '🔄', valor: typeof totalTransacciones !== 'undefined' ? totalTransacciones : '—', label: 'Operaciones', color: 'rgba(6,182,212,.12)' },
  { icono: '💳', valor: typeof totalTarjetas !== 'undefined' ? totalTarjetas : '—', label: 'Tarjetas', color: 'rgba(234,179,8,.12)' }
] }) %>

<div class="flex-between mb-16">
  <div class="rsp-section-title" style="margin-bottom:0">🕘 Últimas cuentas</div>
  <a href="/banco/cuentas" class="btn-link">Ver todas →</a>
</div>

<div class="table-container">
  <table>
    <thead><tr><th>ID</th><th>Nombre</th><th>Tipo</th><th>IBAN</th><th>Saldo</th><th>Estado</th></tr></thead>
    <tbody>
      <% (cuentas || []).slice(0, 10).forEach(c => { %>
      <tr onclick="window.location='/banco/cuentas/<%= c.id %>'" style="cursor:pointer">
        <td class="text-mono"><%= c.id %></td>
        <td><strong><%= c.displayName || '—' %></strong></td>
        <td><span class="badge badge-purple"><%= c.type || '—' %></span></td>
        <td class="text-mono"><%= c.iban || '—' %></td>
        <td><strong><%= (c.balancePz || 0).toLocaleString() %></strong> Pz</td>
        <td><span class="badge <%= c.closedAt ? 'badge-danger' : 'badge-success' %>"><%= c.closedAt ? 'Cerrada' : 'Activa' %></span></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<div class="rsp-acciones mt-16" style="grid-template-columns:repeat(auto-fit,minmax(180px,1fr))">
  <a href="/banco/cuentas/nueva/gestor" class="rsp-btn rsp-btn-primary"><span class="rsp-btn-icon">➕</span><span class="rsp-btn-text">Nueva Cuenta</span></a>
  <a href="/banco/operaciones" class="rsp-btn rsp-btn-secondary"><span class="rsp-btn-icon">🔄</span><span class="rsp-btn-text">Operaciones</span></a>
  <a href="/banco/control-cumplimiento" class="rsp-btn rsp-btn-secondary"><span class="rsp-btn-icon">🛡️</span><span class="rsp-btn-text">Cumplimiento</span></a>
  <a href="/banco/tarjetas" class="rsp-btn rsp-btn-secondary"><span class="rsp-btn-icon">💳</span><span class="rsp-btn-text">Tarjetas</span></a>
  <a href="/banco/nominas" class="rsp-btn rsp-btn-secondary"><span class="rsp-btn-icon">📄</span><span class="rsp-btn-text">Nóminas</span></a>
</div>

