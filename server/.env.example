# ── rsp-web-api (BFF) · configuración ──────────────────────────────────
# Copia este archivo a server/.env y ajusta los valores.
# En Vercel, define estas mismas variables como Environment Variables del
# proyecto. NO subas .env al repositorio (es público).

# Core
PORT=4000
NODE_ENV=production
SESSION_SECRET=cambiar
JWT_SECRET=cambiar

# Autenticación del panel: usuarios con acceso (JSON).
# Cada entrada: dip, password, nombre y roles.
#   ADMIN_USERS=[{"dip":"23749931M","password":"una-clave-fuerte","nombre":"Mikel Alegre Marcos","roles":["superadmin","rsp_admin"]}]
# El presidente (23749931M) es administrador cuando está definido en esta
# configuración; en producción no existe ninguna contraseña por defecto.
ADMIN_USERS=

# Clave del presidente (23749931M), obligatoria si no se usa ADMIN_USERS.
ADMIN_PASSWORD=

# DIPs administradores que pueden entrar por SSO (PlacetaID), separados por comas.
#   ADMIN_DIPS=23749931M,72583347U
ADMIN_DIPS=

# Secreto para verificar la firma del token de PlacetaID (HS256). Si se deja
# vacío, el token solo se decodifica (igual que admin-placeta). Recomendado.
PLACETAID_JWT_SECRET=

# Boletín Oficial / RSP (transparencia, CNIC, tarifas)
BOP_URL=https://bop.laplaceta.org

# Banco de La Placeta / CRM
BANCO_API_URL=https://api.banco.laplaceta.org
CRM_BASE_URL=https://rsp.laplaceta.org
CRM_READ_KEY=
APP_BASE_URL=http://localhost:4000

# PlacetaID (SSO)
PLACETAID_API_URL=https://id.laplaceta.org/api
PLACETAID_AUTH_URL=https://id.laplaceta.org
# Client id de RSP registrado como solicitante en PlacetaID (obligatorio para el SSO).
# Se crea con: POST /api/admin/solicitantes (X-API-Key de administración de PlacetaID)
#   { nombre:'RSP Web', plataforma:'web', urlOrigen:'https://rsp.laplaceta.org/login/callback', redirectUris:[...] }
PLACETAID_CLIENT_ID=
PLACETAID_CLIENT_SECRET=
# Clave de administración de PlacetaID (X-API-Key) para enviar documentos de
# firma a la app móvil. Distinta del client_id del SSO.
PLACETAID_ADMIN_KEY=

# Supabase (REST, service role) — persistencia del panel
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Acceso directo a Postgres (migraciones con scripts)
# Opción A: connection string completa (Pooler session)
#   Dashboard → Project Settings → Database → Connection string
SUPABASE_DB_CONNECTION=
# Opción B: solo la contraseña de la BD
SUPABASE_DB_PASSWORD=

# Documentos / normativa
DOCS_API_KEYS=
ADMIN_MASTER_KEY=

# Email (notificaciones)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=notificaciones@laplaceta.org
 # Clave compartida con GDLP Web para la recepción de trámites públicos.
GDLP_RSP_API_KEY=cambia-esta-clave-en-produccion

# Orígenes web autorizados para peticiones con cookie.
CORS_ORIGINS=https://rsp.laplaceta.org,https://junior.laplaceta.org
