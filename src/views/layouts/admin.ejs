<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo || 'Admin Placeta' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="icon" href="https://i.postimg.cc/RZYKzdmX/Diseno-sin-titulo-76.png" type="image/png">
</head>
<body class="<%= workspaceActivo ? 'workspace-active' : '' %>">
  <% if (usuario) { %>
  <!-- ═══ SIDEBAR ═══ -->
  <aside class="sidebar" id="sidebar"
    <% if (workspaceActivo) { %>
    data-workspace="<%= workspaceActivo.id %>"
    style="--ws-color: <%= workspaceActivo.color %>; --ws-dark: <%= workspaceActivo.colorDark %>"
    <% } %>
  >
    <!-- Workspace Switcher -->
    <div class="sidebar-switcher">
      <button class="ws-switcher-btn" onclick="toggleWorkspaceSwitcher()" title="Cambiar de workspace">
        <% if (workspaceActivo) { %>
        <% if (workspaceActivo.logo) { %>
        <img src="<%= workspaceActivo.logo %>" alt="" class="ws-switcher-logo" onerror="this.style.display='none';this.nextElementSibling.style.display=''">
        <span class="ws-switcher-icon" style="display:none"><%= workspaceActivo.icono %></span>
        <% } else { %>
        <span class="ws-switcher-icon"><%= workspaceActivo.icono %></span>
        <% } %>
        <span class="ws-switcher-info">
          <span class="ws-switcher-name"><%= workspaceActivo.nombre %></span>
          <span class="ws-switcher-hint">Cambiar workspace ▾</span>
        </span>
        <% } else { %>
        <span class="ws-switcher-icon">🏛️</span>
        <span class="ws-switcher-info">
          <span class="ws-switcher-name">Admin Placeta</span>
          <span class="ws-switcher-hint">Panel Principal</span>
        </span>
        <% } %>
      </button>
      <!-- Dropdown workspaces -->
      <div class="ws-dropdown" id="wsDropdown">
        <div class="ws-dropdown-header">Tus Workspaces</div>
        <a href="/dashboard" class="ws-option <%= !workspaceActivo ? 'active' : '' %>" data-ws="inicio">
          <span class="ws-option-icon">🏛️</span>
          <span class="ws-option-info">
            <span class="ws-option-name">Panel Principal</span>
            <span class="ws-option-desc">Inicio y resumen general</span>
          </span>
        </a>
        <% workspacesDisponibles && workspacesDisponibles.forEach(function(ws) { %>
        <a href="/<%= ws.id %>" class="ws-option <%= workspaceActivo && workspaceActivo.id === ws.id ? 'active' : '' %>"
           data-ws="<%= ws.id %>"
           style="--ws-opt-color: <%= ws.color %>">
          <% if (ws.logo) { %>
          <img src="<%= ws.logo %>" alt="" class="ws-option-img" onerror="this.style.display='none';this.nextElementSibling.style.display=''">
          <span class="ws-option-icon" style="display:none"><%= ws.icono %></span>
          <% } else { %>
          <span class="ws-option-icon"><%= ws.icono %></span>
          <% } %>
          <span class="ws-option-info">
            <span class="ws-option-name"><%= ws.nombre %></span>
            <span class="ws-option-desc"><%= ws.descripcion %></span>
          </span>
        </a>
        <% }); %>
      </div>
    </div>

    <!-- Navegación del Workspace -->
    <nav class="sidebar-nav">
      <% if (workspaceActivo) { %>
        <% workspaceActivo.secciones && workspaceActivo.secciones.forEach(function(seccion) { %>
        <div class="nav-section">
          <span class="nav-section-title"><%= seccion.titulo %></span>
          <% seccion.enlaces && seccion.enlaces.forEach(function(enlace) { %>
          <a href="<%= enlace.url %>"
             class="nav-item <%= pathActual === enlace.url || (enlace.url !== '/' + workspaceActivo.id && pathActual.startsWith(enlace.url + '/')) ? 'active' : '' %>">
            <span class="nav-icon"><%= enlace.icono %></span>
            <span class="nav-label"><%= enlace.texto %></span>
          </a>
          <% }); %>
        </div>
        <% }); %>
      <% } else { %>
        <!-- Vista global: mostrar acceso rápido a todos los workspaces -->
        <div class="nav-section">
          <span class="nav-section-title">🏛️ INICIO</span>
          <a href="/dashboard" class="nav-item <%= pathActual === '/dashboard' ? 'active' : '' %>">
            <span class="nav-icon">📊</span>
            <span class="nav-label">Panel Principal</span>
          </a>
        </div>
        <% workspacesDisponibles && workspacesDisponibles.forEach(function(ws) { %>
        <div class="nav-section">
          <span class="nav-section-title"><%= ws.icono %> <%= ws.nombre %></span>
          <% if (ws.secciones && ws.secciones[0]) { %>
            <% ws.secciones[0].enlaces && ws.secciones[0].enlaces.slice(0, 4).forEach(function(enlace) { %>
            <a href="<%= enlace.url %>" class="nav-item">
              <span class="nav-icon"><%= enlace.icono %></span>
              <span class="nav-label"><%= enlace.texto %></span>
            </a>
            <% }); %>
          <% } %>
          <a href="/<%= ws.id %>" class="nav-item nav-item-more">
            <span class="nav-icon">→</span>
            <span class="nav-label">Ver todo</span>
          </a>
        </div>
        <% }); %>
      <% } %>
    </nav>

    <!-- Footer -->
    <div class="sidebar-footer">
      <div class="user-info">
        <div class="user-avatar"><%= (usuario.nombre || 'U').charAt(0).toUpperCase() %></div>
        <div class="user-data">
          <div class="user-name"><%= usuario.nombre %></div>
          <div class="user-roles"><%= (roles || []).slice(0, 2).join(', ') %></div>
        </div>
      </div>
      <div class="sidebar-footer-actions">
        <a href="/dashboard" class="footer-btn" title="Panel Principal">🏛️</a>
        <a href="/logout" class="logout-btn" title="Cerrar sesión">🚪</a>
      </div>
    </div>
  </aside>

  <!-- ═══ MAIN CONTENT ═══ -->
  <main class="main-content" id="mainContent">
    <div class="content-header">
      <button class="hamburger" onclick="toggleSidebar()">☰</button>
      <div class="content-breadcrumb">
        <% if (workspaceActivo) { %>
        <a href="/dashboard" class="breadcrumb-link">Inicio</a>
        <span class="breadcrumb-sep">›</span>
        <a href="/<%= workspaceActivo.id %>" class="breadcrumb-link active">
          <% if (workspaceActivo.logo) { %>
          <img src="<%= workspaceActivo.logo %>" alt="" class="breadcrumb-logo" onerror="this.style.display='none';this.nextElementSibling.style.display=''">
          <span style="display:none"><%= workspaceActivo.icono %></span>
          <% } else { %>
          <span><%= workspaceActivo.icono %></span>
          <% } %>
          <%= workspaceActivo.nombre %>
        </a>
        <% if (typeof seccionActual !== 'undefined' && seccionActual) { %>
        <span class="breadcrumb-sep">›</span>
        <span class="breadcrumb-current"><%= seccionActual %></span>
        <% } %>
        <% } else { %>
        <span class="breadcrumb-current">🏛️ Panel Principal</span>
        <% } %>
      </div>
      <div class="header-actions">
        <% if (workspaceActivo) { %>
        <span class="badge-entidad" style="background: <%= workspaceActivo.color %>15; color: <%= workspaceActivo.color %>">
          <%= workspaceActivo.icono %> <%= workspaceActivo.nombre %>
        </span>
        <% } else { %>
        <span class="badge-entidad">🏛️ Admin Placeta</span>
        <% } %>
      </div>
    </div>
    <div class="content-body">
      <%- body %>
    </div>
  </main>

  <script src="/js/admin.js"></script>
  <% } else { %>
  <%- body %>
  <% } %>
</body>
</html>
