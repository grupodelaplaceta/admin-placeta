<!-- ═══ NÓMINAS ═══ -->
<div class="rsp-hero" style="background:linear-gradient(135deg,#1c005f 0%,#3702b3 100%)">
  <div class="rsp-hero-content">
    <div style="width:80px;height:80px;border-radius:16px;background:rgba(255,255,255,.13);display:flex;align-items:center;justify-content:center;font-size:38px">📄</div>
    <div>
      <h1 class="rsp-hero-title">Sistema de Nóminas</h1>
      <p class="rsp-hero-sub">Nómina → Cálculo → Retenciones → Documento → Orden bancaria → Banco → Fiscalidad → Declaración</p>
      <div class="rsp-hero-stats">
        <span>Total: <strong><%= estado.total %></strong></span>
        <span>Pagadas: <strong><%= estado.pagadas %></strong></span>
        <span>Neto: <strong><%= estado.totalNeto.toLocaleString() %> Pz</strong></span>
        <span>Retenciones: <strong><%= estado.totalRetenciones.toLocaleString() %> Pz</strong></span>
      </div>
    </div>
  </div>
</div>

<div style="display:flex;justify-content:space-between;align-items:center;margin:14px 0;flex-wrap:wrap;gap:10px">
  <form method="get" style="display:flex;gap:8px">
    <input name="periodo" type="month" class="form-input" style="max-width:160px" value="<%= filtroPeriodo %>">
    <button class="btn btn-primary btn-sm">Filtrar</button>
  </form>
  <% if (esAdmin) { %>
  <button class="btn btn-primary" onclick="abrirModalNomina()">➕ Calcular nómina</button>
  <% } %>
</div>

<div class="table-container">
  <table>
    <thead><tr><th>Nómina</th><th>Trabajador</th><th>Entidad</th><th>Periodo</th><th>Bruto</th><th>Retenciones</th><th>Neto</th><th>Estado</th><th></th></tr></thead>
    <tbody>
      <% if (!nominas || nominas.length === 0) { %>
      <tr><td colspan="9" style="text-align:center;color:#999;padding:24px">Sin nóminas. Calcula la primera.</td></tr>
      <% } %>
      <% (nominas||[]).forEach(function(n) { %>
      <tr onclick="window.location='/rsp/nominas/<%= n.id %>'" style="cursor:pointer">
        <td style="font-size:11px"><strong><%= n.id %></strong></td>
        <td><%= n.trabajador_nombre || n.trabajador_dip %></td>
        <td><%= n.entidad_nombre || n.entidad_eip || '—' %></td>
        <td><%= n.periodo %></td>
        <td><%= (n.bruto||0).toLocaleString() %></td>
        <td style="color:#b82929"><%= (n.total_retenciones||0).toLocaleString() %></td>
        <td style="color:#1a7a4a;font-weight:700"><%= (n.neto||0).toLocaleString() %> Pz</td>
        <td><span class="badge <%= n.estado==='pagada'?'badge-success':(n.estado==='ordenada'?'badge-warning':(n.estado==='calculada'?'badge-info':'badge-outline')) %>"><%= n.estado %></span></td>
        <td><a href="/rsp/nominas/<%= n.id %>" class="btn btn-sm btn-secondary">Ver</a></td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<!-- MODAL -->
<div id="modalNomina" style="display:none;position:fixed;inset:0;background:rgba(10,5,30,.55);z-index:200;align-items:center;justify-content:center">
  <div style="background:#fff;border-radius:16px;max-width:560px;width:92%;max-height:90vh;overflow:auto;padding:24px">
    <h3 style="margin:0 0 16px">➕ Calcular nómina</h3>
    <div style="display:grid;gap:10px">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
        <div><label class="form-label">Trabajador (DIP) *</label><input id="nom_dip" class="form-input"></div>
        <div><label class="form-label">Nombre</label><input id="nom_nombre" class="form-input"></div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
        <div><label class="form-label">Entidad (EIP)</label><input id="nom_eip" class="form-input"></div>
        <div><label class="form-label">Periodo</label><input id="nom_periodo" type="month" class="form-input"></div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
        <div><label class="form-label">Salario base (Pz) *</label><input id="nom_base" type="number" class="form-input" value="150"></div>
        <div><label class="form-label">Cuenta bancaria</label><input id="nom_cuenta" class="form-input"></div>
      </div>
      <div>
        <label class="form-label">Complementos (concepto|importe, una por línea)</label>
        <textarea id="nom_complementos" class="form-input" rows="2" placeholder="Plus productividad|25"></textarea>
      </div>
      <div>
        <label class="form-label">Deducciones (concepto|importe, una por línea)</label>
        <textarea id="nom_deducciones" class="form-input" rows="2" placeholder="Anticipo|10"></textarea>
      </div>
    </div>
    <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:16px">
      <button class="btn btn-secondary" onclick="document.getElementById('modalNomina').style.display='none'">Cancelar</button>
      <button class="btn btn-primary" onclick="crearNomina()">Calcular y guardar</button>
    </div>
  </div>
</div>

<script>
function abrirModalNomina(){ document.getElementById('modalNomina').style.display='flex'; }
document.getElementById('modalNomina').addEventListener('click', function(e){ if(e.target===this) this.style.display='none'; });
function parseLineas(texto){
  return (texto||'').trim().split('\n').map(l => { const [concepto, importe] = l.split('|').map(s=>s.trim()); return concepto ? { concepto, importe: parseFloat(importe)||0 } : null; }).filter(Boolean);
}
async function crearNomina(){
  const payload = {
    trabajador_dip: $('#nom_dip').value.trim(),
    trabajador_nombre: $('#nom_nombre').value.trim(),
    entidad_eip: $('#nom_eip').value.trim() || null,
    periodo: $('#nom_periodo').value || undefined,
    salario_base: parseFloat($('#nom_base').value) || 0,
    cuenta_bancaria: $('#nom_cuenta').value.trim() || null,
    complementos: parseLineas($('#nom_complementos').value),
    deducciones: parseLineas($('#nom_deducciones').value),
  };
  if(!payload.trabajador_dip || !payload.salario_base){ alert('Trabajador y salario base son obligatorios'); return; }
  try {
    const r = await fetch('/rsp/nominas/api/nominas', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload) });
    const j = await r.json();
    if(!j.success) throw new Error(j.error);
    window.location = '/rsp/nominas/' + j.nomina.id;
  } catch(e){ alert('Error: ' + e.message); }
}
function $(id){ return document.getElementById(id); }
</script>
