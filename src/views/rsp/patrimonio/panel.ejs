<!-- ═══ PATRIMONIO (Vivid) ═══ -->
<div class="v-page">
  <div class="v-page-header">
    <div style="display:flex;align-items:center;gap:16px">
      <div style="width:52px;height:52px;border-radius:14px;background:var(--vs-bright);border:1px solid var(--vs-stroke);display:flex;align-items:center;justify-content:center;font-size:26px">💎</div>
      <div>
        <h1 class="v-title">Patrimonio y Activos</h1>
        <p class="v-sub">Titularidades · Participaciones · Activos · Patrimonio neto</p>
        <div style="display:flex;gap:8px;margin-top:8px;flex-wrap:wrap">
          <span class="v-chip v-chip--violet">👥 Titularidades: <strong><%= titularidades.length %></strong></span>
          <span class="v-chip v-chip--indigo">🏢 Participaciones: <strong><%= participaciones.length %></strong></span>
          <span class="v-chip v-chip--success">📦 Activos: <strong><%= activos.length %></strong></span>
        </div>
      </div>
    </div>
    <div class="v-page-actions">
      <% if (esAdmin) { %>
      <button class="btn-accent" onclick="calcularPatrimonioAuto()"><span class="ms" style="font-size:17px">auto_awesome</span> Registrar patrimonio automático</button>
      <button class="btn btn-secondary" onclick="abrirModalTit()"><span class="ms" style="font-size:17px">groups</span> Titularidad</button>
      <button class="btn btn-secondary" onclick="abrirModalPart()"><span class="ms" style="font-size:17px">business</span> Participación</button>
      <button class="btn btn-secondary" onclick="abrirModalAct()"><span class="ms" style="font-size:17px">inventory_2</span> Activo</button>
      <% } %>
    </div>
  </div>
  <span id="autoResult" style="font-size:12px;font-weight:700"></span>

  <!-- Patrimonio neto (por DIP) -->
  <form method="get" style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
    <input name="dip" class="form-input" style="max-width:200px" placeholder="DIP (23749931M)" value="<%= dipFiltro %>">
    <button class="btn btn-primary"><span class="ms" style="font-size:16px">calculate</span> Calcular patrimonio neto</button>
    <% if (dipFiltro) { %><a href="/rsp/patrimonio" class="btn btn-secondary">Limpiar</a><% } %>
  </form>

  <% if (patrimonio) { %>
  <div class="v-bento">
    <div class="v-stat v-col-4 v-stat--success"><div class="v-stat-head"><span class="v-stat-label">Cuentas (por %)</span><span class="v-stat-ico ms">account_balance</span></div><div class="v-stat-value"><%= patrimonio.patrimonioCuentas.toLocaleString() %></div><div class="v-stat-meta"><span class="ms" style="font-size:15px">percent</span> Titularidades</div></div>
    <div class="v-stat v-col-4 v-stat--violet"><div class="v-stat-head"><span class="v-stat-label">Participaciones</span><span class="v-stat-ico ms">business</span></div><div class="v-stat-value"><%= patrimonio.patrimonioParticipaciones.toLocaleString() %></div><div class="v-stat-meta"><span class="ms" style="font-size:15px">corporate_fare</span> Empresas EIP</div></div>
    <div class="v-stat v-col-4 v-stat--indigo"><div class="v-stat-head"><span class="v-stat-label">Activos</span><span class="v-stat-ico ms">inventory_2</span></div><div class="v-stat-value"><%= patrimonio.valorActivos.toLocaleString() %></div><div class="v-stat-meta"><span class="ms" style="font-size:15px">category</span> Valoración</div></div>
    <div class="v-stat v-col-6 v-stat--warning"><div class="v-stat-head"><span class="v-stat-label">Deudas reconocidas</span><span class="v-stat-ico ms">remove</span></div><div class="v-stat-value"><%= patrimonio.deudasReconocidas.toLocaleString() %></div><div class="v-stat-meta"><span class="ms" style="font-size:15px">trending_down</span> Pasivo</div></div>
    <div class="v-stat v-col-6 v-stat--pink"><div class="v-stat-head"><span class="v-stat-label">Patrimonio neto</span><span class="v-stat-ico ms">calculate</span></div><div class="v-stat-value"><%= patrimonio.patrimonioNeto.toLocaleString() %> <span style="font-size:15px">Pz</span></div><div class="v-stat-meta"><span class="ms" style="font-size:15px">verified</span> Neto</div></div>
  </div>
  <% if (patrimonio.cuentasTitularidadIndeterminada && patrimonio.cuentasTitularidadIndeterminada.length > 0) { %>
  <div style="background:rgba(245,158,11,.1);border:1px solid rgba(245,158,11,.35);border-radius:12px;padding:12px 16px;font-size:13px;color:#fbbf24">
    ⚠️ Cuentas compartidas con titularidad indeterminada (sin % registrado): <strong><%= patrimonio.cuentasTitularidadIndeterminada.join(', ') %></strong> — deben registrarse los % antes de liquidar impuestos.
  </div>
  <% } %>
  <% } %>

<!-- TITULARIDADES -->
<div class="v-card">
  <div class="v-card-head">
    <div>
      <div class="v-card-title">👥 Titularidades de cuentas compartidas</div>
      <div class="v-card-sub">Cuentas con % de titularidad registrado</div>
    </div>
  </div>
  <div style="overflow-x:auto">
    <table class="v-table">
      <thead><tr><th>Cuenta</th><th>Titular</th><th>%</th><th>Tipo</th><th>Fuente</th><th>Vigente</th></tr></thead>
      <tbody>
        <% if (!titularidades || titularidades.length === 0) { %>
        <tr><td colspan="6" style="text-align:center;color:var(--tq);padding:22px">Sin titularidades registradas.</td></tr>
        <% } %>
        <% (titularidades||[]).forEach(function(t) { %>
        <tr>
          <td><span class="v-entity-id"><%= t.cuenta_id %></span></td>
          <td class="v-entity-name"><%= t.titular_dip || t.titular_eip %></td>
          <td><span class="v-chip v-chip--violet"><%= t.porcentaje %>%</span></td>
          <td><span class="v-chip"><%= t.tipo %></span></td>
          <td class="v-cell-mono"><%= t.fuente %></td>
          <td><span class="v-status <%= t.vigente ? 'v-status--ok' : 'v-status--err' %>"><span class="ms" style="font-size:15px"><%= t.vigente ? 'check_circle' : 'cancel' %></span><%= t.vigente ? 'Vigente' : 'Baja' %></span></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<!-- PARTICIPACIONES -->
<div class="v-card" style="margin-top:20px">
  <div class="v-card-head">
    <div>
      <div class="v-card-title">🏢 Participaciones empresariales</div>
      <div class="v-card-sub">Cuotas en entidades con EIP y patrimonio atribuible</div>
    </div>
  </div>
  <div style="overflow-x:auto">
    <table class="v-table">
      <thead><tr><th>Titular</th><th>Entidad</th><th>%</th><th>Patrimonio entidad</th><th>Atribuible</th><th>Deudas</th><th>Vigente</th></tr></thead>
      <tbody>
        <% if (!participaciones || participaciones.length === 0) { %>
        <tr><td colspan="7" style="text-align:center;color:var(--tq);padding:22px">Sin participaciones registradas.</td></tr>
        <% } %>
        <% (participaciones||[]).forEach(function(p) { %>
        <tr>
          <td class="v-entity-name"><%= p.titular_nombre || p.titular_dip %></td>
          <td><span class="v-entity-id"><%= p.entidad_nombre || p.entidad_eip %></span></td>
          <td><span class="v-chip v-chip--indigo"><%= p.porcentaje %>%</span></td>
          <td class="v-cell-mono"><%= (p.patrimonio_neto_entidad||0).toLocaleString() %></td>
          <td class="v-cell-mono" style="color:#c4b5fd;font-weight:600"><%= (p.patrimonio_atribuible||0).toLocaleString() %> Pz</td>
          <td class="v-cell-mono"><%= (p.deudas_reconocidas||0).toLocaleString() %></td>
          <td><span class="v-status <%= p.vigente ? 'v-status--ok' : 'v-status--err' %>"><span class="ms" style="font-size:15px"><%= p.vigente ? 'check_circle' : 'cancel' %></span><%= p.vigente ? 'Vigente' : 'Baja' %></span></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<!-- ACTIVOS -->
<div class="v-card" style="margin-top:20px">
  <div class="v-card-head">
    <div>
      <div class="v-card-title">📦 Activos</div>
      <div class="v-card-sub">Bienes y cuentas valoradas en el patrimonio</div>
    </div>
  </div>
  <div style="overflow-x:auto">
    <table class="v-table">
      <thead><tr><th>Activo</th><th>Propietario</th><th>Tipo</th><th>Valor</th><th>%</th><th>Valor fiscal</th><th>Deuda asociada</th></tr></thead>
      <tbody>
        <% if (!activos || activos.length === 0) { %>
        <tr><td colspan="7" style="text-align:center;color:var(--tq);padding:22px">Sin activos registrados.</td></tr>
        <% } %>
        <% (activos||[]).forEach(function(a) { %>
        <tr>
          <td class="v-entity-name"><%= a.nombre %></td>
          <td><span class="v-entity-id"><%= a.propietario_dip || a.propietario_eip %></span></td>
          <td><span class="v-chip v-chip--success"><%= a.tipo %></span></td>
          <td class="v-cell-mono"><%= (a.valor||0).toLocaleString() %></td>
          <td><span class="v-chip"><%= a.porcentaje_titularidad %>%</span></td>
          <td class="v-cell-mono" style="color:#c4b5fd;font-weight:600"><%= (a.valor_fiscal||0).toLocaleString() %></td>
          <td class="v-cell-mono"><%= (a.deuda_asociada||0).toLocaleString() %></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<!-- MODALES -->
<div id="modalTit" style="display:none;position:fixed;inset:0;background:rgba(2,6,23,.68);z-index:200;align-items:center;justify-content:center">
  <div style="background:var(--vs-high);border:1px solid var(--vs-stroke);border-radius:16px;max-width:520px;width:92%;padding:24px;color:var(--t)">
    <h3 style="margin:0 0 16px">👥 Registrar titularidad</h3>
    <div style="display:grid;gap:10px">
      <div><label class="form-label">Cuenta *</label><input id="tit_cuenta" class="form-input" placeholder="acct-xxx o ACC-2026-..."></div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
        <div><label class="form-label">Titular DIP</label><input id="tit_dip" class="form-input" placeholder="23749931M"></div>
        <div><label class="form-label">% titularidad *</label><input id="tit_pct" type="number" class="form-input" value="50"></div>
      </div>
      <div><label class="form-label">Motivo</label><input id="tit_motivo" class="form-input"></div>
    </div>
    <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:16px">
      <button class="btn btn-secondary" onclick="document.getElementById('modalTit').style.display='none'">Cancelar</button>
      <button class="btn btn-primary" onclick="guardarTit()">Guardar</button>
    </div>
  </div>
</div>

<div id="modalPart" style="display:none;position:fixed;inset:0;background:rgba(2,6,23,.68);z-index:200;align-items:center;justify-content:center">
  <div style="background:var(--vs-high);border:1px solid var(--vs-stroke);border-radius:16px;max-width:520px;width:92%;padding:24px;color:var(--t)">
    <h3 style="margin:0 0 16px">🏢 Registrar participación</h3>
    <div style="display:grid;gap:10px">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
        <div><label class="form-label">Titular DIP *</label><input id="part_dip" class="form-input"></div>
        <div><label class="form-label">Nombre</label><input id="part_nombre" class="form-input"></div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
        <div><label class="form-label">Entidad EIP *</label><input id="part_eip" class="form-input" placeholder="EIP-XJETNL"></div>
        <div><label class="form-label">Nombre entidad</label><input id="part_nombre_eip" class="form-input"></div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
        <div><label class="form-label">% participación *</label><input id="part_pct" type="number" class="form-input" value="30"></div>
        <div><label class="form-label">Patrimonio neto entidad (Pz)</label><input id="part_pat" type="number" class="form-input" value="0"></div>
      </div>
      <div><label class="form-label">Deudas reconocidas (Pz)</label><input id="part_deudas" type="number" class="form-input" value="0"></div>
    </div>
    <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:16px">
      <button class="btn btn-secondary" onclick="document.getElementById('modalPart').style.display='none'">Cancelar</button>
      <button class="btn btn-primary" onclick="guardarPart()">Guardar</button>
    </div>
  </div>
</div>

<div id="modalAct" style="display:none;position:fixed;inset:0;background:rgba(2,6,23,.68);z-index:200;align-items:center;justify-content:center">
  <div style="background:var(--vs-high);border:1px solid var(--vs-stroke);border-radius:16px;max-width:520px;width:92%;padding:24px;color:var(--t)">
    <h3 style="margin:0 0 16px">📦 Registrar activo</h3>
    <div style="display:grid;gap:10px">
      <div><label class="form-label">Nombre *</label><input id="act_nombre" class="form-input"></div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
        <div><label class="form-label">Propietario DIP</label><input id="act_dip" class="form-input"></div>
        <div><label class="form-label">Tipo</label><select id="act_tipo" class="form-input"><option value="inmueble">Inmueble</option><option value="vehiculo">Vehículo</option><option value="cuenta">Cuenta</option><option value="participacion">Participación</option><option value="otro">Otro</option></select></div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px">
        <div><label class="form-label">Valor (Pz)</label><input id="act_valor" type="number" class="form-input" value="0"></div>
        <div><label class="form-label">% titularidad</label><input id="act_pct" type="number" class="form-input" value="100"></div>
        <div><label class="form-label">Deuda asociada</label><input id="act_deuda" type="number" class="form-input" value="0"></div>
      </div>
    </div>
    <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:16px">
      <button class="btn btn-secondary" onclick="document.getElementById('modalAct').style.display='none'">Cancelar</button>
      <button class="btn btn-primary" onclick="guardarAct()">Guardar</button>
    </div>
  </div>
</div>
</div>

<script>
function abrirModalTit(){ document.getElementById('modalTit').style.display='flex'; }
function abrirModalPart(){ document.getElementById('modalPart').style.display='flex'; }
function abrirModalAct(){ document.getElementById('modalAct').style.display='flex'; }
['modalTit','modalPart','modalAct'].forEach(id => {
  document.getElementById(id).addEventListener('click', function(e){ if(e.target===this) this.style.display='none'; });
});
async function guardarTit(){
  const payload = { cuenta_id: $('#tit_cuenta').value.trim(), titular_dip: $('#tit_dip').value.trim()||null, porcentaje: parseFloat($('#tit_pct').value), motivo: $('#tit_motivo').value };
  if(!payload.cuenta_id || !payload.titular_dip){ alert('Cuenta y titular son obligatorios'); return; }
  await post('/rsp/patrimonio/api/titularidades', payload);
}
async function guardarPart(){
  const payload = { titular_dip: $('#part_dip').value.trim(), titular_nombre: $('#part_nombre').value.trim(), entidad_eip: $('#part_eip').value.trim(), entidad_nombre: $('#part_nombre_eip').value.trim(), porcentaje: parseFloat($('#part_pct').value), patrimonio_neto_entidad: parseFloat($('#part_pat').value)||0, deudas_reconocidas: parseFloat($('#part_deudas').value)||0 };
  if(!payload.titular_dip || !payload.entidad_eip){ alert('Titular y entidad son obligatorios'); return; }
  await post('/rsp/patrimonio/api/participaciones', payload);
}
async function guardarAct(){
  const payload = { propietario_dip: $('#act_dip').value.trim()||null, nombre: $('#act_nombre').value.trim(), tipo: $('#act_tipo').value, valor: parseFloat($('#act_valor').value)||0, porcentaje_titularidad: parseFloat($('#act_pct').value)||100, deuda_asociada: parseFloat($('#act_deuda').value)||0 };
  if(!payload.nombre){ alert('El nombre es obligatorio'); return; }
  await post('/rsp/patrimonio/api/activos', payload);
}
async function post(url, payload){
  try {
    const r = await fetch(url, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload) });
    const j = await r.json();
    if(!j.success){ alert('Error: ' + j.error); return; }
    window.location.reload();
  } catch(e){ alert('Error: ' + e.message); }
}
async function calcularPatrimonioAuto(){
  const btn = event.currentTarget;
  const res = document.getElementById('autoResult');
  btn.disabled = true;
  btn.textContent = '⚙️ Calculando…';
  res.textContent = '';
  try {
    const r = await fetch('/rsp/patrimonio/api/calcular-automatico', { method:'POST', headers:{'Content-Type':'application/json'}, body: '{}' });
    const j = await r.json();
    if(!j.success){ alert('Error: ' + j.error); btn.disabled = false; btn.textContent = '⚙️ Registrar patrimonio automático'; return; }
    const rt = j.resultado;
    res.textContent = '✅ ' + rt.totalParticipaciones + ' participaciones · ' + rt.totalTitularidades + ' titularidades · ' + rt.totalActivos + ' activos' + (rt.totalErrores ? ' · ⚠️ ' + rt.totalErrores + ' errores' : '');
    res.style.color = rt.totalErrores ? '#e65100' : '#16a34a';
    setTimeout(() => window.location.reload(), 1400);
  } catch(e){ alert('Error: ' + e.message); btn.disabled = false; btn.textContent = '⚙️ Registrar patrimonio automático'; }
}
function $(id){ return document.getElementById(id); }
</script>
