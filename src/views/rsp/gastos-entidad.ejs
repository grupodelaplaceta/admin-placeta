<%# Gastos RSP de una entidad específica %>
<div class="rsp-costs-page">
  <div class="rsp-hero" style="padding:20px 24px">
    <div class="rsp-hero-content" style="gap:14px">
      <img src="/img/rsp-logo.png" alt="RSP" class="rsp-hero-logo" style="width:48px;height:48px;padding:5px">
      <div>
        <h1 class="rsp-hero-title" style="font-size:18px">💰 Gastos RSP — <%= nomEntidad %></h1>
        <p class="rsp-hero-sub">
          IBAN: <strong><%= iban %></strong> · 
          <strong><%= totalConexiones %></strong> conexiones · 
          Total: <strong><%= totalGastado.toFixed(4) %> Pz</strong>
        </p>
      </div>
    </div>
  </div>

  <div class="stats-grid mb-16">
    <div class="stat-card">
      <span class="stat-value"><%= totalConsultas %></span>
      <span class="stat-label">Consultas</span>
    </div>
    <div class="stat-card">
      <span class="stat-value"><%= totalModificaciones %></span>
      <span class="stat-label">Modificaciones</span>
    </div>
    <div class="stat-card">
      <span class="stat-value"><%= costeConsultas.toFixed(4) %></span>
      <span class="stat-label">Coste Consultas (Pz)</span>
    </div>
    <div class="stat-card">
      <span class="stat-value"><%= costeModificaciones.toFixed(3) %></span>
      <span class="stat-label">Coste Modificaciones (Pz)</span>
    </div>
  </div>

  <% if (conexiones.length === 0) { %>
  <div class="empty-state">
    <div class="empty-icon">📡</div>
    <h3>Sin conexiones</h3>
    <p>Esta entidad aún no ha realizado conexiones a través de RSP.</p>
  </div>
  <% } else { %>
  <div class="table-container">
    <table>
      <thead>
        <tr>
          <th>Conexión</th>
          <th>Tipo</th>
          <th>Endpoint</th>
          <th>Usuario</th>
          <th>Coste</th>
          <th>Fecha</th>
        </tr>
      </thead>
      <tbody>
        <% conexiones.forEach(function(c) { %>
        <tr>
          <td class="id-cell"><%= c.id %></td>
          <td>
            <span class="badge <%= c.tipo === 'consulta' ? 'badge-info' : 'badge-warning' %>">
              <%= c.tipo === 'consulta' ? '👁️ Consulta' : '✏️ Modificación' %>
            </span>
          </td>
          <td style="font-size:11px;max-width:200px;overflow:hidden;text-overflow:ellipsis">
            <code><%= c.endpoint %></code>
          </td>
          <td style="font-size:11px"><%= c.usuario || '—' %></td>
          <td><strong><%= c.total.toFixed(5) %> Pz</strong></td>
          <td style="font-size:11px;color:#888">
            <%= c.timestamp ? new Date(c.timestamp).toLocaleString('es-ES') : '—' %>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>
