<div style="margin-bottom:14px"><a href="/rsp/herencias" class="btn btn-sm btn-ghost">← Bajas / Herencias</a></div>
<div class="rsp-hero" style="background:linear-gradient(135deg,#3b0764 0%,#5b21b6 55%,#8b5cf6 100%)">
  <div class="rsp-hero-content">
    <div style="width:80px;height:80px;border-radius:20px;background:rgba(255,255,255,.14);display:flex;align-items:center;justify-content:center;font-size:38px">⚖️</div>
    <div style="flex:1">
      <div class="rsp-hero-title"><%= h.id %></div>
      <div class="rsp-hero-sub" style="font-size:17px;opacity:.95">Herencia de <strong><%= h.causante_nombre || h.causante_dip %></strong></div>
      <div class="rsp-hero-stats">
        <span>Estado: <strong><%= h.estado %></strong></span>
        <span>Bienes: <strong><%= (h.bienes||[]).length %></strong></span>
        <span>Participaciones: <strong><%= (h.participaciones||[]).length %></strong></span>
        <span>Deudas: <strong><%= (h.deudas||[]).length %></strong></span>
      </div>
    </div>
  </div>
</div>

<% if (esAdmin && h.estado !== 'cerrada') { %>
<div style="display:flex;gap:8px;margin:12px 0;flex-wrap:wrap">
  <button class="btn btn-sm btn-success" onclick="cerrar()">✅ Cerrar herencia</button>
</div>
<% } %>

<% if (h.tramite_id) { %>
<a href="/rsp/tramites/<%= h.tramite_id %>" style="display:flex;align-items:center;gap:12px;margin:14px 0;padding:14px 16px;border:1px solid rgba(139,92,246,.35);border-radius:14px;background:rgba(139,92,246,.08);text-decoration:none;color:inherit">
  <span style="font-size:24px">📜</span>
  <div style="flex:1;min-width:0">
    <div style="font-size:13px;font-weight:800">Trámite de sucesión vinculado · <span style="color:var(--p)"><%= h.tramite_id %></span></div>
    <div style="font-size:11px;color:#666;margin-top:2px">Sigue el flujo estándar: Presentación → Validación → Revisión → Subsanación → Resolución → Firma múltiple de herederos (PlacetaID Móvil) → Reparto y transmisión → Cierre</div>
  </div>
  <span class="btn btn-sm btn-primary" style="flex-shrink:0">Ver trámite →</span>
</a>
<% } %>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:14px">
  <!-- Herederos -->
  <div class="table-container">
    <div style="padding:12px 16px;font-weight:700;font-size:13px;border-bottom:1px solid var(--l)">👥 Herederos</div>
    <table>
      <thead><tr><th>Heredero</th><th>%</th><th>Situación</th><th>Sustituto</th></tr></thead>
      <tbody>
        <% (h.herederos||[]).forEach(function(x) { %>
        <tr>
          <td><%= x.nombre || x.dip %></td>
          <td><strong><%= x.porcentaje %>%</strong></td>
          <td><span class="badge <%= x.situacion==='activo'?'badge-success':(x.situacion==='baja'?'badge-warning':'badge-danger') %>"><%= x.situacion %></span></td>
          <td><%= x.sustituto || '—' %></td>
        </tr>
        <% }); %>
        <% if (!h.herederos || h.herederos.length===0) { %><tr><td colspan="4" style="text-align:center;color:#999;padding:18px">Sin herederos.</td></tr><% } %>
      </tbody>
    </table>
  </div>

  <!-- Deudas -->
  <div class="table-container">
    <div style="padding:12px 16px;font-weight:700;font-size:13px;border-bottom:1px solid var(--l)">💸 Deudas y obligaciones</div>
    <table>
      <thead><tr><th>Concepto</th><th>Importe</th><th>Estado</th></tr></thead>
      <tbody>
        <% (h.deudas||[]).forEach(function(d) { %>
        <tr><td><%= d.concepto %></td><td><%= (d.importe||0).toLocaleString() %></td><td><span class="badge <%= d.estado==='liquidada'?'badge-success':'badge-warning' %>"><%= d.estado || 'pendiente' %></span></td></tr>
        <% }); %>
        <% if (!h.deudas || h.deudas.length===0) { %><tr><td colspan="3" style="text-align:center;color:#999;padding:18px">Sin deudas.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Bienes -->
<div class="rsp-section-title" style="margin-top:22px">📦 Bienes</div>
<div class="table-container">
  <table>
    <thead><tr><th>Tipo</th><th>ID</th><th>Descripción</th><th>Valor</th><th>Transmitido a</th><th></th></tr></thead>
    <tbody>
      <% (h.bienes||[]).forEach(function(b, i) { %>
      <tr>
        <td><span class="badge badge-purple"><%= b.tipo %></span></td>
        <td class="text-mono"><%= b.id || '—' %></td>
        <td><%= b.descripcion || '' %></td>
        <td><strong><%= (b.valor||0).toLocaleString() %> Pz</strong></td>
        <td><%= b.transmitido_a ? b.transmitido_a : '<span class="badge badge-warning">pendiente</span>' %></td>
        <td><% if (esAdmin && !b.transmitido_a) { %><button class="btn btn-sm btn-success" onclick="transmitir(<%= i %>)">⬆️ Transmitir</button><% } %></td>
      </tr>
      <% }); %>
      <% if (!h.bienes || h.bienes.length===0) { %><tr><td colspan="6" style="text-align:center;color:#999;padding:18px">Sin bienes.</td></tr><% } %>
    </tbody>
  </table>
</div>

<!-- Participaciones -->
<div class="rsp-section-title" style="margin-top:22px">🏢 Participaciones empresariales</div>
<div class="table-container">
  <table>
    <thead><tr><th>Entidad</th><th>%</th><th>Valor económico</th><th>Estado</th><th>Fiscal</th><th></th></tr></thead>
    <tbody>
      <% (h.participaciones||[]).forEach(function(p, i) { %>
      <tr>
        <td><strong><%= p.entidad_nombre || p.entidad_eip %></strong></td>
        <td><%= p.porcentaje %>%</td>
        <td><%= (p.valor_economico||0).toLocaleString() %> Pz</td>
        <td><span class="badge <%= p.estado==='repartida'?'badge-success':(p.estado==='transmitida'?'badge-success':'badge-warning') %>"><%= p.estado || 'pendiente' %></span></td>
        <td><%= p.fiscal_liquidado ? '✅' : '❌' %></td>
        <td><% if (esAdmin && !['repartida','transmitida','fundacion'].includes(p.estado)) { %><button class="btn btn-sm btn-secondary" onclick="resolverPart(<%= i %>)">🔀 Resolver</button><% } %></td>
      </tr>
      <% if (p.reparto && p.reparto.length) { %>
      <tr style="background:#faf8ff"><td colspan="6" style="font-size:11px;color:#666">Reparto: <%= p.reparto.map(r => r.socio + ' ' + r.porcentaje + '% = ' + r.valor.toLocaleString() + ' Pz').join(' · ') %></td></tr>
      <% } %>
      <% }); %>
      <% if (!h.participaciones || h.participaciones.length===0) { %><tr><td colspan="6" style="text-align:center;color:#999;padding:18px">Sin participaciones.</td></tr><% } %>
    </tbody>
  </table>
</div>

<!-- Fondos sin heredero -->
<% if (h.fondos_sin_heredero && h.fondos_sin_heredero.length) { %>
<div class="rsp-section-title" style="margin-top:22px">🏛️ Fondos sin heredero → Fundación</div>
<div class="table-container">
  <table>
    <thead><tr><th>Importe</th><th>Concepto</th><th>Fecha</th><th>Destino</th></tr></thead>
    <tbody>
      <% h.fondos_sin_heredero.forEach(function(f) { %>
      <tr><td><strong><%= (f.importe||0).toLocaleString() %> Pz</strong></td><td><%= f.concepto %></td><td style="font-size:11px"><%= f.fecha.slice(0,16).replace('T',' ') %></td><td><span class="badge badge-success"><%= f.destino %></span></td></tr>
      <% }); %>
    </tbody>
  </table>
</div>
<% } %>

<!-- Historial -->
<div class="rsp-section-title" style="margin-top:22px">🕘 Historial</div>
<div class="table-container">
  <table>
    <thead><tr><th>Fecha</th><th>Acción</th><th>Motivo</th><th>Autor</th></tr></thead>
    <tbody>
      <% (h.historial||[]).slice().reverse().forEach(function(x) { %>
      <tr><td style="font-size:11px"><%= x.fecha.slice(0,16).replace('T',' ') %></td><td><span class="badge badge-purple"><%= x.estado %></span></td><td style="font-size:12px"><%= x.motivo %></td><td><%= x.autor || '—' %></td></tr>
      <% }); %>
    </tbody>
  </table>
</div>

<script>
async function transmitir(bienIndex){
  const dip = prompt('DIP del heredero (debe estar en el testamento y estar ACTIVO):');
  if(!dip) return;
  await post('/rsp/herencias/api/herencias/<%= h.id %>/transmitir', { bienIndex, herederoDip: dip });
}
async function resolverPart(i){
  const valor = prompt('Valor económico de la participación (Pz):');
  if(valor === null) return;
  const sociosTxt = prompt('Socios (dip|% separados por comas, p.ej. DIP1|50,DIP2|30):');
  const socios = (sociosTxt||'').split(',').map(s => { const [dip, pct] = s.split('|').map(x=>x.trim()); return dip ? { dip, porcentaje: parseFloat(pct)||0 } : null; }).filter(Boolean);
  await post('/rsp/herencias/api/herencias/<%= h.id %>/participacion', { participacionIndex: i, valoracion: parseFloat(valor)||0, socios });
}
async function cerrar(){
  if(!confirm('¿Cerrar la herencia? Se comprobará que no queden bienes, deudas ni participaciones pendientes.')) return;
  await post('/rsp/herencias/api/herencias/<%= h.id %>/cerrar', {});
}
async function post(url, payload){
  try {
    const r = await fetch(url, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload) });
    const j = await r.json();
    if(!j.success){ alert('Error: ' + j.error); return; }
    window.location.reload();
  } catch(e){ alert('Error: ' + e.message); }
}
</script>
