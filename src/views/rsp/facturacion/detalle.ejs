<div style="margin-bottom:14px"><a href="/rsp/facturas" class="btn btn-sm btn-ghost">← Facturas</a></div>
<div class="rsp-hero" style="background:linear-gradient(135deg,#7a4000 0%,#d97706 100%)">
  <div class="rsp-hero-content">
    <div style="width:80px;height:80px;border-radius:16px;background:rgba(255,255,255,.13);display:flex;align-items:center;justify-content:center;font-size:38px">🧾</div>
    <div style="flex:1">
      <div class="rsp-hero-title"><%= factura.id %> <span style="font-size:14px;opacity:.7"><%= factura.tipo %></span></div>
      <div class="rsp-hero-sub" style="font-size:17px;opacity:.95"><%= factura.concepto %></div>
      <div class="rsp-hero-stats">
        <span>Base: <strong><%= (factura.base_imponible||0).toLocaleString() %> Pz</strong></span>
        <span>IVA: <strong><%= (factura.total_iva||0).toLocaleString() %> Pz</strong></span>
        <span>Total: <strong><%= (factura.total_factura||0).toLocaleString() %> Pz</strong></span>
        <span>Estado: <strong><%= factura.estado %></strong></span>
      </div>
    </div>
  </div>
</div>

<div style="display:flex;gap:8px;margin:14px 0;flex-wrap:wrap">
  <% if (esAdmin && factura.tipo === 'emitida' && factura.estado === 'emitida') { %>
  <button class="btn btn-sm btn-danger" onclick="rectificar()">↩️ Rectificar</button>
  <% } %>
  <% if (esAdmin && factura.estado === 'emitida') { %>
  <button class="btn btn-sm btn-success" onclick="pagar()">💸 Registrar pago</button>
  <% } %>
  <% if (factura.operacion_id) { %>
  <a href="/rsp/operaciones" class="btn btn-sm btn-outline">🔗 Operación: <%= factura.operacion_id %></a>
  <% } %>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
  <div class="table-container">
    <div style="padding:12px 16px;font-weight:700;font-size:13px;border-bottom:1px solid #e8e4f0">📋 Datos</div>
    <table>
      <tbody>
        <tr><th style="width:180px">Emisor</th><td><%= factura.emisor_nombre || factura.emisor_eip || '—' %></td></tr>
        <tr><th>Receptor</th><td><%= factura.receptor_nombre || factura.receptor_eip || '—' %></td></tr>
        <tr><th>Fecha</th><td><%= factura.fecha %></td></tr>
        <tr><th>Vencimiento</th><td><%= factura.vencimiento || '—' %></td></tr>
        <tr><th>Rectifica a</th><td><%= factura.rectifica || '—' %></td></tr>
      </tbody>
    </table>
  </div>
  <div class="table-container">
    <div style="padding:12px 16px;font-weight:700;font-size:13px;border-bottom:1px solid #e8e4f0">💸 Pagos</div>
    <table>
      <thead><tr><th>Importe</th><th>Fecha</th><th>Concepto</th><th>Pagado por</th></tr></thead>
      <tbody>
        <% if (!factura.pagos || factura.pagos.length === 0) { %>
        <tr><td colspan="4" style="text-align:center;color:#999;padding:18px">Sin pagos.</td></tr>
        <% } %>
        <% (factura.pagos||[]).forEach(function(p) { %>
        <tr><td><strong><%= (p.importe||0).toLocaleString() %> Pz</strong></td><td style="font-size:11px"><%= p.fecha.slice(0,16).replace('T',' ') %></td><td style="font-size:12px"><%= p.concepto %></td><td><%= p.pagado_por %></td></tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<div class="table-container" style="margin-top:16px">
  <div style="padding:12px 16px;font-weight:700;font-size:13px;border-bottom:1px solid #e8e4f0">📄 Líneas</div>
  <table>
    <thead><tr><th>Descripción</th><th>Cant.</th><th>Precio</th><th>IVA %</th><th>Neto</th><th>IVA</th><th>Subtotal</th></tr></thead>
    <tbody>
      <% (factura.lineas||[]).forEach(function(l) { %>
      <tr>
        <td><%= l.descripcion %></td>
        <td><%= l.cantidad %></td>
        <td><%= (l.precioUnitario||0).toLocaleString() %></td>
        <td><%= l.ivaPorcentaje %>%</td>
        <td><%= (l.subtotalNeto||0).toLocaleString() %></td>
        <td><%= (l.subtotalIva||0).toLocaleString() %></td>
        <td><strong><%= ((l.subtotalNeto||0)+(l.subtotalIva||0)).toLocaleString() %></strong></td>
      </tr>
      <% }); %>
      <tr style="background:#faf8ff;font-weight:700">
        <td colspan="4">TOTALES</td>
        <td><%= (factura.base_imponible||0).toLocaleString() %></td>
        <td><%= (factura.total_iva||0).toLocaleString() %></td>
        <td><%= (factura.total_factura||0).toLocaleString() %> Pz</td>
      </tr>
    </tbody>
  </table>
</div>

<script>
async function pagar(){
  const importe = prompt('Importe del pago (Pz):', String(<%= factura.total_factura || 0 %>));
  if(importe === null) return;
  const r = await fetch('/rsp/facturas/api/facturas/<%= factura.id %>/pagar', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ importe: parseFloat(importe) }) });
  const j = await r.json();
  if(!j.success){ alert('Error: ' + j.error); return; }
  window.location.reload();
}
async function rectificar(){
  const motivo = prompt('Motivo de la rectificación:');
  if(!motivo) return;
  const r = await fetch('/rsp/facturas/api/facturas/<%= factura.id %>/rectificar', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ motivo }) });
  const j = await r.json();
  if(!j.success){ alert('Error: ' + j.error); return; }
  alert('✅ Factura rectificada. Nueva: ' + j.rectificativa.id);
  window.location.reload();
}
</script>
