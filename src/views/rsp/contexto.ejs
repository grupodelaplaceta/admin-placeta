<div class="v-page">
  <div class="v-page-head">
    <div>
      <h1 class="v-title">🔎 Contexto Único del ciudadano</h1>
      <p class="v-sub">Identidad + Bancario + Fiscalidad + Patrimonio + Expedientes + Notificaciones (federado vía APIs)</p>
    </div>
  </div>

  <form class="v-card v-card-body" style="display:flex;gap:10px;align-items:end" method="GET" action="/rsp/contexto/<%= dip %>">
    <label style="display:flex;flex-direction:column;font-size:12px;color:var(--tm)">DIP
      <input name="dip" class="v-search-input" style="padding:8px 10px" placeholder="Ej. 23749931M" value="<%= dip %>" required>
    </label>
    <button class="btn-accent" type="submit">Consultar</button>
  </form>

  <% if (contexto) { %>
    <div class="v-card">
      <div class="v-card-head"><div class="v-card-title">Resumen de <%= dip %></div></div>
      <div class="v-bento" style="grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:12px">
        <% var m = contexto.identidad && contexto.identidad.maestro; %>
        <div class="v-field"><span class="v-field-label">Nombre</span><span class="v-field-value"><%- (m && m.nombre) || (contexto.identidad && contexto.identidad.placetaid && contexto.identidad.placetaid.nombreCompleto) || '—' %></span></div>
        <div class="v-field"><span class="v-field-label">Nivel</span><span class="v-field-value"><%= (m && m.nivel) || '—' %></span></div>
        <div class="v-field"><span class="v-field-label">PlacetaID</span><span class="v-field-value"><%= (m && m.placetaId) || '—' %></span></div>
        <div class="v-field"><span class="v-field-label">Censo tributario</span><span class="v-field-value"><%= (m && m.tributosCensado) ? '✅ Censado' : '—' %></span></div>
        <div class="v-field"><span class="v-field-label">Saldo bancario total</span><span class="v-field-value"><%= Number(contexto.bancario.saldoTotalPz || 0).toLocaleString('es-ES') %> Pz</span></div>
        <div class="v-field"><span class="v-field-label">Patrimonio declarado</span><span class="v-field-value"><%= Number(contexto.patrimonio.totalActivos || 0).toLocaleString('es-ES') %> Pz</span></div>
      </div>
    </div>

    <div class="v-bento" style="gap:12px">
      <!-- BANCARIO -->
      <div class="v-card">
        <div class="v-card-title">🏦 Bancario (<%= contexto.bancario.cuentas.length %> cuentas)</div>
        <div style="overflow-x:auto">
          <table class="v-table">
            <thead><tr><th>Cuenta</th><th>Tipo</th><th>Saldo</th><th>Estado</th></tr></thead>
            <tbody>
              <% contexto.bancario.cuentas.forEach(function(c) { %>
                <tr><td><div class="v-entity-name"><%- c.displayName %></div><div class="v-entity-id"><%= c.iban %></div></td><td><%= c.type %></td><td><strong><%= Number(c.balancePz).toLocaleString('es-ES') %> Pz</strong></td><td><span class="v-chip v-chip--soft"><%= c.complianceStatus %></span></td></tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- FISCALIDAD -->
      <div class="v-card">
        <div class="v-card-title">🧮 Fiscalidad</div>
        <div class="v-field"><span class="v-field-label">Retribuciones</span><span class="v-field-value"><%= (contexto.fiscalidad.retribuciones || []).length %></span></div>
        <div class="v-field"><span class="v-field-label">Desgravaciones</span><span class="v-field-value"><%= (contexto.fiscalidad.desgravaciones || []).length %></span></div>
        <div class="v-field"><span class="v-field-label">Nóminas</span><span class="v-field-value"><%= (contexto.fiscalidad.nominas || []).length %></span></div>
        <div class="v-field"><span class="v-field-label">Tributos</span><span class="v-field-value"><%= contexto.fiscalidad.tributos ? (contexto.fiscalidad.tributos.tipo || 'registrado') : '—' %></span></div>
      </div>

      <!-- PATRIMONIO -->
      <div class="v-card">
        <div class="v-card-title">💎 Patrimonio</div>
        <div class="v-field"><span class="v-field-label">Activos</span><span class="v-field-value"><%= (contexto.patrimonio.activos || []).length %></span></div>
        <div class="v-field"><span class="v-field-label">Titularidades</span><span class="v-field-value"><%= (contexto.patrimonio.titularidades || []).length %></span></div>
        <div class="v-field"><span class="v-field-label">Participaciones</span><span class="v-field-value"><%= (contexto.patrimonio.participaciones || []).length %></span></div>
      </div>

      <!-- EXPEDIENTES -->
      <div class="v-card">
        <div class="v-card-title">📁 Expedientes y trámites</div>
        <div class="v-field"><span class="v-field-label">Expedientes</span><span class="v-field-value"><%= (contexto.expedientes.expedientes || []).length %></span></div>
        <div class="v-field"><span class="v-field-label">Trámites</span><span class="v-field-value"><%= (contexto.expedientes.tramites || []).length %></span></div>
        <div class="v-field"><span class="v-field-label">Incidencias</span><span class="v-field-value"><%= (contexto.expedientes.incidencias || []).length %></span></div>
        <div class="v-field"><span class="v-field-label">Notificaciones</span><span class="v-field-value"><%= (contexto.expedientes.notificaciones || []).length %></span></div>
      </div>
    </div>

    <div style="display:flex;gap:10px;flex-wrap:wrap">
      <a class="btn-accent" href="/rsp/api/auditoria/<%= dip %>" target="_blank">🛡️ Auditoría de accesos</a>
      <a class="btn-accent" href="/rsp/api/borrador-fiscal/<%= dip %>" target="_blank">🧾 Borrador fiscal</a>
    </div>
  <% } else if (dip) { %>
    <div class="v-card"><div class="v-empty">No se pudo cargar el contexto de <%= dip %>.</div></div>
  <% } %>
</div>
