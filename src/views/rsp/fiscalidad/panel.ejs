<!-- ═══ FISCALIDAD AMPLIADA ═══ -->
<div class="rsp-hero" style="background:linear-gradient(135deg,#4a044e 0%,#86198f 100%)">
  <div class="rsp-hero-content">
    <div style="width:80px;height:80px;border-radius:16px;background:rgba(255,255,255,.13);display:flex;align-items:center;justify-content:center;font-size:38px">🧾</div>
    <div>
      <h1 class="rsp-hero-title">Fiscalidad Ampliada</h1>
      <p class="rsp-hero-sub">Límite 500.000 Pz (bloqueo preventivo) · Desgravación 6% IVA · Donaciones · Retribución 250 Pz propietarios</p>
      <div class="rsp-hero-stats">
        <span>🔒 Bloqueos: <strong><%= estado.limite500k.bloqueadas %></strong></span>
        <span>💰 Retribuciones: <strong><%= estado.retribuciones.total %></strong></span>
        <span>🧾 Desgravaciones: <strong><%= estado.desgravaciones.total %></strong></span>
      </div>
    </div>
  </div>
</div>

<!-- LÍMITE 500K -->
<h2 class="rsp-section-title" style="margin-top:18px">🔒 Límite de capital 500.000 Pz — bloqueo preventivo (sin multas)</h2>
<div class="rsp-kpis">
  <div class="rsp-kpi"><div class="rsp-kpi-icon" style="background:rgba(255,80,80,.12)">🔒</div><div><div class="rsp-kpi-value"><%= estado.limite500k.bloqueadas %></div><div class="rsp-kpi-label">Bloqueadas</div></div></div>
  <div class="rsp-kpi"><div class="rsp-kpi-icon" style="background:rgba(255,214,0,.18)">📄</div><div><div class="rsp-kpi-value"><%= estado.limite500k.justificadas %></div><div class="rsp-kpi-label">Justificadas</div></div></div>
  <div class="rsp-kpi"><div class="rsp-kpi-icon" style="background:rgba(0,200,83,.12)">✅</div><div><div class="rsp-kpi-value"><%= estado.limite500k.desbloqueadas %></div><div class="rsp-kpi-label">Desbloqueadas</div></div></div>
  <div class="rsp-kpi"><div class="rsp-kpi-icon" style="background:rgba(41,121,255,.12)">↩️</div><div><div class="rsp-kpi-value"><%= estado.limite500k.regularizadas %></div><div class="rsp-kpi-label">Regularizadas</div></div></div>
</div>
<div class="table-container">
  <table>
    <thead><tr><th>Bloqueo</th><th>Cuenta</th><th>Titular</th><th>Saldo</th><th>Exceso</th><th>Límite justif.</th><th>Estado</th><th></th></tr></thead>
    <tbody>
      <% if (!bloqueos || bloqueos.length === 0) { %>
      <tr><td colspan="8" style="text-align:center;color:#999;padding:20px">Sin bloqueos. Superar 500.000 Pz genera bloqueo preventivo, no multa.</td></tr>
      <% } %>
      <% (bloqueos||[]).forEach(function(b) { %>
      <tr>
        <td style="font-size:11px"><strong><%= b.id %></strong></td>
        <td><%= b.cuenta_id %></td>
        <td><%= b.titular_dip || '—' %></td>
        <td><%= (b.saldo||0).toLocaleString() %></td>
        <td style="color:#b82929"><strong><%= (b.exceso||0).toLocaleString() %></strong></td>
        <td style="font-size:11px"><%= b.fecha_limite_justificacion ? b.fecha_limite_justificacion.slice(0,10) : '—' %></td>
        <td><span class="badge <%= b.estado==='bloqueada'?'badge-danger':(b.estado==='regularizada'?'badge-warning':(b.estado==='desbloqueada'?'badge-success':'badge-info')) %>"><%= b.estado %></span></td>
        <td>
          <% if (esAdmin && b.estado === 'bloqueada') { %>
          <button class="btn btn-sm btn-secondary" onclick="justificar('<%= b.id %>')">📄 Justificar</button>
          <button class="btn btn-sm btn-warning" onclick="regularizar('<%= b.id %>')">↩️ Regularizar</button>
          <% } %>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<!-- RETRIBUCIONES 250 -->
<h2 class="rsp-section-title" style="margin-top:24px">💰 Retribución 250 Pz — propietarios sin remuneración</h2>
<div style="display:flex;gap:8px;margin-bottom:10px;flex-wrap:wrap">
  <span style="font-size:12px;color:#666;align-self:center">Máx <strong>250 Pz/mes</strong> · 250 × % participación · Fondo de Apoyo a la Participación Económica y Social (Fundación)</span>
  <% if (esAdmin) { %>
  <button class="btn btn-sm btn-success" style="margin-left:auto" onclick="calcularAutomatico()">⚙️ Calcular automáticamente</button>
  <button class="btn btn-sm btn-primary" onclick="abrirModalRet()">➕ Registrar retribución</button>
  <% } %>
</div>

<!-- RESULTADO CÁLCULO AUTOMÁTICO -->
<div id="resAuto" style="display:none;margin:0 0 14px;border:1px solid #b7e4c7;background:#f0fbf4;border-radius:12px;padding:14px 16px"></div>
<div class="table-container">
  <table>
    <thead><tr><th>Retribución</th><th>Beneficiario</th><th>Entidad</th><th>%</th><th>Cuantía/mes</th><th>Mes</th><th>Origen</th><th>Estado</th><th></th></tr></thead>
    <tbody>
      <% if (!retribuciones || retribuciones.length === 0) { %>
      <tr><td colspan="9" style="text-align:center;color:#999;padding:20px">Sin retribuciones registradas. Usa «⚙️ Calcular automáticamente» para generarlas desde las participaciones reales.</td></tr>
      <% } %>
      <% (retribuciones||[]).forEach(function(r) { %>
      <tr>
        <td style="font-size:11px"><strong><%= r.id %></strong></td>
        <td><%= r.beneficiario_nombre || r.beneficiario_dip %></td>
        <td><%= r.entidad_nombre || r.entidad_eip %></td>
        <td><%= r.porcentaje_participacion %>%</td>
        <td style="color:#3702b3;font-weight:700"><%= (r.cuantia_mensual||0).toLocaleString() %> Pz</td>
        <td><%= r.mes %></td>
        <td><span class="badge <%= r.origen==='automatico'?'badge-info':'badge-secondary' %>"><%= r.origen==='automatico'?'⚙️ automático':'manual' %></span></td>
        <td><span class="badge <%= r.estado==='pagada'?'badge-success':(r.estado==='denegada'?'badge-danger':(r.estado==='pendiente_banco'?'badge-info':'badge-warning')) %>"><%= r.estado %></span></td>
        <td><% if (esAdmin && (r.estado === 'pendiente' || r.estado === 'pendiente_banco')) { %><button class="btn btn-sm btn-success" onclick="ordenarRet('<%= r.id %>')">💸 Ordenar pago</button><% } %></td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<!-- DESGRAVACIONES -->
<h2 class="rsp-section-title" style="margin-top:24px">🧾 Desgravaciones fiscales (6% IVA + donaciones)</h2>
<div style="display:flex;gap:8px;margin-bottom:10px;flex-wrap:wrap">
  <span style="font-size:12px;color:#666;align-self:center">6% del IVA efectivamente abonado (ej. 1.000 + 120 IVA → 7,20 Pz) · el crédito nunca produce cuota negativa</span>
  <% if (esAdmin) { %>
  <button class="btn btn-sm btn-primary" style="margin-left:auto" onclick="abrirModalDes()">🧾 Registrar desgravación</button>
  <% } %>
</div>
<div class="table-container">
  <table>
    <thead><tr><th>Desgravación</th><th>Titular</th><th>Tipo</th><th>Origen</th><th>Base</th><th>IVA pagado</th><th>%</th><th>Cuantía</th></tr></thead>
    <tbody>
      <% if (!desgravaciones || desgravaciones.length === 0) { %>
      <tr><td colspan="8" style="text-align:center;color:#999;padding:20px">Sin desgravaciones registradas. Usa «⚙️ Calcular automáticamente» para generarlas desde las operaciones reales con IVA.</td></tr>
      <% } %>
      <% (desgravaciones||[]).forEach(function(d) { %>
      <tr>
        <td style="font-size:11px"><strong><%= d.id %></strong></td>
        <td><%= d.titular_dip || d.titular_eip %></td>
        <td><span class="badge badge-purple"><%= d.tipo %></span></td>
        <td><span class="badge <%= d.origen_tipo==='operacion'?'badge-info':'badge-secondary' %>"><%= d.origen_tipo==='operacion'?'⚙️ operación real':'manual' %></span></td>
        <td><%= (d.base||0).toLocaleString() %></td>
        <td><%= (d.iva_pagado||0).toLocaleString() %></td>
        <td><%= d.porcentaje %>%</td>
        <td style="color:#1a7a4a;font-weight:700"><%= (d.cuantia||0).toLocaleString() %> Pz</td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<!-- PATRIMONIO AFECTO (punto 7) -->
<h2 class="rsp-section-title" style="margin-top:24px">🏭 Patrimonio empresarial afecto a actividad</h2>
<div style="display:flex;gap:8px;margin-bottom:10px;flex-wrap:wrap">
  <span style="font-size:12px;color:#666;align-self:center">Dinero que la empresa necesita para salarios, servidores, material, inversiones y funcionamiento ordinario: <strong>no se trata como acumulación improductiva</strong> (requiere documento justificativo). Total registrado: <strong><%= estado.patrimonioAfecto.totalImporte.toLocaleString() %> Pz</strong></span>
  <% if (esAdmin) { %>
  <button class="btn btn-sm btn-primary" style="margin-left:auto" onclick="abrirModalAfecto()">➕ Registrar patrimonio afecto</button>
  <% } %>
</div>
<div class="table-container">
  <table>
    <thead><tr><th>Registro</th><th>Entidad</th><th>Importe</th><th>Tipo</th><th>Origen</th><th>Concepto</th><th>Doc. justificativo</th></tr></thead>
    <tbody>
      <% if (!patrimonioAfecto || patrimonioAfecto.length === 0) { %>
      <tr><td colspan="7" style="text-align:center;color:#999;padding:20px">Sin patrimonio afecto registrado. Usa «⚙️ Calcular automáticamente» para registrarlo desde los fondos y gastos reales de las empresas.</td></tr>
      <% } %>
      <% (patrimonioAfecto||[]).forEach(function(p) { %>
      <tr>
        <td style="font-size:11px"><strong><%= p.id %></strong></td>
        <td><%= p.entidad_nombre || p.entidad_eip %></td>
        <td style="color:#3702b3;font-weight:700"><%= (p.importe||0).toLocaleString() %> Pz</td>
        <td><span class="badge badge-purple"><%= p.tipo %></span></td>
        <td><span class="badge <%= p.origen==='automatico'?'badge-info':'badge-secondary' %>"><%= p.origen==='automatico'?'⚙️ automático':'manual' %></span></td>
        <td style="font-size:12px"><%= p.concepto %></td>
        <td><code><%= p.documento_id %></code></td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<!-- MODAL RETRIBUCIÓN -->
<div id="modalRet" style="display:none;position:fixed;inset:0;background:rgba(10,5,30,.55);z-index:200;align-items:center;justify-content:center">
  <div style="background:#fff;border-radius:16px;max-width:520px;width:92%;padding:24px">
    <h3 style="margin:0 0 16px">💰 Registrar retribución</h3>
    <div style="display:grid;gap:10px">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
        <div><label class="form-label">Beneficiario (DIP) *</label><input id="ret_dip" class="form-input"></div>
        <div><label class="form-label">Nombre</label><input id="ret_nombre" class="form-input"></div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
        <div><label class="form-label">Entidad (EIP) *</label><input id="ret_eip" class="form-input"></div>
        <div><label class="form-label">Nombre entidad</label><input id="ret_nombre_eip" class="form-input"></div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
        <div><label class="form-label">% participación *</label><input id="ret_pct" type="number" class="form-input" value="30"></div>
        <div><label class="form-label">Mes</label><input id="ret_mes" type="month" class="form-input"></div>
      </div>
      <label style="display:flex;align-items:center;gap:8px;font-size:13px"><input type="checkbox" id="ret_decl" checked> Declaro que no recibo sueldo, dividendos, honorarios ni dietas de esta entidad (obligatorio)</label>
    </div>
    <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:16px">
      <button class="btn btn-secondary" onclick="document.getElementById('modalRet').style.display='none'">Cancelar</button>
      <button class="btn btn-primary" onclick="crearRet()">Registrar</button>
    </div>
  </div>
</div>

<!-- MODAL DESGRAVACIÓN -->
<div id="modalDes" style="display:none;position:fixed;inset:0;background:rgba(10,5,30,.55);z-index:200;align-items:center;justify-content:center">
  <div style="background:#fff;border-radius:16px;max-width:520px;width:92%;padding:24px">
    <h3 style="margin:0 0 16px">🧾 Registrar desgravación</h3>
    <div style="display:grid;gap:10px">
      <div><label class="form-label">Tipo</label>
        <select id="des_tipo" class="form-input" onchange="toggleDesTipo()"><option value="iva_6">Desgravación 6% IVA</option><option value="donacion">Donación a entidad reconocida</option></select>
      </div>
      <div><label class="form-label">Titular (DIP) *</label><input id="des_dip" class="form-input"></div>
      <div id="des_iva_fields">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
          <div><label class="form-label">Base (Pz)</label><input id="des_base" type="number" class="form-input" value="0"></div>
          <div><label class="form-label">IVA pagado (Pz)</label><input id="des_iva" type="number" class="form-input" value="0"></div>
        </div>
      </div>
      <div id="des_don_fields" style="display:none">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
          <div><label class="form-label">Importe donación (Pz)</label><input id="des_don" type="number" class="form-input" value="0"></div>
          <div><label class="form-label">% desgravación</label><input id="des_pct" type="number" class="form-input" value="10"></div>
        </div>
        <div><label class="form-label">Entidad donataria</label><input id="des_entidad" class="form-input" placeholder="Fundación Banco de La Placeta"></div>
      </div>
    </div>
    <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:16px">
      <button class="btn btn-secondary" onclick="document.getElementById('modalDes').style.display='none'">Cancelar</button>
      <button class="btn btn-primary" onclick="crearDes()">Registrar</button>
    </div>
  </div>
</div>

<!-- MODAL PATRIMONIO AFECTO -->
<div id="modalAfecto" style="display:none;position:fixed;inset:0;background:rgba(10,5,30,.55);z-index:200;align-items:center;justify-content:center">
  <div style="background:#fff;border-radius:16px;max-width:540px;width:92%;padding:24px">
    <h3 style="margin:0 0 16px">🏭 Registrar patrimonio afecto a actividad</h3>
    <div style="display:grid;gap:10px">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
        <div><label class="form-label">Entidad (EIP) *</label><input id="afecto_eip" class="form-input" placeholder="EIP-XJETNL"></div>
        <div><label class="form-label">Nombre entidad</label><input id="afecto_nombre" class="form-input"></div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
        <div><label class="form-label">Importe (Pz) *</label><input id="afecto_importe" type="number" class="form-input" value="0"></div>
        <div><label class="form-label">Tipo</label>
          <select id="afecto_tipo" class="form-input"><option value="salarios">Salarios</option><option value="servidores">Servidores</option><option value="material">Material</option><option value="inversiones">Inversiones</option><option value="proyectos">Proyectos</option><option value="ordinario">Funcionamiento ordinario</option></select>
        </div>
      </div>
      <div><label class="form-label">Concepto</label><input id="afecto_concepto" class="form-input"></div>
      <div><label class="form-label">Documento justificativo (DOC-...) *</label><input id="afecto_doc" class="form-input" placeholder="DOC-2026-000001"></div>
    </div>
    <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:16px">
      <button class="btn btn-secondary" onclick="document.getElementById('modalAfecto').style.display='none'">Cancelar</button>
      <button class="btn btn-primary" onclick="crearAfecto()">Registrar</button>
    </div>
  </div>
</div>

<script>
function abrirModalRet(){ document.getElementById('modalRet').style.display='flex'; }
function abrirModalDes(){ document.getElementById('modalDes').style.display='flex'; }
function abrirModalAfecto(){ document.getElementById('modalAfecto').style.display='flex'; }
['modalRet','modalDes','modalAfecto'].forEach(id => { document.getElementById(id).addEventListener('click', function(e){ if(e.target===this) this.style.display='none'; }); });
function toggleDesTipo(){
  const t = document.getElementById('des_tipo').value;
  document.getElementById('des_iva_fields').style.display = t === 'iva_6' ? '' : 'none';
  document.getElementById('des_don_fields').style.display = t === 'donacion' ? '' : 'none';
}
async function crearRet(){
  const payload = {
    beneficiario_dip: $('#ret_dip').value.trim(),
    beneficiario_nombre: $('#ret_nombre').value.trim(),
    entidad_eip: $('#ret_eip').value.trim(),
    entidad_nombre: $('#ret_nombre_eip').value.trim(),
    porcentaje_participacion: parseFloat($('#ret_pct').value) || 0,
    mes: $('#ret_mes').value || undefined,
    declaracion_ok: $('#ret_decl').checked,
  };
  if(!payload.beneficiario_dip || !payload.entidad_eip){ alert('Beneficiario y entidad son obligatorios'); return; }
  await post('/rsp/fiscalidad/api/retribuciones', payload);
}
async function crearDes(){
  const tipo = $('#des_tipo').value;
  const payload = { titular_dip: $('#des_dip').value.trim() };
  if(tipo === 'iva_6'){
    payload.base = parseFloat($('#des_base').value) || 0;
    payload.iva_pagado = parseFloat($('#des_iva').value) || 0;
    payload.tipo = 'iva_6';
    if(!payload.titular_dip){ alert('El titular es obligatorio'); return; }
    await post('/rsp/fiscalidad/api/desgravaciones/iva', payload);
  } else {
    payload.donacion = parseFloat($('#des_don').value) || 0;
    payload.porcentaje = parseFloat($('#des_pct').value) || 0;
    payload.entidad_donataria = $('#des_entidad').value.trim();
    payload.tipo = 'donacion';
    if(!payload.titular_dip){ alert('El titular es obligatorio'); return; }
    await post('/rsp/fiscalidad/api/desgravaciones/donacion', payload);
  }
}
async function crearAfecto(){
  const payload = {
    entidad_eip: $('#afecto_eip').value.trim(),
    entidad_nombre: $('#afecto_nombre').value.trim(),
    importe: parseFloat($('#afecto_importe').value) || 0,
    tipo: $('#afecto_tipo').value,
    concepto: $('#afecto_concepto').value.trim(),
    documento_id: $('#afecto_doc').value.trim(),
  };
  if(!payload.entidad_eip || !payload.documento_id){ alert('Entidad y documento justificativo son obligatorios'); return; }
  await post('/rsp/fiscalidad/api/patrimonio-afecto', payload);
}
async function justificar(id){
  const justificacion = prompt('Justificación del exceso:');
  if(!justificacion) return;
  await post('/rsp/fiscalidad/api/limite/' + id + '/justificar', { justificacion });
}
async function regularizar(id){
  if(!confirm('¿Retirar el excedente dejando la cuenta en 500.000 Pz? (regularización del límite, no multa)')) return;
  await post('/rsp/fiscalidad/api/limite/' + id + '/regularizar', {});
}
async function ordenarRet(id){
  if(!confirm('¿Ordenar el pago desde el Fondo de Apoyo (Tributos → Banco → usuario)?')) return;
  await post('/rsp/fiscalidad/api/retribuciones/' + id + '/ordenar', {});
}
async function calcularAutomatico(){
  if(!confirm('Calcular y registrar automáticamente con los DATOS REALES:\n\n· Retribuciones 250 Pz/mes de propietarios sin remuneración (desde participaciones vigentes, excluyendo quien cobra nómina).\n· Desgravaciones del 6% del IVA de las operaciones reales del banco.\n\nSe respeta lo ya generado (no duplica). ¿Continuar?')) return;
  const btn = document.querySelector('button[onclick="calcularAutomatico()"]');
  if (btn) { btn.disabled = true; btn.textContent = '⏳ Calculando…'; }
  try {
    const r = await fetch('/rsp/fiscalidad/api/calcular-automatico', { method:'POST', headers:{'Content-Type':'application/json'}, body:'{}' });
    const j = await r.json();
    if(!j.success){ alert('Error: ' + j.error); if (btn){btn.disabled=false;btn.textContent='⚙️ Calcular automáticamente';} return; }
    const res = j.resultado;
    const s = res.resumen;
    const caja = document.getElementById('resAuto');
    caja.style.display = '';
    caja.innerHTML =
      '<div style="font-weight:700;margin-bottom:6px">✅ Cálculo automático completado — mes ' + res.mes + '</div>' +
      '<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:8px;font-size:13px">' +
      '<div>💰 <strong>' + s.retribucionesGeneradas + '</strong> propietarios · <strong>' + s.totalRetribucionesPz.toLocaleString() + ' Pz</strong>/mes</div>' +
      '<div>🧾 <strong>' + s.desgravacionesRegistradas + '</strong> desgravaciones 6% IVA · <strong>' + s.totalIvaDesgravadoPz.toLocaleString() + ' Pz</strong></div>' +
      '<div>🏭 <strong>' + s.patrimonioAfectoRegistrado + '</strong> registros de patrimonio afecto automático</div>' +
      '</div>' +
      '<div style="font-size:12px;color:#666;margin-top:6px">Sin duplicados: se han respetado las retribuciones/desgravaciones ya existentes del mes.</div>';
    if (btn) { btn.disabled = false; btn.textContent = '⚙️ Calcular automáticamente'; }
    setTimeout(function(){ window.location.reload(); }, 900);
  } catch(e){ alert('Error: ' + e.message); if (btn){btn.disabled=false;btn.textContent='⚙️ Calcular automáticamente';} }
}
async function post(url, payload){
  try {
    const r = await fetch(url, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload) });
    const j = await r.json();
    if(!j.success){ alert('Error: ' + j.error); return; }
    window.location.reload();
  } catch(e){ alert('Error: ' + e.message); }
}
function $(id){ return document.getElementById(id); }
</script>
