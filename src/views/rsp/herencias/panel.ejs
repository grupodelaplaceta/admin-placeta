<!-- ═══ BAJAS / HERENCIAS / TESTAMENTO ═══ -->
<div class="rsp-hero" style="background:linear-gradient(135deg,#3b0764 0%,#5b21b6 55%,#8b5cf6 100%)">
  <div class="rsp-hero-content">
    <div style="width:84px;height:84px;border-radius:20px;background:rgba(255,255,255,.14);display:flex;align-items:center;justify-content:center;font-size:42px;box-shadow:0 6px 20px rgba(0,0,0,.25)">📜</div>
    <div style="flex:1">
      <h1 class="rsp-hero-title">Bajas, Altas, Herencias y Testamento Digital</h1>
      <p class="rsp-hero-sub">Puntos 17-21 · Conservación del DIP · Reactivación · Testamento digital · Herencias · Fondos sin heredero → Fundación · Participaciones sin heredero</p>
      <div class="rsp-hero-stats">
        <span>Bajas activas: <strong><%= estado.bajasActivas %></strong></span>
        <span>Testamentos: <strong><%= estado.testamentos %></strong></span>
        <span>Herencias abiertas: <strong><%= estado.herenciasAbiertas %></strong></span>
        <span>→ Fundación: <strong><%= estado.fondosAFundacion.toLocaleString() %> Pz</strong></span>
      </div>
    </div>
  </div>
</div>

<div style="display:flex;gap:8px;margin:14px 0;flex-wrap:wrap">
  <% if (esAdmin) { %>
  <button class="btn btn-primary" onclick="abrirModalBaja()">➖ Dar de baja</button>
  <button class="btn btn-secondary" onclick="abrirModalTest()">📜 Crear testamento</button>
  <button class="btn btn-secondary" onclick="abrirModalHer()">⚖️ Iniciar herencia</button>
  <% } %>
</div>

<!-- ═══ BAJAS ═══ -->
<div class="rsp-section-title">➖ Bajas de usuarios</div>
<div class="table-container">
  <table>
    <thead><tr><th>Baja</th><th>DIP</th><th>Nombre</th><th>Motivo</th><th>Fecha</th><th>Conservar hasta</th><th>Estado</th><th></th></tr></thead>
    <tbody>
      <% if (!bajas || bajas.length === 0) { %>
      <tr><td colspan="8" style="text-align:center;color:#999;padding:24px">Sin bajas registradas.</td></tr>
      <% } %>
      <% (bajas||[]).forEach(function(b) { %>
      <tr>
        <td style="font-size:11px"><strong><%= b.id %></strong></td>
        <td><code><%= b.dip %></code></td>
        <td><%= b.nombre || '—' %></td>
        <td style="font-size:12px"><%= b.motivo || '—' %></td>
        <td style="font-size:11px"><%= b.fecha_baja ? b.fecha_baja.slice(0,10) : '—' %></td>
        <td style="font-size:11px"><%= b.conservar_hasta || '—' %></td>
        <td><span class="badge <%= b.estado==='baja_activa'?'badge-danger':'badge-success' %>"><%= b.estado %></span></td>
        <td><% if (esAdmin && b.estado === 'baja_activa') { %><button class="btn btn-sm btn-success" onclick="reactivar('<%= b.id %>')">↩️ Reactivar</button><% } %></td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<!-- ═══ TESTAMENTOS ═══ -->
<div class="rsp-section-title" style="margin-top:22px">📜 Testamentos digitales</div>
<div class="table-container">
  <table>
    <thead><tr><th>Testamento</th><th>Titular</th><th>Herederos</th><th>Bienes</th><th>Estado</th></tr></thead>
    <tbody>
      <% if (!testamentos || testamentos.length === 0) { %>
      <tr><td colspan="5" style="text-align:center;color:#999;padding:24px">Sin testamentos registrados.</td></tr>
      <% } %>
      <% (testamentos||[]).forEach(function(t) { %>
      <tr>
        <td style="font-size:11px"><strong><%= t.id %></strong></td>
        <td><%= t.nombre || t.dip %></td>
        <td><%= (t.herederos||[]).map(h => (h.nombre||h.dip) + ' (' + (h.porcentaje||0) + '%)').join(', ') || '—' %></td>
        <td><%= (t.bienes||[]).length %></td>
        <td><span class="badge badge-success"><%= t.estado %></span></td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<!-- ═══ HERENCIAS ═══ -->
<div class="rsp-section-title" style="margin-top:22px">⚖️ Procesos de herencia</div>
<div class="table-container">
  <table>
    <thead><tr><th>Herencia</th><th>Causante</th><th>Bienes</th><th>Participaciones</th><th>Deudas</th><th>Estado</th><th></th></tr></thead>
    <tbody>
      <% if (!herencias || herencias.length === 0) { %>
      <tr><td colspan="7" style="text-align:center;color:#999;padding:24px">Sin procesos de herencia.</td></tr>
      <% } %>
      <% (herencias||[]).forEach(function(h) { %>
      <tr onclick="window.location='/rsp/herencias/<%= h.id %>'" style="cursor:pointer">
        <td style="font-size:11px"><strong><%= h.id %></strong></td>
        <td><%= h.causante_nombre || h.causante_dip %></td>
        <td><%= (h.bienes||[]).filter(b => !b.transmitido_a).length %>/<%= (h.bienes||[]).length %></td>
        <td><%= (h.participaciones||[]).length %></td>
        <td><%= (h.deudas||[]).filter(d => d.estado !== 'liquidada').length %></td>
        <td><span class="badge <%= h.estado==='cerrada'?'badge-success':'badge-warning' %>"><%= h.estado %></span></td>
        <td><a href="/rsp/herencias/<%= h.id %>" class="btn btn-sm btn-secondary">Ver</a></td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<!-- MODAL BAJA -->
<div id="modalBaja" style="display:none;position:fixed;inset:0;background:rgba(20,5,50,.5);z-index:300;align-items:center;justify-content:center;backdrop-filter:blur(4px)">
  <div style="background:#fff;border-radius:20px;max-width:520px;width:92%;padding:26px">
    <h3 style="margin:0 0 16px">➖ Dar de baja a un usuario</h3>
    <div style="display:grid;gap:12px">
      <div><label class="form-label">DIP *</label><input id="baja_dip" class="form-input" placeholder="23749931M"></div>
      <div><label class="form-label">Nombre</label><input id="baja_nombre" class="form-input"></div>
      <div><label class="form-label">Motivo</label><textarea id="baja_motivo" class="form-input" rows="2"></textarea></div>
      <div><label class="form-label">Conservar hasta (por defecto 7 años)</label><input id="baja_conservar" type="date" class="form-input"></div>
      <p style="font-size:12px;color:#888">Al dar de baja: el DIP y PlacetaID quedan inactivos, las operaciones se congelan y Tributos determinará patrimonio y obligaciones pendientes.</p>
    </div>
    <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:16px">
      <button class="btn btn-secondary" onclick="document.getElementById('modalBaja').style.display='none'">Cancelar</button>
      <button class="btn btn-danger" onclick="crearBaja()">Confirmar baja</button>
    </div>
  </div>
</div>

<!-- MODAL TESTAMENTO -->
<div id="modalTest" style="display:none;position:fixed;inset:0;background:rgba(20,5,50,.5);z-index:300;align-items:center;justify-content:center;backdrop-filter:blur(4px)">
  <div style="background:#fff;border-radius:20px;max-width:560px;width:92%;max-height:90vh;overflow:auto;padding:26px">
    <h3 style="margin:0 0 16px">📜 Crear testamento digital</h3>
    <div style="display:grid;gap:12px">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
        <div><label class="form-label">Titular (DIP) *</label><input id="test_dip" class="form-input"></div>
        <div><label class="form-label">Nombre</label><input id="test_nombre" class="form-input"></div>
      </div>
      <div><label class="form-label">Herederos (dip|nombre|%, uno por línea)</label>
        <textarea id="test_herederos" class="form-input" rows="3" placeholder="23749931M|Nombre Heredero|60"></textarea>
      </div>
      <div><label class="form-label">Bienes (tipo|descripción|valor, uno por línea)</label>
        <textarea id="test_bienes" class="form-input" rows="3" placeholder="cuenta|Cuenta personal|500000"></textarea>
      </div>
      <div><label class="form-label">Disposiciones</label><textarea id="test_dispo" class="form-input" rows="2"></textarea></div>
    </div>
    <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:16px">
      <button class="btn btn-secondary" onclick="document.getElementById('modalTest').style.display='none'">Cancelar</button>
      <button class="btn btn-primary" onclick="crearTest()">Guardar testamento</button>
    </div>
  </div>
</div>

<!-- MODAL HERENCIA -->
<div id="modalHer" style="display:none;position:fixed;inset:0;background:rgba(20,5,50,.5);z-index:300;align-items:center;justify-content:center;backdrop-filter:blur(4px)">
  <div style="background:#fff;border-radius:20px;max-width:560px;width:92%;max-height:90vh;overflow:auto;padding:26px">
    <h3 style="margin:0 0 16px">⚖️ Iniciar proceso de herencia</h3>
    <div style="display:grid;gap:12px">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
        <div><label class="form-label">Causante (DIP) *</label><input id="her_dip" class="form-input"></div>
        <div><label class="form-label">Nombre</label><input id="her_nombre" class="form-input"></div>
      </div>
      <div><label class="form-label">Herederos (dip|nombre|%|situacion)</label>
        <textarea id="her_herederos" class="form-input" rows="3" placeholder="23749931M|Heredero 1|50|activo"></textarea>
      </div>
      <div><label class="form-label">Bienes (tipo|id|descripción|valor)</label>
        <textarea id="her_bienes" class="form-input" rows="3" placeholder="cuenta|acct-1|Cuenta personal|500000"></textarea>
      </div>
      <div><label class="form-label">Participaciones (entidad_eip|entidad|%|valor)</label>
        <textarea id="her_part" class="form-input" rows="3" placeholder="EIP-XJETNL|Empresa X|30|30000"></textarea>
      </div>
      <div><label class="form-label">Deudas (concepto|importe)</label>
        <textarea id="her_deudas" class="form-input" rows="2" placeholder="Préstamo|5000"></textarea>
      </div>
    </div>
    <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:16px">
      <button class="btn btn-secondary" onclick="document.getElementById('modalHer').style.display='none'">Cancelar</button>
      <button class="btn btn-primary" onclick="crearHer()">Abrir herencia</button>
    </div>
  </div>
</div>

<script>
['modalBaja','modalTest','modalHer'].forEach(id => { document.getElementById(id).addEventListener('click', function(e){ if(e.target===this) this.style.display='none'; }); });
function abrirModalBaja(){ document.getElementById('modalBaja').style.display='flex'; }
function abrirModalTest(){ document.getElementById('modalTest').style.display='flex'; }
function abrirModalHer(){ document.getElementById('modalHer').style.display='flex'; }
function parseLineas(t){
  return (t||'').trim().split('\n').map(l => l.split('|').map(s=>s.trim())).filter(a => a[0]).map(a => {
    if(a.length === 4 && isNaN(a[2]) && a[3]) return { dip: a[0], nombre: a[1], porcentaje: parseFloat(a[2])||0, situacion: a[3] };
    if(a.length === 4) return { tipo: a[0], id: a[1], descripcion: a[2], valor: parseFloat(a[3])||0 };
    if(a.length === 3 && isNaN(a[1])) return { tipo: a[0], descripcion: a[1], valor: parseFloat(a[2])||0 };
    if(a.length === 3) return { dip: a[0], nombre: a[1], porcentaje: parseFloat(a[2])||0, situacion: 'activo' };
    if(a.length === 2) return { concepto: a[0], importe: parseFloat(a[1])||0 };
    return null;
  }).filter(Boolean);
}
async function crearBaja(){
  const payload = { dip: $('#baja_dip').value.trim(), nombre: $('#baja_nombre').value.trim(), motivo: $('#baja_motivo').value.trim() };
  const conservar = $('#baja_conservar').value;
  if(conservar) payload.conservar_hasta = conservar;
  if(!payload.dip){ alert('El DIP es obligatorio'); return; }
  await post('/rsp/herencias/api/bajas', payload);
}
async function reactivar(id){
  const motivo = prompt('Motivo de la reactivación:');
  if(!motivo) return;
  await post('/rsp/herencias/api/bajas/' + id + '/reactivar', { motivo });
}
async function crearTest(){
  const herederos = parseLineas($('#test_herederos').value).map(h => ({ dip: h.dip, nombre: h.nombre, porcentaje: h.porcentaje || 0, situacion: h.situacion || 'activo' }));
  const bienes = parseLineas($('#test_bienes').value);
  const payload = { dip: $('#test_dip').value.trim(), nombre: $('#test_nombre').value.trim(), herederos, bienes, disposiciones: $('#test_dispo').value.trim() };
  if(!payload.dip){ alert('El titular es obligatorio'); return; }
  await post('/rsp/herencias/api/testamentos', payload);
}
async function crearHer(){
  const herederos = parseLineas($('#her_herederos').value);
  const bienes = parseLineas($('#her_bienes').value);
  const participaciones = parseLineas($('#her_part').value);
  const deudas = parseLineas($('#her_deudas').value);
  const payload = {
    causante_dip: $('#her_dip').value.trim(),
    causante_nombre: $('#her_nombre').value.trim(),
    herederos, bienes, participaciones, deudas,
  };
  if(!payload.causante_dip){ alert('El causante es obligatorio'); return; }
  await post('/rsp/herencias/api/herencias', payload);
}
async function post(url, payload){
  try {
    const r = await fetch(url, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload) });
    const j = await r.json();
    if(!j.success){ alert('Error: ' + j.error); return; }
    if(j.herencia) window.location = '/rsp/herencias/' + j.herencia.id;
    else window.location.reload();
  } catch(e){ alert('Error: ' + e.message); }
}
function $(id){ return document.getElementById(id); }
</script>
