<div class="rsp-hero" style="padding:20px 24px">
  <div class="rsp-hero-content" style="gap:14px">
    <img src="/img/rsp-logo.png" alt="RSP" class="rsp-hero-logo" style="width:52px;height:52px;padding:5px">
    <div>
      <h1 class="rsp-hero-title" style="font-size:18px">🔴🟢 Puntos Placeta Junior</h1>
      <p class="rsp-hero-sub">Puntos verdes (progreso), rojos (errores) y Placetas canjeadas por junior</p>
    </div>
  </div>
</div>

<% if (!puntosList.length) { %>
  <div class="rsp-empty"><div class="rsp-empty-icon">🟢</div><h3>Sin puntos registrados</h3><p>Los puntos aparecerán al usar la app o la web de Placeta Junior.</p></div>
<% } else { %>
<div class="rsp-card">
  <div class="rsp-table-wrap">
    <table class="rsp-table">
      <thead><tr><th>Junior</th><th>DIP</th><th>🟢 Verdes</th><th>🔴 Rojos</th><th>🪙 Canjeado (Pz)</th><th>Total</th></tr></thead>
      <tbody>
        <% puntosList.forEach(function(p) { %>
        <% const m = nombres[p.junior_id]; %>
        <tr>
          <td><strong><%= m ? m.nombre : (p.junior_id || '').slice(0, 10) %></strong></td>
          <td style="font-size:11px;color:#888"><%= m ? m.dip : '—' %></td>
          <td><span class="badge badge-success"><%= p.puntos_verdes || 0 %></span></td>
          <td><span class="badge badge-danger"><%= p.puntos_rojos || 0 %></span></td>
          <td><span class="badge badge-warning"><%= p.canjeado || 0 %> Pz</span></td>
          <td><strong><%= (p.puntos_verdes || 0) + (p.puntos_rojos || 0) %></strong></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>
<% } %>
