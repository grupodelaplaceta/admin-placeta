<div class="flex gap-8 mb-16" style="flex-wrap:wrap;align-items:center">
  <input type="text" id="searchInput" placeholder="Buscar contribuyente..." class="form-input" style="width:300px">
  <button class="btn-secondary" data-search-btn>🔍</button>
  <span style="flex:1"></span>
  <button class="btn-primary" onclick="generarDeclaracionesMasivas()">🗓️ Generar declaraciones mensuales</button>
  <span id="genResult" style="font-size:12px"></span>
</div>

<!-- KPIs declaraciones -->
<div class="stats-grid mb-16">
  <div class="stat-card"><span class="stat-value"><%= totalDeclaraciones %></span><span class="stat-label">Declaraciones</span></div>
  <div class="stat-card"><span class="stat-value"><%= total %></span><span class="stat-label">Contribuyentes</span></div>
</div>

<script>
async function generarDeclaracionesMasivas() {
  const res = document.getElementById('genResult');
  if (!confirm('🗓️ ¿Generar las declaraciones mensuales de TODOS los contribuyentes desde junio de 2026?\nSe crearán los borradores que falten para cada mes y cada cuenta.')) return;
  res.textContent = '⏳ Generando… (puede tardar unos segundos)';
  res.style.color = '#666';
  try {
    const r = await fetch('/tributos/api/reconciliar-todas', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({}) });
    const data = await r.json();
    if (data.success) {
      res.textContent = `✅ ${data.creadas} nuevas · ${data.yaExistentes} ya existían · ${data.errores} errores · (${data.contribuyentes} contribuyentes, ${data.meses} meses)`;
      res.style.color = '#00c853';
      setTimeout(() => location.reload(), 1500);
    } else {
      res.textContent = '❌ ' + (data.error || 'Error al generar');
      res.style.color = '#d03131';
    }
  } catch (e) { res.textContent = '⚠️ Error: ' + e.message; res.style.color = '#d03131'; }
}
</script>

<!-- Verificador de EIP (registro real) -->
<div class="info-card mb-16" style="background:linear-gradient(135deg,#f6f3ff,#fbfaff);border:1px solid #e0d8f0">
  <h4>🔎 Verificar EIP</h4>
  <p style="font-size:12px;color:var(--text-light);margin:4px 0 8px">Comprueba contra el Registro Tributario real que un EIP existe y a qué cuenta pertenece (lo usa el Banco para validar).</p>
  <div class="flex gap-8" style="align-items:center">
    <input type="text" id="eipCheckInput" placeholder="EIP-XXXXXX" class="form-input" style="width:220px" onkeydown="if(event.key==='Enter')verificarEip()">
    <button class="btn-primary" onclick="verificarEip()">Verificar</button>
    <span id="eipCheckResult" style="font-size:13px"></span>
  </div>
</div>
<script>
async function verificarEip() {
  const inp = document.getElementById('eipCheckInput');
  const res = document.getElementById('eipCheckResult');
  const eip = (inp.value||'').trim().toUpperCase();
  if (!eip) { res.innerHTML = '⚠️ Introduce un EIP'; return; }
  res.innerHTML = '⏳ Comprobando…';
  try {
    const r = await fetch('/tributos/api/validar-eip?eip=' + encodeURIComponent(eip));
    const data = await r.json();
    if (data.verificado) {
      const e = data.entidad || {};
      res.innerHTML = '✅ <strong>EIP válido</strong> — ' +
        (e.nombre || e.displayName || e.titular || eip) +
        (e.tipo ? ' · <em>'+e.tipo+'</em>' : '') +
        (e.iban ? ' · <span class="text-mono">'+e.iban+'</span>' : '');
    } else {
      res.innerHTML = '❌ ' + (data.error || 'EIP no encontrado en el Registro Tributario');
    }
  } catch (e) {
    res.innerHTML = '⚠️ Error al verificar: ' + (e.message||'');
  }
}

// Dar de alta un contribuyente (registro REAL en Tributos)
async function altaContribuyente(form) {
  const btn = form.querySelector('button[type=submit]');
  const msg = document.getElementById('altaResult');
  const fd = new FormData(form);
  const tipo = fd.get('tipo_sujeto');
  const payload = {
    dip: (fd.get('dip')||'').trim(),
    nombre: (fd.get('nombre')||'').trim(),
    tipo_sujeto: tipo,
    eip: tipo === 'Empresa' ? (fd.get('eip')||'').trim() : '',
    iban: (fd.get('iban')||'').trim(),
    placeta_id: (fd.get('placeta_id')||'').trim()
  };
  if (!payload.dip || !payload.nombre) { msg.textContent = '⚠️ DIP y nombre son obligatorios'; return; }
  msg.textContent = '⏳ Dando de alta…';
  btn.disabled = true;
  try {
    const r = await fetch('/tributos/api/alta', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(payload) });
    const data = await r.json();
    if (data.success) {
      msg.textContent = '✅ ' + (data.message || 'Contribuyente dado de alta') + (data.eip ? ' · EIP ' + data.eip : '');
      form.reset();
    } else {
      msg.textContent = '❌ ' + (data.error || 'Error al dar de alta');
    }
  } catch (e) { msg.textContent = '⚠️ ' + (e.message||''); }
  btn.disabled = false;
}
</script>

<!-- Dar de alta contribuyente -->
<div class="info-card mb-16" style="background:#fff;border:1px solid #d8d0e8">
  <h4>➕ Dar de alta contribuyente (Tributos)</h4>
  <p style="font-size:12px;color:var(--text-light);margin:4px 0 8px">Registra un contribuyente en el censo real. Para empresas, el EIP queda vinculado a esa cuenta.</p>
  <form onsubmit="event.preventDefault();altaContribuyente(this)">
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:8px">
      <input name="dip" placeholder="DIP" class="form-input">
      <input name="nombre" placeholder="Nombre / Razón social" class="form-input">
      <select name="tipo_sujeto" class="form-input">
        <option value="Fisico">Persona Física</option>
        <option value="Empresa">Empresa</option>
      </select>
      <input name="eip" placeholder="EIP (solo empresa)" class="form-input">
      <input name="iban" placeholder="IBAN (opcional)" class="form-input">
      <input name="placeta_id" placeholder="Placeta ID (opcional)" class="form-input">
    </div>
    <div style="margin-top:8px;display:flex;gap:10px;align-items:center">
      <button type="submit" class="btn-primary">Dar de alta</button>
      <span id="altaResult" style="font-size:13px"></span>
    </div>
  </form>
</div>

<div class="table-container">
  <table>
    <thead><tr><th>ID</th><th>Nombre</th><th>Tipo</th><th>IBAN</th><th>EIP</th><th>Estado Fiscal</th><th>Declaraciones mensuales</th><th>Docs</th></tr></thead>
    <tbody>
      <% (contribuyentes || []).forEach(c => { %>
      <% const decls = (declaraciones && declaraciones.get(c.placetaId)) || (declaraciones && declaraciones.get(c.id)) || []; %>
      <tr>
        <td class="text-mono"><%= c.id %></td>
        <td><strong><%= c.displayName || '—' %></strong></td>
        <td><span class="badge badge-info"><%= c.type || '—' %></span></td>
        <td class="text-mono"><%= c.iban || '—' %></td>
        <td class="text-mono"><%= c.eip || '—' %></td>
        <td><span class="badge <%= c.tributosCensusDate ? 'badge-success' : 'badge-warning' %>"><%= c.tributosCensusDate ? 'Al Dia' : 'Pendiente' %></span></td>
        <td>
          <% if (decls.length === 0) { %>
          <span style="font-size:11px;color:#999">Sin declaraciones</span>
          <% } else { %>
          <details style="max-width:320px">
            <summary style="cursor:pointer;font-size:12px;color:#3702b3"><%= decls.length %> declaración<%= decls.length > 1 ? 'es' : '' %> ▾</summary>
            <div style="margin-top:6px;display:flex;flex-direction:column;gap:3px">
              <% decls.forEach(d => { %>
              <a href="/tributos/declaraciones?busqueda=<%= d.placeta_id %>" class="rsp-link" style="font-size:11px;display:flex;justify-content:space-between;gap:8px;border-bottom:1px solid #f0ecf8;padding:2px 0">
                <span><%= d.mes_periodo %></span>
                <span style="color:#888"><%= ((d.cuota_irm||0)+(d.cuota_igf||0)).toLocaleString() %> Pz</span>
              </a>
              <% }) %>
            </div>
          </details>
          <% } %>
        </td>
        <td><button class="btn-sm btn-secondary" onclick="verDocsDe('contribuyente','<%= c.id %>','tributos','<%= (c.displayName || c.id).slice(0,20) %>')">📄</button></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<p style="font-size:12px;color:var(--text-light);margin-top:8px">Total: <strong><%= total %></strong> contribuyentes · <strong><%= totalDeclaraciones %></strong> declaraciones mensuales</p>
