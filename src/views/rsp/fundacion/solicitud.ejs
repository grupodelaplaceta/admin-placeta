<div style="margin-bottom:14px"><a href="/rsp/fundacion" class="btn btn-sm btn-ghost">← Fundación</a></div>
<div class="rsp-hero" style="background:linear-gradient(135deg,#7a1fa2 0%,#ab47bc 100%)">
  <div class="rsp-hero-content">
    <div style="width:80px;height:80px;border-radius:16px;background:rgba(255,255,255,.13);display:flex;align-items:center;justify-content:center;font-size:38px"><%= sol.rbu ? '🧒' : '📨' %></div>
    <div style="flex:1">
      <div class="rsp-hero-title"><%= sol.id %></div>
      <div class="rsp-hero-sub" style="font-size:17px;opacity:.95"><%= sol.solicitante_nombre || sol.solicitante_dip %> · <%= sol.rbu ? 'RBU' : (sol.programa_id || 'Ayuda') %></div>
      <div class="rsp-hero-stats">
        <span>Solicitado: <strong><%= sol.importe_solicitado.toLocaleString() %> Pz</strong></span>
        <span>Concedido: <strong><%= (sol.importe_concedido||0).toLocaleString() %> Pz</strong></span>
        <span>Estado: <strong><%= sol.estado %></strong></span>
      </div>
    </div>
  </div>
</div>

<div style="display:flex;gap:8px;margin:14px 0;flex-wrap:wrap">
  <% if (esAdmin && ['recibida','en_revision'].includes(sol.estado)) { %>
  <button class="btn btn-sm btn-primary" onclick="conceder()">✅ Conceder</button>
  <% } %>
  <% if (esAdmin && sol.estado === 'concedida') { %>
  <button class="btn btn-sm btn-success" onclick="pagar()">💰 Ordenar pago</button>
  <% } %>
  <% if (esAdmin && !['pagada','cerrada'].includes(sol.estado)) { %>
  <button class="btn btn-sm btn-secondary" onclick="cambiarEstado()">↔️ Estado</button>
  <% } %>
  <% if (esAdmin && sol.expediente_id) { %>
  <a href="/rsp/expedientes/<%= sol.expediente_id %>" class="btn btn-sm btn-outline">🗂️ Expediente</a>
  <% } %>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
  <div class="table-container">
    <div style="padding:12px 16px;font-weight:700;font-size:13px;border-bottom:1px solid #e8e4f0">📋 Datos</div>
    <table>
      <tbody>
        <tr><th style="width:160px">Solicitante</th><td><%= sol.solicitante_dip %></td></tr>
        <tr><th>Beneficiario</th><td><%= sol.beneficiario_nombre || sol.beneficiario_dip %></td></tr>
        <tr><th>Programa</th><td><%= sol.programa_id || '—' %></td></tr>
        <tr><th>Resolución</th><td><%= sol.resolucion || '—' %></td></tr>
        <tr><th>Expediente</th><td><%= sol.expediente_id || '—' %></td></tr>
        <tr><th>Creado</th><td><%= sol.created_at ? sol.created_at.slice(0,16).replace('T',' ') : '—' %></td></tr>
      </tbody>
    </table>
  </div>
  <div class="table-container">
    <div style="padding:12px 16px;font-weight:700;font-size:13px;border-bottom:1px solid #e8e4f0">💸 Pagos</div>
    <table>
      <thead><tr><th>Orden</th><th>Importe</th><th>Fecha</th><th>Ordenado por</th></tr></thead>
      <tbody>
        <% if (!sol.pagos || sol.pagos.length === 0) { %>
        <tr><td colspan="4" style="text-align:center;color:#999;padding:20px">Sin pagos.</td></tr>
        <% } %>
        <% (sol.pagos||[]).forEach(function(p) { %>
        <tr><td style="font-size:11px"><%= p.orden %></td><td><strong><%= p.importe.toLocaleString() %> Pz</strong></td><td style="font-size:11px"><%= p.fecha.slice(0,16).replace('T',' ') %></td><td><%= p.ordenado_por %></td></tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<script>
async function conceder(){
  const importe = prompt('Importe a conceder (Pz):', String(sol_importe_default || 0));
  if(importe === null) return;
  const r = await fetch('/rsp/fundacion/api/solicitudes/<%= sol.id %>/conceder', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ importe: parseFloat(importe) }) });
  const j = await r.json();
  if(!j.success){ alert('Error: ' + j.error); return; }
  window.location.reload();
}
async function pagar(){
  if(!confirm('¿Confirmas la orden de pago?')) return;
  const r = await fetch('/rsp/fundacion/api/solicitudes/<%= sol.id %>/pagar', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({}) });
  const j = await r.json();
  if(!j.success){ alert('Error: ' + j.error); return; }
  alert('✅ Pago ordenado');
  window.location.reload();
}
async function cambiarEstado(){
  const estado = prompt('Nuevo estado (' + ['recibida','en_revision','concedida','denegada','pagada','cerrada'].join(', ') + '):', '<%= sol.estado %>');
  if(!estado) return;
  const nota = prompt('Nota / resolución:');
  const r = await fetch('/rsp/fundacion/api/solicitudes/<%= sol.id %>/estado', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ estado, nota }) });
  const j = await r.json();
  if(!j.success){ alert('Error: ' + j.error); return; }
  window.location.reload();
}
const sol_importe_default = <%= sol.importe_solicitado || 0 %>;
</script>
