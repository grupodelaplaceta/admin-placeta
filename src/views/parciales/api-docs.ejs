<%# Panel de Documentación y Gestión de APIs
  Variables esperadas:
    api       - Objeto del registro de APIs (getEntityAPI)
    apps      - Apps registradas para esta entidad
    tarifas   - Tarifas RSP
    iban      - IBAN de la entidad
    endpoints - Endpoints disponibles
%>
<div class="api-docs-container">
  <!-- ═══ HEADER  ═══ -->
  <div class="info-card mb-16">
    <div class="flex items-center justify-between">
      <div>
        <h4><%= api.icono || '🔌' %> API — <%= api.nombre %></h4>
        <p style="font-size:13px;color:#666;margin-top:4px"><%= api.descripcion %></p>
      </div>
      <div style="text-align:right">
        <span class="badge badge-purple" style="font-size:11px">v1.0.0</span>
        <div style="font-size:11px;color:#999;margin-top:4px">
          IBAN: <code style="font-size:10px"><%= iban %></code>
        </div>
      </div>
    </div>
    <div class="flex items-center gap-12 mt-8" style="flex-wrap:wrap">
      <span class="badge badge-info">💰 Consulta: <%= tarifas.consulta.total.toFixed(5) %> Pz</span>
      <span class="badge badge-warning">✏️ Modificación: <%= tarifas.modificacion.total.toFixed(3) %> Pz</span>
      <span class="badge badge-purple">📱 <%= api.endpoints.length %> endpoints</span>
      <a href="/api/v1/<%= entidad_actual %>/docs" target="_blank" class="btn btn-sm btn-primary">📖 Docs JSON</a>
    </div>
  </div>

  <!-- ═══ TARIFAS Y FACTURACIÓN ═══ -->
  <div class="flex gap-16 mb-16" style="flex-wrap:wrap">
    <div class="info-card" style="flex:1;min-width:280px">
      <h4>💰 Tarifas por Conexión</h4>
      <div class="table-container" style="border-radius:10px;margin-top:8px">
        <table>
          <thead>
            <tr>
              <th>Tipo</th>
              <th>Precio Base</th>
              <th>IVA (12%)</th>
              <th>Total</th>
              <th>Uso</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><span class="badge badge-info">CONSULTA</span></td>
              <td><%= tarifas.consulta.precio.toFixed(3) %> Pz</td>
              <td><%= tarifas.consulta.iva.toFixed(5) %> Pz</td>
              <td><strong><%= tarifas.consulta.total.toFixed(5) %> Pz</strong></td>
              <td style="font-size:11px;color:#888">GET - Lectura de datos</td>
            </tr>
            <tr>
              <td><span class="badge badge-warning">MODIFICACIÓN</span></td>
              <td><%= tarifas.modificacion.precio.toFixed(1) %> Pz</td>
              <td><%= tarifas.modificacion.iva.toFixed(3) %> Pz</td>
              <td><strong><%= tarifas.modificacion.total.toFixed(3) %> Pz</strong></td>
              <td style="font-size:11px;color:#888">POST/PUT/DELETE - Escritura de datos</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p style="font-size:11px;color:#999;margin-top:8px">
        💡 Los costes se facturan automáticamente a la cuenta RSP. 
        IBAN entidad: <code style="font-size:10px"><%= iban %></code>
      </p>
    </div>

    <div class="info-card" style="flex:1;min-width:280px">
      <h4>📱 Apps Conectadas</h4>
      <% if (apps && apps.length > 0) { %>
      <div style="margin-top:8px">
        <% apps.forEach(function(app) { %>
        <div class="flex items-center justify-between" style="padding:8px 0;border-bottom:1px solid #f0ecf8">
          <div>
            <span style="font-weight:600;font-size:13px">
              <% if (app.plataforma === 'android') { %>🤖<% } else if (app.plataforma === 'ios') { %>🍎<% } else { %>🌐<% } %>
              <%= app.nombre %>
            </span>
            <span class="badge <%= app.activa ? 'badge-success' : 'badge-danger' %>" style="margin-left:6px">
              <%= app.activa ? 'Activa' : 'Inactiva' %>
            </span>
          </div>
          <span class="badge badge-outline"><%= app.plataforma %></span>
        </div>
        <% }); %>
      </div>
      <% } else { %>
      <div class="empty-state" style="padding:20px">
        <div class="empty-icon" style="font-size:32px">📱</div>
        <p style="font-size:13px">No hay apps registradas</p>
      </div>
      <% } %>
      <div style="margin-top:12px">
        <button class="btn btn-sm btn-primary" onclick="mostrarModal('Registrar App', `
          <form id="form-registrar-app" onsubmit="return registrarApp(event)">
            <label>Nombre de la App</label>
            <input class="form-input mb-8" name="nombre" placeholder="Mi App" required>
            <label>Plataforma</label>
            <select class="form-input mb-8" name="plataforma" required>
              <option value="android">🤖 Android</option>
              <option value="ios">🍎 iOS</option>
              <option value="web">🌐 Web</option>
            </select>
            <button type="submit" class="btn btn-primary" style="width:100%;margin-top:8px">🔑 Generar API Key</button>
          </form>
        `)">➕ Nueva App</button>
      </div>
    </div>
  </div>

  <!-- ═══ ENDPOINTS ═══ -->
  <div class="info-card mb-16">
    <h4>🔌 Endpoints Disponibles</h4>
    <p style="font-size:12px;color:#888;margin-bottom:12px">
      Base URL: <code style="font-size:11px">/api/v1/<%= entidad_actual %></code>
      &middot; Autenticación: <code style="font-size:11px">X-API-Key</code> + <code style="font-size:11px">X-Platform</code>
    </p>

    <% endpoints.forEach(function(ep) { %>
    <div class="api-endpoint-card" style="
      border:1px solid #e8e4f0;border-radius:10px;margin-bottom:10px;overflow:hidden;
      transition:all 0.15s
    ">
      <div class="api-endpoint-header" style="
        display:flex;align-items:center;gap:10px;padding:10px 14px;
        cursor:pointer;background:#faf8ff;
        border-bottom:1px solid transparent;
      " onclick="this.nextElementSibling.style.display = this.nextElementSibling.style.display === 'none' ? 'block' : 'none'">
        <span class="badge <%= ep.method === 'GET' ? 'badge-success' : ep.method === 'POST' ? 'badge-warning' : ep.method === 'PUT' ? 'badge-info' : 'badge-danger' %>"
              style="font-size:10px;min-width:52px;text-align:center">
          <%= ep.method %>
        </span>
        <code style="font-size:13px;flex:1;background:transparent;padding:0;color:var(--t)">
          /api/v1/<%= entidad_actual %><%= ep.path %>
        </code>
        <div class="flex gap-8 items-center">
          <% ep.platforms.forEach(function(pf) { %>
          <span class="badge badge-outline" style="font-size:8px;padding:1px 6px">
            <% if (pf === 'android') { %>🤖 Android<% } else if (pf === 'ios') { %>🍎 iOS<% } else { %>🌐 Web<% } %>
          </span>
          <% }); %>
          <span class="badge <%= ep.tipo === 'consulta' ? 'badge-info' : 'badge-warning' %>" style="font-size:8px">
            <%= ep.tipo === 'consulta' ? '👁️ Consulta' : '✏️ Modificación' %>
          </span>
          <span style="font-size:12px;color:#999;transform:rotate(0deg);transition:transform 0.2s" class="expand-icon">▶</span>
        </div>
      </div>
      <div class="api-endpoint-body" style="display:none;padding:14px;border-top:1px solid #e8e4f0">
        <p style="font-size:13px;color:#666;margin-bottom:12px"><%= ep.descripcion %></p>

        <% if (ep.params && ep.params.length > 0) { %>
        <div style="margin-bottom:12px">
          <span style="font-size:11px;font-weight:700;color:var(--tm);text-transform:uppercase;letter-spacing:0.5px;display:block;margin-bottom:6px">📥 Parámetros</span>
          <div class="table-container" style="border-radius:8px">
            <table>
              <thead><tr><th>Campo</th><th>Tipo</th><th>Requerido</th><th>Descripción</th></tr></thead>
              <tbody>
                <% ep.params.forEach(function(p) { %>
                <tr>
                  <td><code><%= p.campo %></code></td>
                  <td><span class="badge badge-outline"><%= p.tipo %></span></td>
                  <td><%= p.requerido ? '✅' : '❌' %></td>
                  <td style="font-size:12px;color:#666"><%= p.descripcion %></td>
                </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
        <% } %>

        <div>
          <span style="font-size:11px;font-weight:700;color:var(--tm);text-transform:uppercase;letter-spacing:0.5px;display:block;margin-bottom:6px">📤 Datos de Respuesta</span>
          <div class="table-container" style="border-radius:8px">
            <table>
              <thead><tr><th>Campo</th><th>Tipo</th><th>Descripción</th></tr></thead>
              <tbody>
                <% ep.dataReturn.forEach(function(dr) { %>
                <tr>
                  <td><code><%= dr.campo %></code></td>
                  <td><span class="badge badge-outline"><%= Array.isArray(dr.tipo) ? dr.tipo.join(' | ') : dr.tipo %></span></td>
                  <td style="font-size:12px;color:#666"><%= dr.descripcion %></td>
                </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>

        <div style="margin-top:12px;padding:10px;background:#f6f3ff;border-radius:8px;font-size:12px">
          <strong>💡 Ejemplo de llamada:</strong>
          <pre style="margin-top:6px;font-size:11px;background:#1c005f;color:#fff;padding:10px;border-radius:8px;overflow-x:auto"><%= `curl -X ${ep.method} "https://admin.laplaceta.org/api/v1/${entidad_actual}${ep.path}" \\\n  -H "X-API-Key: tu-api-key" \\\n  -H "X-Platform: web"${ep.method === 'POST' || ep.method === 'PUT' ? ` \\\n  -H "Content-Type: application/json" \\\n  -d '{}'` : ''}` %></pre>
        </div>
      </div>
    </div>
    <% }); %>
  </div>

  <!-- ═══ INSTRUCCIONES DE CONEXIÓN ═══ -->
  <div class="info-card">
    <h4>📋 Cómo conectarse</h4>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:14px;margin-top:10px">
      <div style="padding:14px;background:#f6f3ff;border-radius:10px">
        <div style="font-size:24px;margin-bottom:6px">1️⃣</div>
        <strong style="font-size:13px">Obtén tu API Key</strong>
        <p style="font-size:12px;color:#666;margin-top:4px">
          Cada app necesita una API Key única. Regístrate arriba para generar una.
          La key identifica tu app y restringe su acceso por plataforma.
        </p>
      </div>
      <div style="padding:14px;background:#f0fdf4;border-radius:10px">
        <div style="font-size:24px;margin-bottom:6px">2️⃣</div>
        <strong style="font-size:13px">Autentica tus peticiones</strong>
        <p style="font-size:12px;color:#666;margin-top:4px">
          Incluye los headers <code>X-API-Key</code> y <code>X-Platform</code> en cada petición.
          La plataforma debe coincidir con la asignada a tu key.
        </p>
      </div>
      <div style="padding:14px;background:#fff8e6;border-radius:10px">
        <div style="font-size:24px;margin-bottom:6px">3️⃣</div>
        <strong style="font-size:13px">Tarificación automática</strong>
        <p style="font-size:12px;color:#666;margin-top:4px">
          Cada llamada se tarifica según el tipo (consulta 0.00112 Pz, modificación 0.112 Pz).
          El coste se cobra a la cuenta RSP de la entidad.
        </p>
      </div>
      <div style="padding:14px;background:#fef2f2;border-radius:10px">
        <div style="font-size:24px;margin-bottom:6px">4️⃣</div>
        <strong style="font-size:13px">Restricciones por plataforma</strong>
        <p style="font-size:12px;color:#666;margin-top:4px">
          No todos los endpoints están disponibles en todas las plataformas.
          Revisa las etiquetas 🤖 🍎 🌐 en cada endpoint.
        </p>
      </div>
    </div>
  </div>
</div>

<script>
// ── Registrar nueva app ────────────────────────────────────────────────
async function registrarApp(event) {
  event.preventDefault();
  const form = event.target;
  const data = Object.fromEntries(new FormData(form));
  
  // Generar API Key (simulada)
  const key = `${data.plataforma}-${data.nombre.toLowerCase().replace(/[^a-z0-9]/g,'-')}-key-${new Date().getFullYear()}`;
  
  mostrarToast(`✅ API Key generada para "${data.nombre}" (${data.plataforma})`, 'success');
  
  // Mostrar la key en un modal
  mostrarModal('🔑 API Key Generada', `
    <div style="text-align:center">
      <p style="font-size:14px;margin-bottom:12px">App: <strong>${data.nombre}</strong></p>
      <p style="font-size:14px;margin-bottom:12px">Plataforma: <strong>${data.plataforma}</strong></p>
      <div style="background:#1c005f;color:#fff;padding:14px;border-radius:10px;margin:12px 0;word-break:break-all">
        <code style="font-size:12px;color:#7cffb2;background:transparent">${key}</code>
      </div>
      <p style="font-size:12px;color:#888">⚠️ Guarda esta clave. No podrás verla de nuevo.</p>
      <button class="btn btn-primary mt-8" onclick="navigator.clipboard.writeText('${key}');mostrarToast('Copiado al portapapeles','success')">
        📋 Copiar API Key
      </button>
    </div>
  `);
  
  return false;
}

// ── Inicializar acordeones ─────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.api-endpoint-header').forEach(header => {
    header.addEventListener('click', function() {
      const body = this.nextElementSibling;
      const icon = this.querySelector('.expand-icon');
      const isOpen = body.style.display === 'block';
      body.style.display = isOpen ? 'none' : 'block';
      icon.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(90deg)';
      // Cerrar otros
      if (!isOpen) {
        document.querySelectorAll('.api-endpoint-body').forEach(b => {
          if (b !== body) b.style.display = 'none';
        });
        document.querySelectorAll('.expand-icon').forEach(i => {
          if (i !== icon) i.style.transform = 'rotate(0deg)';
        });
      }
    });
  });
});
</script>

<style>
.api-endpoint-card:hover {
  box-shadow: 0 2px 8px rgba(63,0,216,0.06);
}
.api-endpoint-header:hover {
  background: #f0ecf8 !important;
}
.api-endpoint-header .badge { transition: all 0.15s; }
pre { 
  font-family: 'Courier New', monospace;
  line-height: 1.5;
  white-space: pre-wrap;
}
</style>
