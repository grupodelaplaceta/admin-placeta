<!-- ═══ HEADER RSP ═══ -->
<div class="rsp-hero">
  <div class="rsp-hero-content">
    <img src="/img/rsp-logo.png" alt="RSP" class="rsp-hero-logo">
    <div>
      <h1 class="rsp-hero-title">Red de Servicios de La Placeta</h1>
      <p class="rsp-hero-sub">Plataforma centralizada de datos · <strong>GDLP-AP64-583</strong></p>
      <div class="rsp-hero-stats">
        <span>💰 Fondos: <strong><%= stats.saldoActual.toFixed(2) %> Pz</strong></span>
        <span>⚡ Conexiones: <strong><%= stats.totalConexiones %></strong></span>
        <span>📊 Facturas: <strong><%= stats.facturasEmitidas %></strong></span>
      </div>
    </div>
  </div>
</div>

<!-- ═══ KPIs ═══ -->
<div class="rsp-kpis">
  <div class="rsp-kpi">
    <div class="rsp-kpi-icon" style="background:rgba(55,2,179,.12)">📡</div>
    <div>
      <div class="rsp-kpi-value"><%= stats.totalConexiones.toLocaleString() %></div>
      <div class="rsp-kpi-label">Total Conexiones</div>
    </div>
  </div>
  <div class="rsp-kpi">
    <div class="rsp-kpi-icon" style="background:rgba(0,200,83,.12)">⚡</div>
    <div>
      <div class="rsp-kpi-value"><%= stats.conexionesHoy %></div>
      <div class="rsp-kpi-label">Hoy</div>
    </div>
  </div>
  <div class="rsp-kpi">
    <div class="rsp-kpi-icon" style="background:rgba(55,2,179,.12)">💰</div>
    <div>
      <div class="rsp-kpi-value"><%= stats.saldoActual.toFixed(2) %></div>
      <div class="rsp-kpi-label">Saldo (Pz)</div>
    </div>
  </div>
  <div class="rsp-kpi">
    <div class="rsp-kpi-icon" style="background:rgba(255,109,0,.12)">📈</div>
    <div>
      <div class="rsp-kpi-value"><%= stats.ingresosEsteMes.toFixed(3) %></div>
      <div class="rsp-kpi-label">Ingresos del Mes</div>
    </div>
  </div>
  <div class="rsp-kpi">
    <div class="rsp-kpi-icon" style="background:rgba(41,121,255,.12)">📄</div>
    <div>
      <div class="rsp-kpi-value"><%= stats.facturasEmitidas %></div>
      <div class="rsp-kpi-label">Facturas</div>
    </div>
  </div>
  <div class="rsp-kpi">
    <div class="rsp-kpi-icon" style="background:<%= stats.facturasPendientes > 0 ? 'rgba(255,214,0,.18)' : 'rgba(0,200,83,.12)' %>">
      <%= stats.facturasPendientes > 0 ? '⏳' : '✅' %>
    </div>
    <div>
      <div class="rsp-kpi-value" style="color:<%= stats.facturasPendientes > 0 ? '#e65100' : '#00c853' %>"><%= stats.facturasPendientes %></div>
      <div class="rsp-kpi-label">Pendientes</div>
    </div>
  </div>
</div>

<!-- ═══ TARIFAS ═══ -->
<div class="rsp-section-title">💰 Tarifas Vigentes</div>
<div class="rsp-tarifas">
  <div class="rsp-tarifa-card rsp-tarifa-consulta">
    <div class="rsp-tarifa-header">
      <span class="rsp-tarifa-badge">CONSULTA</span>
      <span class="rsp-tarifa-precio"><%= tarifas.consulta.total.toFixed(4) %></span>
      <span class="rsp-tarifa-moneda">Pz/conexión</span>
    </div>
    <div class="rsp-tarifa-body">
      <div class="rsp-tarifa-detalle">
        <span>Base</span><span><%= tarifas.consulta.precio %> Pz</span>
      </div>
      <div class="rsp-tarifa-detalle">
        <span>IVA 12%</span><span><%= tarifas.consulta.iva.toFixed(4) %> Pz</span>
      </div>
      <p class="rsp-tarifa-desc"><%= tarifas.consulta.descripcion %></p>
    </div>
  </div>
  <div class="rsp-tarifa-card rsp-tarifa-mod">
    <div class="rsp-tarifa-header">
      <span class="rsp-tarifa-badge">MODIFICACIÓN</span>
      <span class="rsp-tarifa-precio"><%= tarifas.modificacion.total.toFixed(3) %></span>
      <span class="rsp-tarifa-moneda">Pz/conexión</span>
    </div>
    <div class="rsp-tarifa-body">
      <div class="rsp-tarifa-detalle">
        <span>Base</span><span><%= tarifas.modificacion.precio %> Pz</span>
      </div>
      <div class="rsp-tarifa-detalle">
        <span>IVA 12%</span><span><%= tarifas.modificacion.iva.toFixed(3) %> Pz</span>
      </div>
      <p class="rsp-tarifa-desc"><%= tarifas.modificacion.descripcion %></p>
    </div>
  </div>
</div>

<!-- ═══ ACCIONES RÁPIDAS ═══ -->
<div class="rsp-section-title">⚡ Acceso Rápido</div>
<div class="rsp-acciones">
  <a href="/rsp/conexiones" class="rsp-btn rsp-btn-primary">
    <span class="rsp-btn-icon">📡</span>
    <span class="rsp-btn-text">Ver Conexiones</span>
    <span class="rsp-btn-arrow">→</span>
  </a>
  <a href="/rsp/facturacion" class="rsp-btn rsp-btn-secondary">
    <span class="rsp-btn-icon">📄</span>
    <span class="rsp-btn-text">Facturación</span>
    <span class="rsp-btn-arrow">→</span>
  </a>
  <a href="/rsp/fondos" class="rsp-btn rsp-btn-secondary">
    <span class="rsp-btn-icon">💰</span>
    <span class="rsp-btn-text">Fondos</span>
    <span class="rsp-btn-arrow">→</span>
  </a>
  <a href="/rsp/apis" class="rsp-btn rsp-btn-outline">
    <span class="rsp-btn-icon">🔌</span>
    <span class="rsp-btn-text">APIs</span>
    <span class="rsp-btn-arrow">→</span>
  </a>
</div>

<!-- ═══ ÚLTIMAS CONEXIONES ═══ -->
<div class="rsp-section-title">📡 Últimas Conexiones</div>
<div class="rsp-card">
  <div class="rsp-card-header">
    <span>Registro de actividad reciente</span>
    <a href="/rsp/conexiones" class="rsp-link">Ver todas →</a>
  </div>
  <% if (conexionesRecientes.length === 0) { %>
  <div class="rsp-empty">
    <div class="rsp-empty-icon">📡</div>
    <h3>Sin conexiones registradas</h3>
    <p>Las conexiones aparecerán automáticamente al usar las APIs.</p>
  </div>
  <% } else { %>
          <td>
            <span class="badge <%= c.tipo === 'modificacion' ? 'badge-warning' : 'badge-info' %>">
              <%= c.tipo === 'modificacion' ? '✏️ MOD' : '👁️ CON' %>
            </span>
          </td>
          <td style="font-size:11px;max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= c.endpoint %></td>
          <td><strong><%= c.total.toFixed(4) %></strong> Pz</td>
          <td style="font-size:11px;color:#888"><%= new Date(c.timestamp).toLocaleString('es-ES') %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>

<!-- Facturas pendientes -->
<% if (facturasPendientes.length > 0) { %>
<div class="info-card mt-16">
  <div class="section-header">
    <h4>⚠️ Facturas Pendientes</h4>
    <a href="/rsp/facturacion" class="btn-link">Ver todas →</a>
  </div>
  <div class="table-container" style="border:none;border-radius:0">
    <table>
      <thead><tr><th>Factura</th><th>Entidad</th><th>Conexiones</th><th>Total</th><th>Emitida</th></tr></thead>
      <tbody>
        <% facturasPendientes.forEach(f => { %>
        <tr>
          <td class="id-cell"><%= f.id %></td>
          <td><span class="badge badge-purple"><%= f.entidad %></span></td>
          <td><%= f.detalle.consultas %> cons + <%= f.detalle.modificaciones %> mod</td>
          <td><strong style="color:var(--go)"><%= f.detalle.total.toFixed(2) %></strong> Pz</td>
          <td style="font-size:11px;color:#888"><%= new Date(f.emitida).toLocaleString('es-ES') %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

<!-- Info normativa -->
<div class="info-card mt-16">
  <h4>📜 Resumen Normativo — RSP</h4>
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:10px">
    <div style="padding:12px;background:#f6f3ff;border-radius:10px">
      <strong style="color:var(--p);font-size:12px">💰 Transferencia Inicial</strong>
      <p style="font-size:11px;color:#666;margin-top:3px">18,309.83 Pz transferidos desde "Red del Grupo de La Placeta"</p>
    </div>
    <div style="padding:12px;background:#f6f3ff;border-radius:10px">
      <strong style="color:var(--p);font-size:12px">🚫 Facturas Anuladas</strong>
      <p style="font-size:11px;color:#666;margin-top:3px">Facturas pendientes por cambios bancarios quedan anuladas. Más de 20,000 Pz liberados.</p>
    </div>
    <div style="padding:12px;background:#fff8e6;border-radius:10px;border:1px solid #fcd34d">
      <strong style="color:#92400e;font-size:12px">⚠️ Sanción IVA Pendiente</strong>
      <p style="font-size:11px;color:#666;margin-top:3px">2,461.77 Pz por IVA no abonado a la administración. <a href="/rsp/fondos" class="btn-link">Gestionar →</a></p>
    </div>
    <div style="padding:12px;background:#f6f3ff;border-radius:10px">
      <strong style="color:var(--p);font-size:12px">🏛️ Entidades Conectadas</strong>
      <p style="font-size:11px;color:#666;margin-top:3px">Banco, Tributos, Junta, Administración y entidades públicas de GDLP</p>
    </div>
  </div>
</div>
