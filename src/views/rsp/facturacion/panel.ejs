<!-- ═══ FACTURACIÓN ═══ -->
<div class="rsp-hero" style="background:linear-gradient(135deg,#7a4000 0%,#d97706 100%)">
  <div class="rsp-hero-content">
    <div style="width:80px;height:80px;border-radius:16px;background:rgba(255,255,255,.13);display:flex;align-items:center;justify-content:center;font-size:38px">🧾</div>
    <div>
      <h1 class="rsp-hero-title">Facturas</h1>
      <p class="rsp-hero-sub">Emitidas · Recibidas · Rectificativas · Abonos · IVA · Vencimientos · Pagos · Vinculación con operaciones <span style="opacity:.7">(no confundir con la Facturación RSP de conexiones)</span></p>
      <div class="rsp-hero-stats">
        <span>Total: <strong><%= estado.total %></strong></span>
        <span>Pagadas: <strong><%= estado.pagadas %></strong></span>
        <span>Vencidas: <strong><%= estado.vencidas %></strong></span>
        <span>Facturado: <strong><%= estado.totalFacturado.toLocaleString() %> Pz</strong></span>
        <span>IVA: <strong><%= estado.totalIVA.toLocaleString() %> Pz</strong></span>
      </div>
    </div>
  </div>
</div>

<% if (vencidas && vencidas.length > 0) { %>
<div style="background:#fff8e6;border:1px solid #fcd34d;border-radius:12px;padding:12px 16px;margin:14px 0;font-size:13px">
  ⚠️ <strong><%= vencidas.length %></strong> factura(s) vencida(s) sin pagar: <%= vencidas.map(v => v.id).join(', ') %>
</div>
<% } %>

<div style="display:flex;justify-content:space-between;align-items:center;margin:14px 0;flex-wrap:wrap;gap:10px">
  <div style="display:flex;gap:8px;flex-wrap:wrap">
    <a href="/rsp/facturas" class="btn btn-sm <%= !filtroEstado?'btn-primary':'btn-secondary' %>">Todas</a>
    <% ['emitida','pagada','vencida','rectificada','anulada'].forEach(function(e) { %>
    <a href="/rsp/facturas?estado=<%= e %>" class="btn btn-sm <%= filtroEstado===e?'btn-primary':'btn-secondary' %>"><%= e %></a>
    <% }); %>
  </div>
  <% if (esAdmin) { %>
  <button class="btn btn-primary" onclick="abrirModalFac()">➕ Nueva factura</button>
  <% } %>
</div>

<div class="table-container">
  <table>
    <thead><tr><th>Factura</th><th>Tipo</th><th>Emisor</th><th>Receptor</th><th>Concepto</th><th>Base</th><th>IVA</th><th>Total</th><th>Venc.</th><th>Estado</th><th></th></tr></thead>
    <tbody>
      <% if (!facturas || facturas.length === 0) { %>
      <tr><td colspan="11" style="text-align:center;color:#999;padding:24px">Sin facturas.</td></tr>
      <% } %>
      <% (facturas||[]).forEach(function(f) { %>
      <tr onclick="window.location='/rsp/facturas/<%= f.id %>'" style="cursor:pointer">
        <td style="font-size:11px"><strong><%= f.id %></strong></td>
        <td><span class="badge badge-purple"><%= f.tipo %></span></td>
        <td><%= f.emisor_nombre || f.emisor_eip || '—' %></td>
        <td><%= f.receptor_nombre || f.receptor_eip || '—' %></td>
        <td style="font-size:12px;max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= f.concepto %></td>
        <td><%= (f.base_imponible||0).toLocaleString() %></td>
        <td><%= (f.total_iva||0).toLocaleString() %></td>
        <td style="font-weight:700"><%= (f.total_factura||0).toLocaleString() %></td>
        <td style="font-size:11px"><%= f.vencimiento || '—' %></td>
        <td><span class="badge <%= f.estado==='pagada'?'badge-success':(f.estado==='vencida'?'badge-danger':(f.estado==='anulada'?'badge-outline':'badge-warning')) %>"><%= f.estado %></span></td>
        <td><a href="/rsp/facturas/<%= f.id %>" class="btn btn-sm btn-secondary">Ver</a></td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<!-- MODAL -->
<div id="modalFac" style="display:none;position:fixed;inset:0;background:rgba(10,5,30,.55);z-index:200;align-items:center;justify-content:center">
  <div style="background:#fff;border-radius:16px;max-width:600px;width:92%;max-height:90vh;overflow:auto;padding:24px">
    <h3 style="margin:0 0 16px">➕ Nueva factura</h3>
    <div style="display:grid;gap:10px">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
        <div><label class="form-label">Tipo</label>
          <select id="fac_tipo" class="form-input"><option value="emitida">Emitida</option><option value="recibida">Recibida</option></select>
        </div>
        <div><label class="form-label">Concepto *</label><input id="fac_concepto" class="form-input"></div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
        <div><label class="form-label">Emisor EIP</label><input id="fac_emisor" class="form-input"></div>
        <div><label class="form-label">Receptor EIP</label><input id="fac_receptor" class="form-input"></div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px">
        <div><label class="form-label">Fecha</label><input id="fac_fecha" type="date" class="form-input"></div>
        <div><label class="form-label">Vencimiento</label><input id="fac_venc" type="date" class="form-input"></div>
        <div><label class="form-label">Operación (TRF-)</label><input id="fac_op" class="form-input"></div>
      </div>
      <div><label class="form-label">Líneas (descripción|cantidad|precio|IVA%, una por línea)</label>
        <textarea id="fac_lineas" class="form-input" rows="4" placeholder="Servicio mensual|1|100|12"></textarea>
      </div>
    </div>
    <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:16px">
      <button class="btn btn-secondary" onclick="document.getElementById('modalFac').style.display='none'">Cancelar</button>
      <button class="btn btn-primary" onclick="crearFac()">Crear factura</button>
    </div>
  </div>
</div>

<script>
function abrirModalFac(){ document.getElementById('modalFac').style.display='flex'; }
document.getElementById('modalFac').addEventListener('click', function(e){ if(e.target===this) this.style.display='none'; });
async function crearFac(){
  const lineas = document.getElementById('fac_lineas').value.trim().split('\n').map(l => {
    const [descripcion, cantidad, precioUnitario, ivaPorcentaje] = l.split('|').map(s=>s.trim());
    return descripcion ? { descripcion, cantidad: parseFloat(cantidad)||1, precioUnitario: parseFloat(precioUnitario)||0, ivaPorcentaje: parseFloat(ivaPorcentaje)||12 } : null;
  }).filter(Boolean);
  const payload = {
    tipo: document.getElementById('fac_tipo').value,
    concepto: document.getElementById('fac_concepto').value.trim(),
    emisor_eip: document.getElementById('fac_emisor').value.trim() || null,
    receptor_eip: document.getElementById('fac_receptor').value.trim() || null,
    fecha: document.getElementById('fac_fecha').value || undefined,
    vencimiento: document.getElementById('fac_venc').value || undefined,
    operacion_id: document.getElementById('fac_op').value.trim() || null,
    lineas,
  };
  if(!payload.concepto || !lineas.length){ alert('Concepto y líneas son obligatorios'); return; }
  try {
    const r = await fetch('/rsp/facturas/api/facturas', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload) });
    const j = await r.json();
    if(!j.success) throw new Error(j.error);
    window.location = '/rsp/facturas/' + j.factura.id;
  } catch(e){ alert('Error: ' + e.message); }
}
</script>
