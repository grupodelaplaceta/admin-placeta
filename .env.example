# ── Admin Placeta RSP — variables de entorno ──────────────────────
PORT=3002
NODE_ENV=development
SESSION_SECRET=cambiar
JWT_SECRET=cambiar

# PlacetaID (SSO)
PLACETAID_API_URL=
PLACETAID_AUTH_URL=
PLACETAID_CLIENT_ID=
PLACETAID_CLIENT_SECRET=

# Banco de La Placeta / CRM
BANCO_API_URL=
CRM_BASE_URL=
CRM_READ_KEY=
APP_BASE_URL=http://localhost:3002

# Supabase (REST, service role)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Acceso directo a Postgres (para aplicar migraciones con
#    `node scripts/aplicar-migraciones.mjs`) ────────────────────────
# Opción A: connection string completa (Pooler session)
#   Dashboard → Project Settings → Database → Connection string
# SUPABASE_DB_CONNECTION=postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Opción B: solo la contraseña de la BD (se construye la URL con SUPABASE_URL)
# SUPABASE_DB_PASSWORD=
