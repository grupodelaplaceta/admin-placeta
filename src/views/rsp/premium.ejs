<div class="rsp-hero" style="padding:20px 24px">
  <div class="rsp-hero-content" style="gap:14px">
    <img src="/img/rsp-logo.png" alt="RSP" class="rsp-hero-logo" style="width:52px;height:52px;padding:5px">
    <div>
      <h1 class="rsp-hero-title" style="font-size:18px">💎 Gestión Premium — Academia Placeta Junior</h1>
      <p class="rsp-hero-sub">Precios, subvención, destacadas y licencias vendidas</p>
    </div>
  </div>
</div>

<% if (ok) { %><div class="rsp-card" style="border-color:#00c853;background:#f1fff5;padding:14px">✅ Cambios guardados correctamente.</div><% } %>
<% if (error) { %><div class="rsp-card" style="border-color:#ff1744;background:#fff1f1;padding:14px">⚠️ <%= error %></div><% } %>

<div class="rsp-kpis">
  <div class="rsp-kpi"><div class="rsp-kpi-icon" style="background:rgba(124,58,237,.12)">💎</div><div><div class="rsp-kpi-value"><%= totalLicencias %></div><div class="rsp-kpi-label">Licencias vendidas</div></div></div>
  <div class="rsp-kpi"><div class="rsp-kpi-icon" style="background:rgba(0,200,83,.12)">🤑</div><div><div class="rsp-kpi-value"><%= ingresos %></div><div class="rsp-kpi-label">Ingresos premium (Pz)</div></div></div>
  <div class="rsp-kpi"><div class="rsp-kpi-icon" style="background:rgba(55,2,179,.12)">🧩</div><div><div class="rsp-kpi-value"><%= actividades.length %></div><div class="rsp-kpi-label">Actividades</div></div></div>
</div>

<div class="rsp-section-title">🧩 Actividades (<%= actividades.length %>)</div>
<% if (!actividades.length) { %>
  <div class="rsp-empty"><div class="rsp-empty-icon">🧩</div><h3>Sin actividades</h3><p>Crea actividades desde el Studio (junior.laplaceta.org).</p></div>
<% } else { %>
<div class="rsp-card">
  <div class="rsp-table-wrap">
    <table class="rsp-table">
      <thead><tr><th>Actividad</th><th>Categoría</th><th>Estado</th><th>Precios</th><th>Licencias</th><th>Gestión</th></tr></thead>
      <tbody>
        <% actividades.forEach(function(a) { %>
        <tr>
          <td>
            <strong><%= a.titulo %></strong>
            <div style="font-size:11px;color:#888">
              <%= a.tipo %> · <%= a.autor_nombre || '—' %>
              <% if (a.destacada) { %><span class="badge badge-primary">⭐</span><% } %>
              <% if (a.subvencionada) { %><span class="badge badge-success">🎁</span><% } %>
              <% if (a.publica) { %><span class="badge badge-success">Pública</span><% } else { %><span class="badge badge-danger">Oculta</span><% } %>
            </div>
          </td>
          <td><span class="badge badge-primary"><%= a.categoria %></span></td>
          <td><span class="badge <%= a.estado === 'aprobada' ? 'badge-success' : (a.estado === 'rechazada' ? 'badge-danger' : 'badge-warning') %>"><%= a.estado %></span></td>
          <td style="white-space:nowrap">
            Lic: <strong><%= a.precio_licencia || 0 %></strong> Pz ·
            Int: <strong><%= a.precio_intento || 0 %></strong> Pz<br>
            <span style="font-size:11px;color:#888">Recompensa: <%= a.recompensa || 0 %> Pz</span>
          </td>
          <td><span class="badge badge-info"><%= licenciasPorActividad[a.id] || 0 %></span></td>
          <td>
            <% if (esAdmin) { %>
            <details style="min-width:280px">
              <summary class="rsp-btn rsp-btn-outline" style="display:inline-flex;cursor:pointer;padding:6px 12px">⚙️ Editar</summary>
              <form method="POST" action="/rsp/premium" style="margin-top:10px;border-top:1px dashed #ddd;padding-top:10px">
                <input type="hidden" name="id" value="<%= a.id %>">
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
                  <label style="font-size:11px;color:#666">Precio licencia (Pz)<input name="precio_licencia" type="number" min="0" value="<%= a.precio_licencia || 0 %>" style="width:100%;padding:6px;border:1.5px solid #e0d8f0;border-radius:8px"></label>
                  <label style="font-size:11px;color:#666">Precio intento (Pz)<input name="precio_intento" type="number" min="0" value="<%= a.precio_intento || 0 %>" style="width:100%;padding:6px;border:1.5px solid #e0d8f0;border-radius:8px"></label>
                  <label style="font-size:11px;color:#666">Recompensa (Pz)<input name="recompensa" type="number" min="0" value="<%= a.recompensa || 0 %>" style="width:100%;padding:6px;border:1.5px solid #e0d8f0;border-radius:8px"></label>
                  <div style="display:flex;flex-direction:column;gap:4px;justify-content:center">
                    <label class="check" style="font-size:11px"><input type="checkbox" name="subvencionada" <%= a.subvencionada ? 'checked' : '' %>> 🎁 Subvencionada</label>
                    <label class="check" style="font-size:11px"><input type="checkbox" name="destacada" <%= a.destacada ? 'checked' : '' %>> ⭐ Destacada</label>
                    <label class="check" style="font-size:11px"><input type="checkbox" name="publica" <%= a.publica ? 'checked' : '' %>> 🌍 Pública</label>
                  </div>
                </div>
                <button class="rsp-btn rsp-btn-primary" style="margin-top:10px">💾 Guardar</button>
              </form>
            </details>
            <% } else { %>—<% } %>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>
<% } %>
