<!-- ═══ INCIDENCIAS ═══ -->
<div class="rsp-hero" style="background:linear-gradient(135deg,#7a2e00 0%,#e65100 100%)">
  <div class="rsp-hero-content">
    <div style="width:80px;height:80px;border-radius:16px;background:rgba(255,255,255,.13);display:flex;align-items:center;justify-content:center;font-size:38px">⚠️</div>
    <div>
      <h1 class="rsp-hero-title">Incidencias Globales</h1>
      <p class="rsp-hero-sub">INC-<%= new Date().getFullYear() %>-000001 · Todas las incidencias del ecosistema en un solo lugar</p>
      <div class="rsp-hero-stats">
        <span>Abiertas: <strong><%= estado.abiertas %></strong></span>
        <span>Críticas: <strong><%= estado.criticas %></strong></span>
        <span>Resueltas: <strong><%= estado.resueltas %></strong></span>
        <span>Total: <strong><%= estado.total %></strong></span>
      </div>
    </div>
  </div>
</div>

<div style="display:flex;justify-content:space-between;align-items:center;margin:14px 0;flex-wrap:wrap;gap:10px">
  <div style="display:flex;gap:8px;flex-wrap:wrap">
    <a href="/rsp/incidencias" class="btn btn-sm <%= !filtroEstado?'btn-primary':'btn-secondary' %>">Todas</a>
    <% ESTADOS_INC.forEach(function(e) { %>
    <a href="/rsp/incidencias?estado=<%= e %>" class="btn btn-sm <%= filtroEstado===e?'btn-primary':'btn-secondary' %>"><%= e %></a>
    <% }); %>
  </div>
  <% if (esAdmin) { %>
  <button class="btn btn-primary" onclick="abrirModalInc()">➕ Nueva incidencia</button>
  <% } %>
</div>

<div class="table-container">
  <table>
    <thead><tr><th>Incidencia</th><th>Título</th><th>Origen</th><th>Gravedad</th><th>Usuario</th><th>Responsable</th><th>Estado</th><th></th></tr></thead>
    <tbody>
      <% if (!incidencias || incidencias.length === 0) { %>
      <tr><td colspan="8" style="text-align:center;color:#999;padding:28px">No hay incidencias.</td></tr>
      <% } %>
      <% (incidencias||[]).forEach(function(i) { %>
      <tr onclick="window.location='/rsp/incidencias/<%= i.id %>'" style="cursor:pointer">
        <td><strong><%= i.id %></strong></td>
        <td><%= i.titulo %></td>
        <td><span class="badge badge-purple"><%= i.origen %></span></td>
        <td><span class="badge <%= i.gravedad==='critica'?'badge-danger':(i.gravedad==='alta'?'badge-warning':(i.gravedad==='baja'?'badge-info':'badge-outline')) %>"><%= i.gravedad %></span></td>
        <td><%= i.usuario_dip || '—' %></td>
        <td><%= i.responsable_nombre || i.responsable_dip || '—' %></td>
        <td><span class="badge <%= i.estado==='abierta'?'badge-danger':(i.estado==='resuelta'?'badge-success':(i.estado==='cerrada'?'badge-outline':'badge-warning')) %>"><%= i.estado %></span></td>
        <td><a href="/rsp/incidencias/<%= i.id %>" class="btn btn-sm btn-secondary">Ver</a></td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<div id="modalInc" style="display:none;position:fixed;inset:0;background:rgba(10,5,30,.55);z-index:200;align-items:center;justify-content:center">
  <div style="background:#fff;border-radius:16px;max-width:560px;width:92%;max-height:90vh;overflow:auto;padding:24px">
    <h3 style="margin:0 0 16px">➕ Nueva incidencia</h3>
    <div style="display:grid;gap:12px">
      <div><label class="form-label">Título *</label><input id="inc_titulo" class="form-input" placeholder="Descripción breve del problema"></div>
      <div><label class="form-label">Descripción</label><textarea id="inc_descripcion" class="form-input" rows="3"></textarea></div>
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px">
        <div><label class="form-label">Origen</label>
          <select id="inc_origen" class="form-input"><% ORIGENES_INC.forEach(function(o){ %><option value="<%= o %>"><%= o %></option><% }); %></select>
        </div>
        <div><label class="form-label">Gravedad</label>
          <select id="inc_gravedad" class="form-input"><option value="baja">Baja</option><option value="media" selected>Media</option><option value="alta">Alta</option><option value="critica">Crítica</option></select>
        </div>
        <div><label class="form-label">Usuario (DIP)</label><input id="inc_dip" class="form-input" placeholder="23749931M"></div>
      </div>
    </div>
    <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:18px">
      <button class="btn btn-secondary" onclick="document.getElementById('modalInc').style.display='none'">Cancelar</button>
      <button class="btn btn-primary" onclick="crearInc()">Abrir incidencia</button>
    </div>
  </div>
</div>

<script>
function abrirModalInc(){ document.getElementById('modalInc').style.display='flex'; }
document.getElementById('modalInc').addEventListener('click', function(e){ if(e.target===this) this.style.display='none'; });
async function crearInc(){
  const payload = {
    titulo: document.getElementById('inc_titulo').value.trim(),
    descripcion: document.getElementById('inc_descripcion').value.trim(),
    origen: document.getElementById('inc_origen').value,
    gravedad: document.getElementById('inc_gravedad').value,
    usuario_dip: document.getElementById('inc_dip').value.trim() || null,
  };
  if(!payload.titulo){ alert('El título es obligatorio'); return; }
  try {
    const r = await fetch('/rsp/incidencias/api/incidencias', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload) });
    const j = await r.json();
    if(!j.success) throw new Error(j.error);
    window.location = '/rsp/incidencias/' + j.incidencia.id;
  } catch(e){ alert('Error: ' + e.message); }
}
</script>
