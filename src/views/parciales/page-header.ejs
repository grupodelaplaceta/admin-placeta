<%# PARTIAL page-header. Uso: include('parciales/page-header', { titulo, enlaceVolver, acciones }) — acciones HTML opcional %>
<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;flex-wrap:wrap;gap:10px">
  <div>
    <% if (typeof enlaceVolver !== 'undefined' && enlaceVolver) { %>
    <a href="<%= enlaceVolver %>" class="btn btn-sm btn-ghost">← Volver</a>
    <% } %>
  </div>
  <div style="display:flex;gap:8px;flex-wrap:wrap">
    <%- typeof acciones !== 'undefined' && acciones ? acciones : '' %>
  </div>
</div>
