<div class="junior-section">
  <div style="background:linear-gradient(135deg,#880e4f,#e91e63);color:#fff;border-radius:16px;padding:24px 28px;margin-bottom:16px">
    <div style="display:flex;align-items:center;gap:16px;flex-wrap:wrap">
      <div style="width:64px;height:64px;background:rgba(255,255,255,.15);border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:32px">👶</div>
      <div>
        <h4 style="font-size:20px;font-weight:700">Gestión de Menores</h4>
        <p style="font-size:13px;opacity:.7"><%= menores.length %> menor<%= menores.length !== 1 ? 'es' : '' %> registrado<%= menores.length !== 1 ? 's' : '' %></p>
      </div>
    </div>
  </div>

  <% if (menores.length === 0) { %>
  <div class="info-card mb-16" style="text-align:center;padding:40px">
    <div style="font-size:48px;margin-bottom:12px">👶</div>
    <h3 style="font-size:16px;margin-bottom:8px;color:#333">Sin menores registrados</h3>
    <p style="font-size:13px;color:#888;margin-bottom:16px">Los menores vinculados a tu PlacetaID aparecerán aquí.</p>
    <p style="font-size:12px;color:#aaa">Para añadir un menor, usa la app Placeta Junior o contacta con la Junta.</p>
  </div>
  <% } else { %>
  <div class="stats-grid mb-16">
    <div class="stat-card"><div class="stat-value"><%= menores.length %></div><div class="stat-label">Menores</div></div>
    <div class="stat-card"><div class="stat-value"><%= autorizaciones.filter(a => a.estado === 'pendiente').length %></div><div class="stat-label">Autorizaciones pendientes</div></div>
  </div>

  <div style="display:grid;gap:12px">
    <% menores.forEach(m => { %>
    <div class="entidad-card" style="border-left:4px solid #e91e63">
      <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap">
        <div style="width:44px;height:44px;background:#fce4ec;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:20px">👶</div>
        <div style="flex:1;min-width:160px">
          <h4 style="font-size:14px;margin:0"><%= m.nombre || 'Menor' %> <%= m.apellidos || '' %></h4>
          <p style="font-size:11px;color:#888;margin:2px 0 0">
            DIP: <%= m.dip || '—' %> · 
            <% if (m.edad !== undefined) { %><%= m.edad %> años · <% } %>
            Cuenta: <%= m.cuenta_banco || '—' %>
          </p>
        </div>
        <div style="display:flex;gap:6px">
          <% const autPend = autorizaciones.filter(a => a.menorId === m.id && a.estado === 'pendiente'); %>
          <% if (autPend.length > 0) { %>
          <span class="badge badge-warning"><%= autPend.length %> pendiente<%= autPend.length !== 1 ? 's' : '' %></span>
          <% } %>
        </div>
      </div>
    </div>
    <% }); %>
  </div>
  <% } %>
</div>
