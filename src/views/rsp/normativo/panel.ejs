<!-- ═══ HEADER CNIC ═══ -->
<div class="rsp-hero" style="background:linear-gradient(135deg,#1f0070 0%,#3702b3 60%,#6a2be0 100%)">
  <div class="rsp-hero-content">
    <div style="width:80px;height:80px;border-radius:16px;background:rgba(255,255,255,.13);display:flex;align-items:center;justify-content:center;font-size:38px">📜</div>
    <div>
      <h1 class="rsp-hero-title">Centro Normativo — Motor CNIC</h1>
      <p class="rsp-hero-sub">Código Normativo Interno Complementario · Reglas versionadas · Vigentes: <strong><%= estado.vigentes.length %></strong></p>
      <div class="rsp-hero-stats">
        <% ESTADOS_CNIC.forEach(function(e) { %>
        <span><%= e %>: <strong><%= estado.porEstado[e] || 0 %></strong></span>
        <% }); %>
      </div>
    </div>
  </div>
</div>

<!-- ═══ KPIs ═══ -->
<div class="rsp-kpis">
  <div class="rsp-kpi">
    <div class="rsp-kpi-icon" style="background:rgba(55,2,179,.12)">📜</div>
    <div><div class="rsp-kpi-value"><%= reglas.length %></div><div class="rsp-kpi-label">Reglas totales</div></div>
  </div>
  <div class="rsp-kpi">
    <div class="rsp-kpi-icon" style="background:rgba(0,200,83,.12)">✅</div>
    <div><div class="rsp-kpi-value"><%= estado.vigentes.length %></div><div class="rsp-kpi-label">Vigentes</div></div>
  </div>
  <div class="rsp-kpi">
    <div class="rsp-kpi-icon" style="background:rgba(255,109,0,.12)">⏳</div>
    <div><div class="rsp-kpi-value"><%= (estado.porEstado.programado||0)+(estado.porEstado.aprobado||0) %></div><div class="rsp-kpi-label">Programadas/Aprobadas</div></div>
  </div>
  <div class="rsp-kpi">
    <div class="rsp-kpi-icon" style="background:rgba(41,121,255,.12)">✏️</div>
    <div><div class="rsp-kpi-value"><%= (estado.porEstado.borrador||0)+(estado.porEstado.validacion||0) %></div><div class="rsp-kpi-label">Borradores</div></div>
  </div>
</div>

<div style="display:flex;justify-content:flex-end;gap:8px;margin-bottom:14px">
  <% if (esAdmin) { %>
  <button class="btn btn-primary" onclick="abrirModalCrearCNIC()">➕ Nueva regla</button>
  <% } %>
</div>

<div class="table-container">
  <table>
    <thead>
      <tr>
        <th>Código</th>
        <th>Nombre</th>
        <th>Tipo</th>
        <th>Valor</th>
        <th>V</th>
        <th>Estado</th>
        <th>Vigencia</th>
        <th>Sistemas</th>
        <th>Crítica</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% if (!reglas || reglas.length === 0) { %>
      <tr><td colspan="10" style="text-align:center;color:#999;padding:28px">Aún no hay reglas CNIC. Crea la primera para empezar el código normativo.</td></tr>
      <% } %>
      <% (reglas||[]).forEach(function(r) { %>
      <tr onclick="window.location='/rsp/normativo/<%= r.id %>'" style="cursor:pointer">
        <td><strong><%= r.codigo %></strong></td>
        <td><%= r.nombre %></td>
        <td><span class="badge badge-purple"><%= r.tipo %></span></td>
        <td><%= r.valor && r.valor.valor !== undefined ? r.valor.valor + (r.valor.unidad ? ' ' + r.valor.unidad : '') : '—' %></td>
        <td>v<%= r.version %></td>
        <td>
          <% var bClass = {borrador:'badge-outline',validacion:'badge-info',aprobado:'badge-success',programado:'badge-warning',vigente:'badge-success',historico:'badge-outline'}[r.estado] || 'badge-outline'; %>
          <span class="badge <%= bClass %>"><%= r.estado %></span>
        </td>
        <td style="font-size:11px">
          <% if (r.fecha_entrada_vigor) { %><%= r.fecha_entrada_vigor.slice(0,10) %> <% } else { %>—<% } %>
          <% if (r.fecha_fin_vigor) { %>→ <%= r.fecha_fin_vigor.slice(0,10) %><% } %>
        </td>
        <td><%= (r.sistemas_afectados||[]).join(', ') || '—' %></td>
        <td><%= r.critica ? '🔒' : '' %></td>
        <td style="white-space:nowrap;text-align:right">
          <a href="/rsp/normativo/<%= r.id %>" class="btn btn-sm btn-secondary">Ver</a>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<!-- ═══ MODAL CREAR CNIC ═══ -->
<div id="modalCNIC" style="display:none;position:fixed;inset:0;background:rgba(10,5,30,.55);z-index:200;align-items:center;justify-content:center">
  <div style="background:#fff;border-radius:16px;max-width:640px;width:92%;max-height:90vh;overflow:auto;padding:24px">
    <h3 style="margin:0 0 4px">➕ Nueva regla CNIC</h3>
    <p style="color:#888;font-size:12px;margin:0 0 16px">Si el código ya existe, se creará una nueva versión (la vigente queda como histórica).</p>
    <div style="display:grid;gap:12px">
      <div>
        <label class="form-label">Código</label>
        <input id="cnic_codigo" class="form-input" placeholder="CNIC-FISC-001" value="CNIC-FISC-">
      </div>
      <div>
        <label class="form-label">Nombre</label>
        <input id="cnic_nombre" class="form-input" placeholder="Bonificación fiscal Junior">
      </div>
      <div>
        <label class="form-label">Descripción</label>
        <textarea id="cnic_descripcion" class="form-input" rows="2"></textarea>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px">
        <div>
          <label class="form-label">Tipo</label>
          <select id="cnic_tipo" class="form-input">
            <% Object.keys(TIPOS_CNIC).forEach(function(t) { %>
            <option value="<%= t %>"><%= TIPOS_CNIC[t].label %></option>
            <% }); %>
          </select>
        </div>
        <div>
          <label class="form-label">Valor (tipo)</label>
          <select id="cnic_valor_tipo" class="form-input">
            <option value="porcentaje">Porcentaje</option>
            <option value="importe">Importe (Pz)</option>
            <option value="texto">Texto</option>
          </select>
        </div>
        <div>
          <label class="form-label">Valor</label>
          <input id="cnic_valor" class="form-input" placeholder="80">
        </div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
        <div>
          <label class="form-label">Entrada en vigor</label>
          <input id="cnic_fecha_inicio" type="date" class="form-input">
        </div>
        <div>
          <label class="form-label">Fin de vigor</label>
          <input id="cnic_fecha_fin" type="date" class="form-input">
        </div>
      </div>
      <div>
        <label class="form-label">Notas de cambio</label>
        <input id="cnic_notas" class="form-input" placeholder="Motivo de la regla / cambio">
      </div>
      <label style="display:flex;align-items:center;gap:8px;font-size:13px">
        <input type="checkbox" id="cnic_critica"> Regla crítica (requiere doble aprobación: Administrador 1 → Administrador 2)
      </label>
    </div>
    <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:18px">
      <button class="btn btn-secondary" onclick="cerrarModalCNIC()">Cancelar</button>
      <button class="btn btn-primary" onclick="crearCNIC()">Crear regla</button>
    </div>
  </div>
</div>

<script>
function abrirModalCrearCNIC(){ document.getElementById('modalCNIC').style.display='flex'; }
function cerrarModalCNIC(){ document.getElementById('modalCNIC').style.display='none'; }
document.getElementById('modalCNIC').addEventListener('click', function(e){ if(e.target===this) cerrarModalCNIC(); });

async function crearCNIC(){
  const tipo = document.getElementById('cnic_tipo').value;
  const valorTipo = document.getElementById('cnic_valor_tipo').value;
  const valor = document.getElementById('cnic_valor').value;
  const payload = {
    codigo: document.getElementById('cnic_codigo').value.trim(),
    nombre: document.getElementById('cnic_nombre').value.trim(),
    descripcion: document.getElementById('cnic_descripcion').value.trim(),
    tipo,
    valor: { tipo: valorTipo, valor: valorTipo==='porcentaje'||valorTipo==='importe' ? Number(valor) : valor, unidad: valorTipo==='porcentaje' ? '%' : (valorTipo==='importe' ? 'Pz' : '') },
    fecha_entrada_vigor: document.getElementById('cnic_fecha_inicio').value || null,
    fecha_fin_vigor: document.getElementById('cnic_fecha_fin').value || null,
    notas_cambio: document.getElementById('cnic_notas').value,
    critica: document.getElementById('cnic_critica').checked
  };
  if(!payload.codigo || !payload.nombre){ alert('Código y nombre son obligatorios'); return; }
  try {
    const r = await fetch('/rsp/normativo/api/cnic', {
      method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload)
    });
    const j = await r.json();
    if(!j.success) throw new Error(j.error);
    alert('✅ Regla creada: ' + j.regla.codigo + ' v' + j.regla.version);
    window.location = '/rsp/normativo/' + j.regla.id;
  } catch(e){ alert('Error: ' + e.message); }
}
</script>
