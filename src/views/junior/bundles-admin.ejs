<div class="info-card mb-16">
  <h4>🧺 Gestión de Bundles — Placeta Junior</h4>
  <p>Crea paquetes de actividades (Code, Matemáticas, Navidad…) y asígnales actividades. Los juniors los desbloquean con Placetas.</p>
</div>

<% if (ok) { %><div class="info-card mb-16" style="border-color:#00c853;background:#f1fff5">✅ Cambios guardados.</div><% } %>
<% if (error) { %><div class="info-card mb-16" style="border-color:#ff1744;background:#fff1f1">⚠️ <%= error %></div><% } %>

<h4 style="margin:16px 0 10px;">➕ Nuevo Bundle</h4>
<form method="POST" action="/junior/bundles/crear" style="border:1px dashed #ccc;padding:14px;border-radius:12px;margin-bottom:20px;">
  <div class="form-row-3">
    <input name="nombre" placeholder="Nombre del bundle (ej: Placeta Junior Code)" required style="padding:8px;border:1px solid #ccc;border-radius:8px;">
    <input name="descripcion" placeholder="Descripción corta" style="padding:8px;border:1px solid #ccc;border-radius:8px;">
    <input name="precio" type="number" min="0" placeholder="Precio (Pz)" value="0" style="padding:8px;border:1px solid #ccc;border-radius:8px;">
  </div>
  <div class="form-row-3" style="margin-top:8px;">
    <input name="imagen_url" placeholder="URL imagen (opcional)" style="padding:8px;border:1px solid #ccc;border-radius:8px;">
    <label class="check" style="align-self:center"><input type="checkbox" name="activo" checked> Activo</label>
    <button class="btn btn-primary">➕ Crear Bundle</button>
  </div>
</form>

<h4 style="margin:16px 0 10px;">🧺 Bundles (<%= bundles.length %>)</h4>
<% if (!bundles.length) { %>
  <div class="info-card"><p>No hay bundles todavía. Crea el primero arriba.</p></div>
<% } %>

<div class="grid-2">
<% bundles.forEach(function(b) { %>
  <div class="info-card">
    <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:10px;">
      <div>
        <strong><%= b.nombre %></strong>
        <div class="meta" style="margin-top:4px;">
          <span class="badge badge-primary"><%= b.precio || 0 %> <%= b.moneda || 'Pz' %></span>
          <% if (b.activo) { %><span class="badge badge-success">Activo</span><% } else { %><span class="badge badge-danger">Inactivo</span><% } %>
        </div>
        <% if (b.descripcion) { %><p style="font-size:12px;color:#666;margin-top:6px;"><%= b.descripcion %></p><% } %>
      </div>
    </div>

    <details style="margin-top:12px;">
      <summary class="btn btn-sm" style="display:inline-flex;cursor:pointer;">⚙️ Gestionar</summary>
      <div style="margin-top:10px;border-top:1px dashed #ddd;padding-top:12px;">
        <h5 style="margin-bottom:6px;">✏️ Editar</h5>
        <form method="POST" action="/junior/bundles/editar/<%= b.id %>">
          <input name="nombre" type="text" value="<%= b.nombre %>" style="width:100%;padding:8px;border:1px solid #ccc;border-radius:8px;">
          <textarea name="descripcion" rows="2" style="width:100%;margin-top:6px;padding:8px;border:1px solid #ccc;border-radius:8px;"><%= b.descripcion || '' %></textarea>
          <div class="form-row-3" style="margin-top:6px;">
            <input name="precio" type="number" min="0" value="<%= b.precio || 0 %>" style="padding:8px;border:1px solid #ccc;border-radius:8px;">
            <input name="imagen_url" type="text" value="<%= b.imagen_url || '' %>" placeholder="URL imagen" style="padding:8px;border:1px solid #ccc;border-radius:8px;">
            <label class="check" style="align-self:center"><input type="checkbox" name="activo" <%= b.activo ? 'checked' : '' %>> Activo</label>
          </div>
          <button class="btn btn-secondary" style="margin-top:8px;">💾 Guardar bundle</button>
        </form>

        <h5 style="margin:14px 0 6px;">🧩 Actividades del bundle</h5>
        <form method="POST" action="/junior/bundles/items/<%= b.id %>">
          <p style="font-size:11px;color:#888;margin:0 0 6px;">Marca las actividades que pertenecen a este bundle (pueden pertenecer a varios).</p>
          <div style="max-height:220px;overflow:auto;border:1px solid #eee;border-radius:8px;padding:8px;">
            <% if (!actividades.length) { %><p style="font-size:12px;color:#888;">No hay actividades creadas todavía.</p><% } %>
            <% actividades.forEach(function(a) { %>
              <label style="display:flex;align-items:center;gap:6px;padding:4px 0;font-size:13px;cursor:pointer;">
                <input type="checkbox" name="actividad_ids" value="<%= a.id %>" <%= (itemsPorBundle[b.id] || []).includes(a.id) ? 'checked' : '' %>>
                <%= a.titulo %> <span class="badge" style="font-size:10px;"><%= a.categoria %></span>
              </label>
            <% }); %>
          </div>
          <button class="btn btn-secondary" style="margin-top:8px;">💾 Guardar actividades</button>
        </form>

        <div style="margin-top:12px;">
          <button class="btn btn-danger" onclick="eliminarBundle('<%= b.id %>', '<%= b.nombre.replace(/'/g, '') %>')">🗑️ Eliminar</button>
        </div>
      </div>
    </details>
  </div>
<% }); %>
</div>

<style>
  .grid-2 { display:grid; grid-template-columns:repeat(auto-fill,minmax(min(340px,100%),1fr)); gap:14px; }
  .form-row-3 { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; }
  @media(max-width:600px){ .grid-2{grid-template-columns:1fr} .form-row-3{grid-template-columns:1fr} }
  .form-row-3 input { box-sizing:border-box; }
  .check { display:flex; align-items:center; gap:4px; font-size:12px; }
  .btn-sm { padding:4px 10px; font-size:12px; }
</style>

<script>
  async function eliminarBundle(id, nombre) {
    if (!confirm('¿Eliminar el bundle "' + nombre + '"? Se quitará a todos los usuarios.')) return;
    const r = await fetch('/junior/bundles/eliminar/' + id, { method: 'POST' }).then(r => r.json()).catch(() => ({}));
    alert(r.mensaje || r.error || 'Listo');
    if (r.success) setTimeout(() => window.location.reload(), 700);
  }
</script>
