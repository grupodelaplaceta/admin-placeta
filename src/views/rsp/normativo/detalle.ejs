<!-- ═══ DETALLE REGLA CNIC ═══ -->
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;flex-wrap:wrap;gap:10px">
  <div>
    <a href="/rsp/normativo" class="btn btn-sm btn-ghost">← Centro Normativo</a>
  </div>
  <div style="display:flex;gap:8px">
    <% if (esAdmin && ['borrador','validacion'].includes(regla.estado)) { %>
    <button class="btn btn-sm btn-secondary" onclick="nuevaVersion()">➕ Nueva versión</button>
    <% } %>
    <% if (esAdmin && ['borrador','validacion'].includes(regla.estado)) { %>
    <button class="btn btn-sm btn-outline" onclick="editarRegla()">✏️ Editar</button>
    <% } %>
    <button class="btn btn-sm btn-info" style="background:#eef2ff;color:#3b82f6;border-color:#c7d8fe" onclick="simular()">🔮 Simular cambio</button>
  </div>
</div>

<div class="rsp-hero" style="background:linear-gradient(135deg,#1f0070 0%,#3702b3 60%,#6a2be0 100%)">
  <div class="rsp-hero-content">
    <div style="width:80px;height:80px;border-radius:16px;background:rgba(255,255,255,.13);display:flex;align-items:center;justify-content:center;font-size:38px">📜</div>
    <div style="flex:1">
      <div class="rsp-hero-title"><%= regla.codigo %> <span style="font-size:14px;opacity:.7">v<%= regla.version %></span></div>
      <div class="rsp-hero-sub" style="font-size:17px;opacity:.95"><%= regla.nombre %></div>
      <div class="rsp-hero-stats">
        <span>Estado: <strong><%= regla.estado %></strong></span>
        <span>Tipo: <strong><%= regla.tipo %></strong></span>
        <span><%= regla.critica ? '🔒 Crítica (doble aprobación)' : 'No crítica' %></span>
        <span>Valor: <strong><%= regla.valor && regla.valor.valor !== undefined ? regla.valor.valor + (regla.valor.unidad?' '+regla.valor.unidad:'') : '—' %></strong></span>
      </div>
    </div>
  </div>
</div>

<!-- ═══ WORKFLOW ═══ -->
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:8px;margin:14px 0">
  <% var estados = ['borrador','validacion','aprobado','programado','vigente','historico']; %>
  <% estados.forEach(function(e, i) { %>
  <div style="text-align:center;padding:10px 6px;border-radius:12px;background:<%= regla.estado===e ? 'linear-gradient(135deg,#3702b3,#6a2be0)' : '#f4f0ff' %>;color:<%= regla.estado===e?'#fff':'#5a4a7a' %>;font-weight:700;font-size:11px;text-transform:uppercase">
    <%= e %>
  </div>
  <% }); %>
</div>

<% if (esAdmin) { %>
<div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px">
  <% var siguientes = {borrador:['validacion'], validacion:['aprobado','borrador'], aprobado:['programado','vigente','borrador'], programado:['vigente','borrador'], vigente:['historico'], historico:[]}[regla.estado] || []; %>
  <% siguientes.forEach(function(s) { %>
  <button class="btn btn-sm <%= s==='vigente'?'btn-success':(s==='aprobado'?'btn-primary':'btn-secondary') %>" onclick="cambiarEstado('<%= s %>')">→ <%= s %></button>
  <% }); %>
</div>
<% } %>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px">
  <div class="table-container">
    <div style="padding:12px 16px;font-weight:700;font-size:13px;border-bottom:1px solid #e8e4f0">📋 Datos de la regla</div>
    <table>
      <tbody>
        <tr><th style="width:180px">Código</th><td><%= regla.codigo %></td></tr>
        <tr><th>Versión</th><td>v<%= regla.version %></td></tr>
        <tr><th>Descripción</th><td><%= regla.descripcion || '—' %></td></tr>
        <tr><th>Valor</th><td><%= regla.valor && regla.valor.valor !== undefined ? regla.valor.valor + (regla.valor.unidad?' '+regla.valor.unidad:'') : JSON.stringify(regla.valor) %></td></tr>
        <tr><th>Entrada en vigor</th><td><%= regla.fecha_entrada_vigor ? regla.fecha_entrada_vigor.slice(0,10) : '—' %></td></tr>
        <tr><th>Fin de vigor</th><td><%= regla.fecha_fin_vigor ? regla.fecha_fin_vigor.slice(0,10) : '—' %></td></tr>
        <tr><th>Sistemas afectados</th><td><%= (regla.sistemas_afectados||[]).join(', ') || '—' %></td></tr>
        <tr><th>Proponente (Admin 1)</th><td><%= regla.proponente_dip ? regla.proponente_dip : '—' %></td></tr>
        <tr><th>Aprobador (Admin 2)</th><td><%= regla.aprobador_dip ? regla.aprobador_dip + (regla.aprobador_nombre?' ('+regla.aprobador_nombre+')':'') : '—' %></td></tr>
        <tr><th>Autor</th><td><%= regla.autor_nombre ? regla.autor_nombre + (regla.autor_dip?' ('+regla.autor_dip+')':'') : '—' %></td></tr>
        <tr><th>Notas de cambio</th><td><%= regla.notas_cambio || '—' %></td></tr>
      </tbody>
    </table>
  </div>

  <div>
    <div class="table-container" style="margin-bottom:16px">
      <div style="padding:12px 16px;font-weight:700;font-size:13px;border-bottom:1px solid #e8e4f0">🧬 Historial de versiones</div>
      <table>
        <thead><tr><th>Versión</th><th>Estado</th><th>Vigencia</th><th></th></tr></thead>
        <tbody>
          <% (versiones||[]).forEach(function(v) { %>
          <tr onclick="window.location='/rsp/normativo/<%= v.id %>'" style="cursor:pointer">
            <td><strong>v<%= v.version %></strong></td>
            <td><span class="badge <%= v.estado==='vigente'?'badge-success':(v.estado==='historico'?'badge-outline':'badge-info') %>"><%= v.estado %></span></td>
            <td style="font-size:11px"><%= v.fecha_entrada_vigor ? v.fecha_entrada_vigor.slice(0,10) : '—' %></td>
            <td><%= v.id===regla.id ? '◀ actual' : '' %></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <div class="table-container">
      <div style="padding:12px 16px;font-weight:700;font-size:13px;border-bottom:1px solid #e8e4f0">🕘 Historial de acciones</div>
      <table>
        <thead><tr><th>Fecha</th><th>Acción</th><th>Autor</th><th>Motivo</th></tr></thead>
        <tbody>
          <% (regla.historial||[]).slice().reverse().forEach(function(h) { %>
          <tr>
            <td style="font-size:11px"><%= h.fecha ? h.fecha.slice(0,16).replace('T',' ') : '—' %></td>
            <td><span class="badge badge-purple"><%= h.estado || h.accion %></span></td>
            <td><%= h.autor || h.dip || '—' %></td>
            <td style="font-size:12px"><%= h.motivo || '—' %></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- ═══ RESULTADO SIMULACIÓN ═══ -->
<div id="resultadoSimulacion" style="display:none;background:#f6f3ff;border:1px solid #d8ccff;border-radius:14px;padding:18px;margin-bottom:16px">
  <h3 style="margin:0 0 12px">🔮 Resultado de la simulación de cambio</h3>
  <div id="simulacionContenido"></div>
</div>

<script>
function cambiarEstado(estado){
  const motivo = prompt('Motivo del cambio a "' + estado + '":');
  if(motivo === null) return;
  fetch('/rsp/normativo/api/cnic/<%= regla.id %>/estado', {
    method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ estado, motivo })
  }).then(r=>r.json()).then(j=>{
    if(!j.success){ alert('Error: ' + j.error); return; }
    alert('✅ Estado actualizado a: ' + j.regla.estado);
    window.location.reload();
  }).catch(e=>alert('Error: ' + e.message));
}
function nuevaVersion(){
  const motivo = prompt('Motivo de la nueva versión:');
  if(motivo === null) return;
  fetch('/rsp/normativo/api/cnic/<%= regla.codigo %>/nueva-version', {
    method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ notas_cambio: motivo })
  }).then(r=>r.json()).then(j=>{
    if(!j.success){ alert('Error: ' + j.error); return; }
    alert('✅ Nueva versión creada: v' + j.regla.version);
    window.location = '/rsp/normativo/' + j.regla.id;
  }).catch(e=>alert('Error: ' + e.message));
}
async function simular(){
  try {
    const r = await fetch('/rsp/normativo/api/cnic/<%= regla.id %>/simular', {
      method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({})
    });
    const j = await r.json();
    if(!j.success){ alert('Error: ' + j.error); return; }
    let html = '<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:10px">';
    html += '<div class="stat-card"><span class="stat-value">' + (j.serviciosAfectados||[]).length + '</span><span class="stat-label">Servicios</span></div>';
    html += '<div class="stat-card"><span class="stat-value">' + (j.usuariosAfectados||[]).length + '</span><span class="stat-label">Usuarios</span></div>';
    html += '<div class="stat-card"><span class="stat-value">' + (j.numOperacionesAfectadas||0) + '</span><span class="stat-label">Operaciones</span></div>';
    html += '<div class="stat-card"><span class="stat-value">' + (j.numDeclaracionesAfectadas||0) + '</span><span class="stat-label">Declaraciones</span></div>';
    html += '<div class="stat-card"><span class="stat-value">' + (j.importeEstimadoCambio||0).toLocaleString() + ' Pz</span><span class="stat-label">Importe estimado</span></div>';
    html += '</div>';
    html += '<div style="margin-top:10px;font-size:13px;color:#555">Servicios afectados: <strong>' + ((j.serviciosAfectados||[]).join(', ') || 'ninguno') + '</strong></div>';
    if(j.reglaAnterior) html += '<div style="margin-top:6px;font-size:12px;color:#888">Versión anterior: v' + j.reglaAnterior.version + ' (valor: ' + (j.reglaAnterior.valor?.valor ?? '—') + ')</div>';
    document.getElementById('simulacionContenido').innerHTML = html;
    document.getElementById('resultadoSimulacion').style.display = 'block';
  } catch(e){ alert('Error: ' + e.message); }
}
function editarRegla(){
  const nombre = prompt('Nombre:', '<%= regla.nombre %>');
  if(nombre === null) return;
  const notas = prompt('Notas de cambio:', '');
  fetch('/rsp/normativo/api/cnic/<%= regla.id %>', {
    method:'PUT', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ nombre, notas_cambio: notas })
  }).then(r=>r.json()).then(j=>{
    if(!j.success){ alert('Error: ' + j.error); return; }
    window.location.reload();
  }).catch(e=>alert('Error: ' + e.message));
}
</script>
