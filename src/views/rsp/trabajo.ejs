<!-- ═══ BANDEJA DE TRABAJO (ADMIN) (Vivid) ═══ -->
<div class="v-page">
  <div class="v-page-header">
    <div>
      <h1 class="v-title">📥 Trabajo pendiente</h1>
      <p class="v-sub">Expedientes que requieren tu acción, sin entrar en 15 módulos distintos.</p>
    </div>
    <div class="v-page-actions">
      <a class="btn-accent" href="/rsp/tramites"><span class="ms" style="font-size:17px">list</span> Ver todos los trámites</a>
    </div>
  </div>

  <div class="v-bento">
    <div class="v-stat v-col-4 v-stat--error">
      <div class="v-stat-head"><span class="v-stat-label">Urgentes</span><span class="v-stat-ico ms">priority_high</span></div>
      <div class="v-stat-value"><%= trabajo.urgentes %></div>
      <div class="v-stat-meta"><span class="ms" style="font-size:15px">warning</span> prioridad alta</div>
    </div>
    <div class="v-stat v-col-4 v-stat--warning">
      <div class="v-stat-head"><span class="v-stat-label">Pendientes</span><span class="v-stat-ico ms">pending_actions</span></div>
      <div class="v-stat-value"><%= trabajo.pendientes %></div>
      <div class="v-stat-meta"><span class="ms" style="font-size:15px">schedule</span> requieren revisión</div>
    </div>
    <div class="v-stat v-col-4 v-stat--indigo">
      <div class="v-stat-head"><span class="v-stat-label">En proceso</span><span class="v-stat-ico ms">sync</span></div>
      <div class="v-stat-value"><%= trabajo.enProceso %></div>
      <div class="v-stat-meta"><span class="ms" style="font-size:15px">swap_calls</span> trámites activos</div>
    </div>
  </div>

  <div class="v-card">
    <div class="v-card-head">
      <div><div class="v-card-title">Bandeja de trabajo</div><div class="v-card-sub">Acciones de administración pendientes</div></div>
    </div>
    <div style="overflow-x:auto">
      <table class="v-table">
        <thead><tr><th>Expediente</th><th>Tipo</th><th>Interesado</th><th>Estado</th><th>Acción</th><th class="v-cell-right">Prioridad</th><th class="v-cell-right">Abrir</th></tr></thead>
        <tbody>
          <% if (!trabajo.items || trabajo.items.length === 0) { %>
          <tr><td colspan="7" style="text-align:center;color:var(--tq);padding:34px">
            <div style="font-size:38px;margin-bottom:8px">✅</div>Sin trabajo pendiente. Todo al día.
          </td></tr>
          <% } %>
          <% trabajo.items.forEach(function(x) { %>
          <% var t = x.tramite; var cfg = TRAMITES[t.tipo] || {}; %>
          <tr style="cursor:pointer" onclick="location='/rsp/tramites/<%= t.id %>'">
            <td>
              <div class="v-entity-name"><%= t.titulo %></div>
              <div class="v-entity-id"><%= t.id %></div>
            </td>
            <td><span class="v-chip"><%= cfg.icono %> <%= cfg.nombre %></span></td>
            <td style="font-size:13px"><%= t.solicitante_nombre || t.solicitante_dip || '—' %></td>
            <td><span class="v-status" style="color:<%= x.color %>"><span class="ms" style="font-size:15px"><%= x.label === 'En revisión' ? 'manage_search' : (x.color === '#fbbf24' ? 'schedule' : 'sync') %></span> <%= x.label %></span></td>
            <td style="font-size:12px;color:var(--tm)"><%= x.accion ? x.accion.label : t.siguiente_accion %></td>
            <td class="v-cell-right">
              <% var venc = t.fecha_limite && new Date(t.fecha_limite) < new Date(); %>
              <% if (venc && t.estado !== 'cerrado' && t.estado !== 'rechazado') { %><span class="v-chip v-chip--error"><span class="ms" style="font-size:13px">warning</span> Vencido</span><% } %>
              <% if (t.prioridad === 'alta') { %><span class="v-chip v-chip--error"><span class="ms" style="font-size:13px">priority_high</span> Alta</span><% } else { %><span class="v-chip">Normal</span><% } %>
            </td>
            <td class="v-cell-right"><a class="btn-accent" style="padding:6px 12px;font-size:12px" href="/rsp/tramites/<%= t.id %>">ABRIR</a></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>
