<%# Formulario de nuevo documento %>
<div class="nuevo-doc-page">
  <div class="flex items-center justify-between mb-16">
    <h3 style="font-size:16px;font-weight:700">📝 Nuevo Documento</h3>
    <a href="/<%= entidad_actual %>/documentos" class="btn btn-secondary btn-sm">← Volver</a>
  </div>

  <form id="form-nuevo-doc" onsubmit="return crearDocumento(event)" class="info-card">
    <div class="mb-16">
      <label>Tipo de Documento</label>
      <select class="form-input" name="tipo" id="sel-tipo" required>
        <option value="">Selecciona un tipo...</option>
        <% categorias.forEach(function(cat) { %>
        <optgroup label="<%= cat %>">
          <% tipos.filter(t => t.categoria === cat).forEach(function(t) { %>
          <option value="<%= t.tipo %>"><%= t.etiqueta %></option>
          <% }); %>
        </optgroup>
        <% }); %>
      </select>
    </div>

    <div class="mb-16">
      <label>Título del Documento</label>
      <input class="form-input" name="titulo" id="titulo" placeholder="Título descriptivo" required>
    </div>

    <div class="mb-16">
      <label>DIP del Firmante</label>
      <input class="form-input" name="dipFirma" id="dipFirma" placeholder="11111111D" 
             value="<%= usuario?.dip || '' %>">
      <span style="font-size:11px;color:#888">Dejar vacío para firmar con tu DIP</span>
    </div>

    <div class="mb-16">
      <label>Datos Adicionales (JSON)</label>
      <textarea class="form-input" name="datosJson" id="datosJson" rows="4"
        placeholder='{"titular": "Nombre", "iban": "GDLP-AP98-605", ...}'></textarea>
    </div>

    <hr style="border:none;border-top:1px solid #e8e4f0;margin:16px 0">

    <div class="flex gap-8">
      <button type="submit" class="btn btn-primary">📄 Crear y Enviar a Firma</button>
      <button type="reset" class="btn btn-secondary" onclick="return confirm('¿Descartar?')">Descartar</button>
    </div>
    <p style="font-size:11px;color:#888;margin-top:8px">
      💡 El documento se enviará automáticamente a PlacetaID Móvil para su firma electrónica.
    </p>
  </form>
</div>

<script>
async function crearDocumento(event) {
  event.preventDefault();
  const form = event.target;
  const data = {
    tipo: form.tipo.value,
    titulo: form.titulo.value,
    dipFirma: form.dipFirma.value || form.dipFirma.placeholder,
    datos: {}
  };

  // Parsear JSON adicional si se proporcionó
  const jsonStr = form.datosJson.value.trim();
  if (jsonStr) {
    try { data.datos = JSON.parse(jsonStr); } 
    catch (e) { mostrarToast('❌ JSON inválido en "Datos Adicionales"', 'error'); return false; }
  }

  mostrarToast('📄 Creando documento...', 'info');
  try {
    const r = await apiFetch('/<%= entidad_actual %>/documentos', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    });

    if (r.success) {
      mostrarToast(`✅ ${r.mensaje || 'Documento creado'}`, 'success');
      setTimeout(() => { window.location.href = '/<%= entidad_actual %>/documentos/' + r.documento.id; }, 1000);
    } else {
      mostrarToast('❌ ' + (r.error || 'Error desconocido'), 'error');
    }
  } catch (e) {
    mostrarToast('❌ ' + e.message, 'error');
  }
  return false;
}
</script>
