<div class="rsp-hero" style="padding:20px 24px">
  <div class="rsp-hero-content" style="gap:14px">
    <img src="/img/rsp-logo.png" alt="RSP" class="rsp-hero-logo" style="width:52px;height:52px;padding:5px">
    <div>
      <h1 class="rsp-hero-title" style="font-size:18px">⚙️ Configuración Económica — RSP</h1>
      <p class="rsp-hero-sub">Tablas de canje de puntos en caliente (se guardan en Supabase <code>rsp_config</code>)</p>
    </div>
  </div>
</div>

<% if (ok) { %><div class="rsp-card" style="border-color:#00c853;background:#f1fff5;padding:14px">✅ Configuración guardada. La app la usa al instante.</div><% } %>
<% if (error) { %><div class="rsp-card" style="border-color:#ff1744;background:#fff1f1;padding:14px">⚠️ <%= error %></div><% } %>

<div class="rsp-kpis">
  <div class="rsp-kpi"><div class="rsp-kpi-icon" style="background:rgba(55,2,179,.12)">🧾</div><div><div class="rsp-kpi-value"><%= iva %>%</div><div class="rsp-kpi-label">IVA</div></div></div>
  <div class="rsp-kpi"><div class="rsp-kpi-icon" style="background:rgba(0,200,83,.12)">🟢</div><div><div class="rsp-kpi-value"><%= canjeV.length %></div><div class="rsp-kpi-label">Tramos verdes</div></div></div>
  <div class="rsp-kpi"><div class="rsp-kpi-icon" style="background:rgba(255,23,68,.12)">🔴</div><div><div class="rsp-kpi-value"><%= canjeR.length %></div><div class="rsp-kpi-label">Tramos rojos</div></div></div>
</div>

<form method="POST" action="/junior/config">
  <!-- Canje verdes -->
  <div class="rsp-section-title">🟢 Canje de Puntos Verdes → Placetas</div>
  <div class="rsp-card">
    <div class="rsp-table-wrap">
      <table class="rsp-table">
        <thead><tr><th>Tramo</th><th>Puntos verdes</th><th>Placetas</th></tr></thead>
        <tbody>
          <% canjeV.forEach(function(t, i) { %>
          <tr>
            <td>Tramo <%= i + 1 %></td>
            <td><input name="v_puntos_<%= i %>" type="number" min="1" value="<%= t.puntos_verdes %>" style="width:120px;padding:6px;border:1.5px solid #e0d8f0;border-radius:8px"></td>
            <td><input name="v_placetas_<%= i %>" type="number" min="0" value="<%= t.placetas %>" style="width:120px;padding:6px;border:1.5px solid #e0d8f0;border-radius:8px"></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Canje rojos -->
  <div class="rsp-section-title">🔴 Canje de Puntos Rojos → Placetas</div>
  <div class="rsp-card">
    <div class="rsp-table-wrap">
      <table class="rsp-table">
        <thead><tr><th>Tramo</th><th>Puntos rojos</th><th>Placetas</th></tr></thead>
        <tbody>
          <% canjeR.forEach(function(t, i) { %>
          <tr>
            <td>Tramo <%= i + 1 %></td>
            <td><input name="r_puntos_<%= i %>" type="number" min="1" value="<%= t.puntos_rojos %>" style="width:120px;padding:6px;border:1.5px solid #e0d8f0;border-radius:8px"></td>
            <td><input name="r_placetas_<%= i %>" type="number" min="0" value="<%= t.placetas %>" style="width:120px;padding:6px;border:1.5px solid #e0d8f0;border-radius:8px"></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <div style="padding:12px">
      <button class="rsp-btn rsp-btn-primary">💾 Guardar tablas de canje</button>
    </div>
  </div>
</form>

<!-- Recompensas (informativo) -->
<div class="rsp-section-title">🎁 Recompensas por complejidad (informativo)</div>
<div class="rsp-card">
  <div style="padding:12px;display:flex;gap:10px;flex-wrap:wrap">
    <% Object.entries(recompensas).forEach(function([k, v]) { %>
      <span class="badge badge-info"><%= k %>: <strong><%= v %> Pz</strong></span>
    <% }); %>
  </div>
</div>
