<% if (sinConexion) { %>
<div class="info-card mb-16" style="border-left:4px solid var(--danger,#e53935)">
  <h4>⚠️ Sin conexión con el backend del banco</h4>
  <p style="font-size:13px;color:var(--text-light)">No se pudieron leer los tickets de soporte.</p>
</div>
<% } %>

<div class="info-card mb-16" style="background:linear-gradient(135deg,#f3f0ff,#fbfaff);border:1px solid #ddd4f2">
  <h4 style="margin:0">🎧 Soporte del Banco</h4>
  <p style="font-size:12px;color:var(--text-light);margin:4px 0 0">Responde las consultas que los usuarios abren desde la app. La respuesta se sincroniza al instante en la app del cliente.</p>
</div>

<% if (tickets.length === 0) { %>
  <div class="info-card"><p style="font-size:13px;color:var(--text-light);margin:0">No hay tickets de soporte.</p></div>
<% } else { %>
<div class="info-card" style="padding:0;overflow:hidden">
  <div style="overflow-x:auto">
    <table class="table" style="width:100%;border-collapse:collapse;font-size:13px">
      <thead>
        <tr style="text-align:left;color:var(--text-light);border-bottom:1px solid #e7e0f2">
          <th style="padding:10px 12px">Ticket</th>
          <th style="padding:10px 12px">Cliente</th>
          <th style="padding:10px 12px">Categoría</th>
          <th style="padding:10px 12px">Estado</th>
          <th style="padding:10px 12px">Fecha</th>
          <th style="padding:10px 12px"></th>
        </tr>
      </thead>
      <tbody>
        <% tickets.forEach(function(t){ %>
        <tr style="border-bottom:1px solid #f0ebf7;cursor:pointer" onclick="toggle('<%= t.id %>')">
          <td style="padding:10px 12px"><strong><%= t.subject %></strong><div style="color:var(--text-light);font-size:11px"><%= t.message ? t.message.slice(0,60) + (t.message.length>60?'…':'') : '' %></div></td>
          <td style="padding:10px 12px"><%= t.name %><div style="color:var(--text-light);font-size:11px"><%= t.dip %></div></td>
          <td style="padding:10px 12px"><span class="badge" style="background:#eef2ff;color:#3b82f6"><%= t.category %></span></td>
          <td style="padding:10px 12px"><span class="badge" style="background:<%= t.status === 'Abierto' ? '#fff8e6' : '#e6f7ed' %>;color:<%= t.status === 'Abierto' ? '#a16207' : '#1a7a4a' %>"><%= t.status %></span></td>
          <td style="padding:10px 12px;white-space:nowrap" data-fecha="<%= t.createdAt %>">—</td>
          <td style="padding:10px 12px"><button class="btn-sm btn-secondary" onclick="event.stopPropagation();toggle('<%= t.id %>')">💬 <%= t.responses.length %></button></td>
        </tr>
        <tr id="det-<%= t.id %>" style="display:none;background:#faf8ff">
          <td colspan="6" style="padding:14px 16px">
            <div class="info-card" style="background:#fff;margin:0"><p style="margin:0;white-space:pre-wrap;font-size:13px"><%= t.message %></p></div>
            <% t.responses.forEach(function(r){ %>
            <div style="font-size:12px;background:#eef2ff;border-radius:10px;padding:8px 12px;margin-top:6px">
              <strong style="color:#3b82f6">RSP · <%= r.adminDip || 'Admin' %></strong>
              <p style="margin:2px 0 0;white-space:pre-wrap"><%= r.text %></p>
            </div>
            <% }); %>
            <div class="flex gap-8" style="margin-top:10px;align-items:center">
              <input type="text" id="resp-<%= t.id %>" class="form-input" placeholder="Escribe tu respuesta…" style="flex:1">
              <button class="btn-primary" onclick="responder('<%= t.id %>')">Responder</button>
            </div>
            <span id="msg-<%= t.id %>" style="font-size:12px;font-weight:600"></span>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

<script>
  document.querySelectorAll('[data-fecha]').forEach(function(el){
    var iso = el.getAttribute('data-fecha');
    try { el.textContent = new Date(iso).toLocaleString('es-ES',{day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'}); } catch(e){}
  });
  function toggle(id){
    var det = document.getElementById('det-' + id);
    det.style.display = det.style.display === 'none' ? 'table-row' : 'none';
  }
  async function responder(ticketId){
    const input = document.getElementById('resp-' + ticketId);
    const msg = document.getElementById('msg-' + ticketId);
    const texto = (input.value||'').trim();
    if(!texto){ msg.textContent='Escribe una respuesta primero'; msg.style.color='#b82929'; return; }
    msg.textContent='Enviando…'; msg.style.color='#6c5878';
    const res = await fetch('/rsp/api/banco/responder-soporte', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ ticketId, respuesta: texto })
    });
    const data = await res.json().catch(()=>({}));
    if(res.ok && data.success){ msg.textContent='✅ Respondido'; msg.style.color='#1a7a4a'; setTimeout(()=>location.reload(),900); }
    else { msg.textContent='❌ '+(data.error||'Error'); msg.style.color='#b82929'; }
  }
</script>
