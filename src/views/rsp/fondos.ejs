<div class="rsp-hero" style="padding:20px 24px">
  <div class="rsp-hero-content" style="gap:14px">
    <img src="/img/rsp-logo.png" alt="RSP" class="rsp-hero-logo" style="width:56px;height:56px;padding:6px">
    <div>
      <h1 class="rsp-hero-title" style="font-size:20px">💰 Gestión de Fondos RSP</h1>
      <p class="rsp-hero-sub"><strong>GDLP-AP64-583</strong> · Fondos, sanciones y pagos vía Banco de La Placeta</p>
    </div>
  </div>
</div>

<!-- KPIs -->
<div class="rsp-kpis">
  <div class="rsp-kpi">
    <div class="rsp-kpi-icon" style="background:rgba(55,2,179,.12)">💰</div>
    <div><div class="rsp-kpi-value" style="font-size:22px"><%= fondos.saldo.toFixed(2) %></div><div class="rsp-kpi-label">Saldo Actual (Pz)</div></div>
  </div>
  <div class="rsp-kpi">
    <div class="rsp-kpi-icon" style="background:rgba(0,200,83,.12)">📈</div>
    <div><div class="rsp-kpi-value"><%= fondos.totalIngresos.toFixed(2) %></div><div class="rsp-kpi-label">Total Ingresos</div></div>
  </div>
  <div class="rsp-kpi">
    <div class="rsp-kpi-icon" style="background:rgba(255,23,68,.12)">📉</div>
    <div><div class="rsp-kpi-value"><%= fondos.totalEgresos.toFixed(2) %></div><div class="rsp-kpi-label">Total Egresos</div></div>
  </div>
  <div class="rsp-kpi">
    <div class="rsp-kpi-icon" style="background:rgba(41,121,255,.12)">⚡</div>
    <div><div class="rsp-kpi-value"><%= stats.conexionesEsteMes %></div><div class="rsp-kpi-label">Conexiones del Mes</div></div>
  </div>
  <div class="rsp-kpi">
    <div class="rsp-kpi-icon" style="background:rgba(55,2,179,.12)">💰</div>
    <div><div class="rsp-kpi-value"><%= stats.ingresosEsteMes.toFixed(3) %></div><div class="rsp-kpi-label">Ingresos del Mes</div></div>
  </div>
  <div class="rsp-kpi">
    <div class="rsp-kpi-icon" style="background:<%= fondos.sancionPagada ? 'rgba(0,200,83,.12)' : 'rgba(255,23,68,.12)' %>">
      <%= fondos.sancionPagada ? '✅' : '⚠️' %>
    </div>
    <div>
      <div class="rsp-kpi-value" style="color:<%= fondos.sancionPagada ? '#00c853' : '#d03131' %>">
        <%= fondos.sancionPagada ? 'Pagada' : fondos.sancionPendiente.toFixed(2) %>
      </div>
      <div class="rsp-kpi-label">Sanción IVA</div>
    </div>
  </div>
</div>

<!-- Info Bancaria -->
<div class="rsp-card">
  <div class="rsp-card-header">🏦 Pagos vía Banco de La Placeta</div>
  <div style="padding:16px 20px">
    <p style="font-size:12px;color:#888;margin-bottom:12px">Todos los cobros se procesan a través del Banco real:</p>
    <div class="rsp-info-grid">
      <div class="rsp-info-card"><strong>💰 Base servicios</strong><p>→ RSP (GDLP-AP64-583)</p></div>
      <div class="rsp-info-card"><strong>📊 IVA (12%)</strong><p>→ Tributos TGLP (GDLP-AP98-605)</p></div>
      <div class="rsp-info-card"><strong>⚖️ Sanciones</strong><p>→ Administración (GDLP-AP27-062)</p></div>
    </div>
  </div>
</div>

<!-- Sanción IVA -->
<% if (!fondos.sancionPagada) { %>
<div class="rsp-alert <%= fondos.saldo >= fondos.sancionPendiente ? 'rsp-alert-warning' : 'rsp-alert-error' %>">
  <span>
    <strong>⚠️ Sanción por IVA no abonado:</strong> <strong style="color:#d03131"><%= fondos.sancionPendiente.toFixed(2) %> Pz</strong>
    — IVA no transferido a la administración.
    <%= fondos.saldo >= fondos.sancionPendiente ? '✅ Fondos suficientes.' : '❌ Fondos insuficientes.' %>
  </span>
  <% if (esAdmin && fondos.saldo >= fondos.sancionPendiente) { %>
  <button class="rsp-action-btn rsp-action-pagar rsp-btn-sm" onclick="pagarSancion()">💸 Pagar Sanción</button>
  <% } %>
</div>
<% } else { %>
<div class="rsp-alert rsp-alert-success">✅ Sanción de IVA pagada. 2,461.77 Pz saldados.</div>
<% } %>

<!-- Resumen -->
<div class="rsp-card">
  <div class="rsp-card-header">📋 Resumen de Fondos</div>
  <div style="padding:16px 20px">
    <div class="rsp-info-grid">
      <div class="rsp-info-card" style="background:#f0ecff">
        <strong>💰 Fondos Iniciales</strong>
        <p style="font-size:16px;font-weight:800;color:#3702b3;margin-top:4px"><%= fondos.fondosIniciales.toFixed(2) %> Pz</p>
        <p style="font-size:10px;color:#999">Transferidos desde "Red del Grupo de La Placeta"</p>
      </div>
      <div class="rsp-info-card" style="background:#e6f7ed">
        <strong>📈 Ingresos por Conexiones</strong>
        <p style="font-size:16px;font-weight:800;color:#00c853;margin-top:4px"><%= (fondos.totalIngresos - fondos.fondosIniciales).toFixed(2) %> Pz</p>
        <p style="font-size:10px;color:#999">Acumulado de conexiones de entidades</p>
      </div>
      <div class="rsp-info-card" style="background:#ffebee">
        <strong>📉 Total Egresos</strong>
        <p style="font-size:16px;font-weight:800;color:#d03131;margin-top:4px"><%= fondos.totalEgresos.toFixed(2) %> Pz</p>
        <p style="font-size:10px;color:#999">Facturas pagadas y sanciones</p>
      </div>
    </div>
  </div>
</div>
    <div style="padding:12px;background:linear-gradient(135deg,#f0eeff,#f0fdf4);border-radius:10px">
      <p style="font-size:11px;color:#888">Saldo Neto</p>
      <p style="font-size:22px;font-weight:800;color:var(--p)"><%= fondos.saldo.toFixed(2) %> Pz</p>
    </div>
  </div>
</div>

<!-- Historial de transacciones -->
<div class="info-card">
  <div class="section-header">
    <h4>📜 Historial de Transacciones</h4>
  </div>

  <% if (fondos.historial.length === 0) { %>
  <div class="empty-state" style="padding:24px">
    <div class="empty-icon" style="font-size:32px">💰</div>
    <h3 style="font-size:15px">Sin historial</h3>
    <p style="font-size:12px">No hay transacciones registradas.</p>
  </div>
  <% } else { %>
  <div class="table-container" style="border:none;border-radius:0">
    <table>
      <thead>
        <tr>
          <th>Tipo</th>
          <th>Concepto</th>
          <th>Importe</th>
          <th>Saldo</th>
          <th>Fecha</th>
        </tr>
      </thead>
      <tbody>
        <% [...fondos.historial].reverse().forEach(h => { %>
        <tr>
          <td>
            <span class="badge <%= 
              h.tipo === 'TRANSFERENCIA_INICIAL' ? 'badge-gold' :
              h.tipo === 'CONEXION' ? 'badge-info' :
              h.tipo === 'PAGO_FACTURA' ? 'badge-success' :
              h.tipo === 'SANCION_IVA' ? 'badge-danger' : 'badge-outline'
            %>"><%= h.tipo %></span>
          </td>
          <td style="font-size:12px;max-width:300px"><%= h.concepto %></td>
          <td style="font-weight:600;color:<%= h.importe >= 0 ? 'var(--g)' : 'var(--r)' %>">
            <%= h.importe >= 0 ? '+' : '' %><%= h.importe.toFixed(2) %> Pz
          </td>
          <td style="font-weight:600"><%= h.saldo.toFixed(2) %> Pz</td>
          <td style="font-size:11px;color:#888;white-space:nowrap"><%= new Date(h.fecha).toLocaleString('es-ES') %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>

<!-- Tarifas informativas -->
<div class="info-card mt-16">
  <h4>💰 Tarifas de Conexión RSP</h4>
  <div class="grid-2" style="gap:12px">
    <div style="padding:12px;background:#f6f3ff;border-radius:10px">
      <span class="badge badge-info">👁️ Consulta</span>
      <p style="margin-top:6px"><strong>0.001 Pz</strong> + IVA 12%</p>
      <p style="font-size:11px;color:#888">Conexión para consulta de datos</p>
    </div>
    <div style="padding:12px;background:#fff8e6;border-radius:10px">
      <span class="badge badge-warning">✏️ Modificación</span>
      <p style="margin-top:6px"><strong>0.1 Pz</strong> + IVA 12%</p>
      <p style="font-size:11px;color:#888">Conexión para modificación de datos</p>
    </div>
  </div>
</div>

<script>
// ── Pagar Sanción IVA ──────────────────────────────────────────────────
function pagarSancion() {
  mostrarModal('⚠️ Pagar Sanción IVA', `
    <p><strong>Importe:</strong> 2,461.77 Pz</p>
    <p><strong>Concepto:</strong> Sanción por IVA no abonado a la administración — "Red del Grupo de La Placeta"</p>
    <p style="font-size:12px;color:#888;margin-top:8px">Según la normativa aprobada el 3 de marzo de 2025, el IVA de "Red del Grupo de La Placeta" no se abonaba a la administración. Esto es anticonstitucional según los artículos vigentes.</p>
    <hr style="margin:12px 0;border:none;border-top:1px solid #f0ecf8">
    <p style="font-size:13px;color:#666">¿Confirmas el pago de la sanción?</p>
    <div class="flex gap-8" style="margin-top:12px">
      <button class="btn btn-danger" onclick="confirmarPagoSancion()">💸 Pagar 2,461.77 Pz</button>
      <button class="btn btn-secondary" onclick="document.querySelector('.modal-overlay').remove()">Cancelar</button>
    </div>
  `);
}

async function confirmarPagoSancion() {
  try {
    const r = await apiFetch('/rsp/api/fondos/pagar-sancion', { method: 'POST' });
    if (r.success) {
      mostrarToast('✅ Sanción pagada: ' + r.importe.toFixed(2) + ' Pz. Nuevo saldo: ' + r.nuevoSaldo.toFixed(2) + ' Pz', 'success');
      setTimeout(() => location.reload(), 1000);
    } else {
      mostrarToast(r.error || 'Error', 'error');
    }
  } catch (e) { mostrarToast('Error de red', 'error'); }
}
</script>
