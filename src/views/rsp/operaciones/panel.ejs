<!-- ═══ OPERATION ENGINE ═══ -->
<div class="rsp-hero" style="background:linear-gradient(135deg,#0d2137 0%,#1e5a8a 100%)">
  <div class="rsp-hero-content">
    <div style="width:80px;height:80px;border-radius:16px;background:rgba(255,255,255,.13);display:flex;align-items:center;justify-content:center;font-size:38px">⚙️</div>
    <div>
      <h1 class="rsp-hero-title">Operation Engine</h1>
      <p class="rsp-hero-sub">CREACIÓN → IDENTIFICACIÓN → CLASIFICACIÓN → VALIDACIÓN → REGLAS → FISCALIDAD → DOCUMENTACIÓN → EJECUCIÓN → AUDITORÍA</p>
      <div class="rsp-hero-stats">
        <span>Total: <strong><%= estado.total %></strong></span>
        <span>Retenidas: <strong><%= estado.retenidas %></strong></span>
        <span>Rechazadas: <strong><%= estado.rechazadas %></strong></span>
        <span>Ejecutadas: <strong><%= estado.ejecutadas %></strong></span>
      </div>
    </div>
  </div>
</div>

<div style="display:flex;justify-content:space-between;align-items:center;margin:14px 0;flex-wrap:wrap;gap:10px">
  <div style="display:flex;gap:8px;flex-wrap:wrap">
    <a href="/rsp/operaciones" class="btn btn-sm <%= !filtroEstado?'btn-primary':'btn-secondary' %>">Todas</a>
    <% ['retenida','rechazada','validada','ejecutada'].forEach(function(e) { %>
    <a href="/rsp/operaciones?estado_motor=<%= e %>" class="btn btn-sm <%= filtroEstado===e?'btn-primary':'btn-secondary' %>"><%= e %></a>
    <% }); %>
  </div>
  <% if (esAdmin) { %>
  <button class="btn btn-primary" onclick="abrirModalOp()">⚙️ Procesar operación</button>
  <% } %>
</div>

<div class="table-container">
  <table>
    <thead><tr><th>Operación</th><th>Concepto</th><th>Importe</th><th>Clasificación</th><th>Servicio</th><th>Estado motor</th><th>Inconsistencias</th><th></th></tr></thead>
    <tbody>
      <% if (!operaciones || operaciones.length === 0) { %>
      <tr><td colspan="8" style="text-align:center;color:#999;padding:24px">Sin operaciones procesadas. Usa el motor para clasificar y validar operaciones.</td></tr>
      <% } %>
      <% (operaciones||[]).forEach(function(o) { %>
      <tr onclick="window.location='/rsp/operaciones/<%= o.id %>'" style="cursor:pointer">
        <td style="font-size:11px"><strong><%= o.id %></strong></td>
        <td><%= o.concepto %></td>
        <td><strong><%= (o.importe||0).toLocaleString() %> Pz</strong></td>
        <td><span class="badge badge-purple"><%= o.clasificacion %></span></td>
        <td><%= o.servicio %></td>
        <td><span class="badge <%= o.estado_motor==='retenida'?'badge-danger':(o.estado_motor==='rechazada'?'badge-danger':(o.estado_motor==='ejecutada'?'badge-success':'badge-info')) %>"><%= o.estado_motor %></span></td>
        <td><%= (o.inconsistencias||[]).length %> ⚠️</td>
        <td><a href="/rsp/operaciones/<%= o.id %>" class="btn btn-sm btn-secondary">Ver</a></td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<div id="modalOp" style="display:none;position:fixed;inset:0;background:rgba(10,5,30,.55);z-index:200;align-items:center;justify-content:center">
  <div style="background:#fff;border-radius:16px;max-width:560px;width:92%;max-height:90vh;overflow:auto;padding:24px">
    <h3 style="margin:0 0 16px">⚙️ Procesar operación por el motor</h3>
    <div style="display:grid;gap:10px">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
        <div><label class="form-label">Concepto *</label><input id="op_concepto" class="form-input" placeholder="Nómina agosto"></div>
        <div><label class="form-label">Importe (Pz) *</label><input id="op_importe" type="number" class="form-input" value="0"></div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
        <div><label class="form-label">Cuenta origen</label><input id="op_from" class="form-input"></div>
        <div><label class="form-label">Cuenta destino</label><input id="op_to" class="form-input"></div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
        <div><label class="form-label">TRF id (global)</label><input id="op_trf" class="form-input" placeholder="TRF-2026-000001"></div>
        <div><label class="form-label">Periodicidad</label>
          <select id="op_periodicidad" class="form-input"><option value="puntual">Puntual</option><option value="mensual">Mensual</option><option value="semanal">Semanal</option><option value="trimestral">Trimestral</option></select>
        </div>
      </div>
      <div><label class="form-label">Expediente vinculado (EXP-)</label><input id="op_exp" class="form-input" placeholder="EXP-2026-000001"></div>
    </div>
    <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:16px">
      <button class="btn btn-secondary" onclick="document.getElementById('modalOp').style.display='none'">Cancelar</button>
      <button class="btn btn-primary" onclick="procesarOp()">Procesar</button>
    </div>
  </div>
</div>

<script>
function abrirModalOp(){ document.getElementById('modalOp').style.display='flex'; }
document.getElementById('modalOp').addEventListener('click', function(e){ if(e.target===this) this.style.display='none'; });
async function procesarOp(){
  const payload = {
    concepto: document.getElementById('op_concepto').value.trim(),
    importe: parseFloat(document.getElementById('op_importe').value) || 0,
    cuenta_origen: document.getElementById('op_from').value.trim() || null,
    cuenta_destino: document.getElementById('op_to').value.trim() || null,
    trf_id: document.getElementById('op_trf').value.trim() || null,
    periodicidad: document.getElementById('op_periodicidad').value,
    expediente_id: document.getElementById('op_exp').value.trim() || null,
  };
  if(!payload.concepto){ alert('El concepto es obligatorio'); return; }
  try {
    const r = await fetch('/rsp/operaciones/api/operaciones', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload) });
    const j = await r.json();
    if(!j.success) throw new Error(j.error);
    const inco = (j.operacion.inconsistencias||[]).length;
    if(inco > 0){ alert('⚠️ Operación RETENIDA por ' + inco + ' inconsistencia(s):\n' + j.operacion.inconsistencias.map(i=>'• '+i.mensaje).join('\n')); }
    window.location = '/rsp/operaciones/' + j.operacion.id;
  } catch(e){ alert('Error: ' + e.message); }
}
</script>
