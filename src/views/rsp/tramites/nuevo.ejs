<!-- ═══ TRÁMITE — WIZARD (Vivid) ═══ -->
<%
const TIPOS = Object.values(TRAMITES);
const TIPOS_JSON = JSON.stringify(TIPOS.map(c => ({ id: c.id, nombre: c.nombre, icono: c.icono, descripcion: c.descripcion, campos: c.campos || [], documentos: c.documentos || [] })));
%>
<div class="v-page">
  <div class="v-page-header">
    <div>
      <h1 class="v-title">Nuevo trámite</h1>
      <p class="v-sub">Te guiamos paso a paso. Solo preguntamos lo necesario.</p>
    </div>
    <div class="v-page-actions">
      <a class="btn btn-secondary" href="/rsp/tramites"><span class="ms" style="font-size:17px">close</span> Cancelar</a>
    </div>
  </div>

  <!-- Stepper del wizard -->
  <div class="v-card">
    <div class="v-card-body" style="padding:18px 22px">
      <div class="v-stepper" id="wizStepper">
        <div class="v-step active" data-wstep="0"><div class="v-step-dot">1</div><div class="v-step-label">Qué quieres hacer</div></div>
        <div class="v-step" data-wstep="1"><div class="v-step-dot">2</div><div class="v-step-label">Datos</div></div>
        <div class="v-step" data-wstep="2"><div class="v-step-dot">3</div><div class="v-step-label">Documentación</div></div>
        <div class="v-step" data-wstep="3"><div class="v-step-dot">4</div><div class="v-step-label">Revisión y presentar</div></div>
      </div>
    </div>
  </div>

  <!-- PASO 1: Tipo -->
  <div class="wiz-step" id="wiz-0">
    <div class="v-card">
      <div class="v-card-head"><div><div class="v-card-title">¿Qué quieres hacer?</div><div class="v-card-sub">Elige el tipo de trámite para comenzar.</div></div></div>
      <div class="v-card-body" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:12px">
        <% TIPOS.forEach(function(c, i) { %>
        <div class="v-type-card" data-tipo="<%= c.id %>" onclick="seleccionarTipo(this)">
          <span class="v-type-check"><span class="ms" style="font-size:15px">check</span></span>
          <div class="v-type-ico"><%= c.icono %></div>
          <div class="v-type-name"><%= c.nombre %></div>
          <div class="v-type-desc"><%= c.descripcion %></div>
        </div>
        <% }); %>
      </div>
    </div>
  </div>

  <!-- PASO 2: Datos -->
  <div class="wiz-step" id="wiz-1" style="display:none">
    <div class="v-bento" style="grid-template-columns:repeat(12,1fr)">
      <!-- Reuso de datos PlacetaID -->
      <div class="v-card v-col-5">
        <div class="v-card-head"><div><div class="v-card-title">Ciudadano / entidad</div><div class="v-card-sub">Este panel es de admins: busca al interesado del trámite en PlacetaID.</div></div></div>
        <div class="v-card-body">
          <div style="display:flex;gap:8px">
            <input id="dipReuse" class="form-input" placeholder="DIP (23749931M)">
            <button class="btn-accent" onclick="buscarDatos()"><span class="ms" style="font-size:16px">search</span> Buscar</button>
          </div>
          <div id="reuseResult" style="margin-top:12px"></div>
          <button class="btn btn-secondary" style="width:100%;margin-top:10px" onclick="usarDatos()" id="btnUsarDatos" disabled>
            <span class="ms" style="font-size:16px">verified</span> Utilizar estos datos
          </button>
        </div>
      </div>

      <!-- Campos del trámite -->
      <div class="v-card v-col-7">
        <div class="v-card-head"><div><div class="v-card-title" id="datosTitle">Datos de la solicitud</div><div class="v-card-sub">Solo lo necesario para este trámite.</div></div></div>
        <div class="v-card-body" id="camposDatos" style="display:grid;gap:12px"></div>
      </div>
    </div>
  </div>

  <!-- PASO 3: Documentación -->
  <div class="wiz-step" id="wiz-2" style="display:none">
    <div class="v-card">
      <div class="v-card-head"><div><div class="v-card-title">Documentación</div><div class="v-card-sub">Marca los documentos que vas a aportar.</div></div></div>
      <div class="v-card-body" id="docsLista"></div>
    </div>
  </div>

  <!-- PASO 4: Revisión -->
  <div class="wiz-step" id="wiz-3" style="display:none">
    <div class="v-card">
      <div class="v-card-head"><div><div class="v-card-title">Revisión y presentación</div><div class="v-card-sub">Comprueba los datos antes de presentar.</div></div></div>
      <div class="v-card-body">
        <div id="resumenRevisión" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:12px"></div>
      </div>
    </div>
  </div>

  <!-- Barra inferior -->
  <div style="position:sticky;bottom:14px;z-index:80">
    <div class="v-card">
      <div class="v-card-body" style="padding:12px 16px;display:flex;justify-content:space-between;gap:10px;align-items:center">
        <button class="btn btn-secondary" id="wizPrev" onclick="wizardStep(-1)" style="visibility:hidden"><span class="ms" style="font-size:16px">arrow_back</span> Atrás</button>
        <div style="font-family:var(--mono);font-size:11px;color:var(--tq)" id="wizCounter">Paso 1 de 4</div>
        <button class="btn-accent" id="wizNext" onclick="wizardStep(1)">Continuar <span class="ms" style="font-size:16px">arrow_forward</span></button>
        <button class="btn-accent" id="wizPresent" onclick="presentar()" style="display:none"><span class="ms" style="font-size:16px">send</span> Presentar trámite</button>
      </div>
    </div>
  </div>
</div>

<script>
const TIPOS = <%- TIPOS_JSON %>;
let estado = { paso: 0, tipo: null, cfg: null, datos: {}, solicitante_dip: '', solicitante_nombre: '', docs: {} };

function renderStepper() {
  document.querySelectorAll('#wizStepper .v-step').forEach(function (s, i) {
    s.classList.toggle('active', i === estado.paso);
    s.classList.toggle('done', i < estado.paso);
    const dot = s.querySelector('.v-step-dot');
    dot.textContent = i < estado.paso ? '✓' : (i + 1);
  });
}
function seleccionarTipo(el) {
  document.querySelectorAll('.v-type-card').forEach(c => c.classList.remove('selected'));
  el.classList.add('selected');
  estado.tipo = el.dataset.tipo;
  estado.cfg = TIPOS.find(c => c.id === estado.tipo);
  document.getElementById('datosTitle').textContent = estado.cfg.nombre + ' — datos';
  renderCampos();
  renderDocs();
  estado.paso = 1;
  showPaso();
}
function renderCampos() {
  const box = document.getElementById('camposDatos');
  box.innerHTML = '';
  (estado.cfg.campos || []).forEach(function (f) {
    const req = f.obligatorio ? ' *' : '';
    let control = '<input id="f_' + f.key + '" class="form-input" placeholder="' + (f.label || f.key) + '" value="' + (estado.datos[f.key] || '') + '">';
    if (f.tipo === 'number') control = '<input id="f_' + f.key + '" type="number" class="form-input" value="' + (estado.datos[f.key] || 0) + '">';
    if (f.tipo === 'select') control = '<select id="f_' + f.key + '" class="form-input">' + (f.opciones || []).map(o => '<option ' + (estado.datos[f.key] === o ? 'selected' : '') + '>' + o + '</option>').join('') + '</select>';
    box.innerHTML += '<div><label class="form-label">' + (f.label || f.key) + req + '</label>' + control + '</div>';
  });
}
function renderDocs() {
  const box = document.getElementById('docsLista');
  box.innerHTML = '';
  const docs = estado.cfg.documentos || [];
  if (!docs.length) {
    box.innerHTML = '<div style="color:var(--tq);text-align:center;padding:20px">Este trámite no requiere documentación adicional.</div>';
    return;
  }
  docs.forEach(function (d) {
    box.innerHTML += '<label class="v-doc" style="cursor:pointer"><div class="v-doc-ico"><span class="ms">description</span></div>' +
      '<div class="v-doc-name">' + d + '</div>' +
      '<input type="checkbox" style="margin-left:auto;accent-color:#8b5cf6;width:18px;height:18px" class="doc-chk" data-doc="' + d + '" ' + (estado.docs[d] ? 'checked' : '') + '></label>';
  });
  box.querySelectorAll('.doc-chk').forEach(function (chk) {
    chk.addEventListener('change', function () { estado.docs[this.dataset.doc] = this.checked; });
  });
}
async function buscarDatos() {
  const dip = document.getElementById('dipReuse').value.trim().toUpperCase();
  if (!dip) return;
  const r = await fetch('/rsp/tramites/api/ciudadano?dip=' + encodeURIComponent(dip));
  const j = await r.json();
  const box = document.getElementById('reuseResult');
  if (!j.success || !j.ciudadano) { box.innerHTML = '<div class="v-banner v-banner--error"><span class="ms">error</span><div><div class="v-banner-title">No encontrado</div></div></div>'; return; }
  const c = j.ciudadano;
  estado.solicitante_dip = c.dip;
  estado.solicitante_nombre = c.nombre || c.dip;
  box.innerHTML =
    '<div class="v-field"><span class="v-field-label">Hemos encontrado estos datos en PlacetaID</span>' +
    '<span class="v-field-value">' + (c.nombre || c.dip) + '</span></div>' +
    '<div style="display:flex;gap:8px;margin-top:8px;flex-wrap:wrap">' +
    '<span class="v-chip ' + (c.enPlacetaID ? 'v-chip--success' : 'v-chip--warning') + '">' + (c.enPlacetaID ? '✔ PlacetaID' : '· Sin PlacetaID') + '</span>' +
    '<span class="v-chip ' + (c.tieneCuenta ? 'v-chip--success' : 'v-chip--error') + '">' + (c.tieneCuenta ? '✔ Cuenta verificada' : '· Sin cuenta') + '</span>' +
    '<span class="v-chip">' + c.numCuentas + ' cuenta' + (c.numCuentas !== 1 ? 's' : '') + '</span></div>';
  document.getElementById('btnUsarDatos').disabled = false;
}
function usarDatos() {
  if (!estado.solicitante_dip) return;
  if (!document.getElementById('f_solicitante_dip')) {
    const box = document.getElementById('camposDatos');
    box.innerHTML = '<input type="hidden" id="f_solicitante_dip" value="' + estado.solicitante_dip + '">' +
      '<input type="hidden" id="f_solicitante_nombre" value="' + (estado.solicitante_nombre || '') + '">' + box.innerHTML;
  } else {
    document.getElementById('f_solicitante_dip').value = estado.solicitante_dip;
    document.getElementById('f_solicitante_nombre').value = estado.solicitante_nombre || '';
  }
  toast('Datos cargados desde PlacetaID', 'success');
  wizardStep(1);
}
function recogerDatos() {
  estado.datos = {};
  document.querySelectorAll('#camposDatos input, #camposDatos select').forEach(function (el) {
    if (el.id) estado.datos[el.id.replace('f_', '')] = el.value;
  });
  const sd = document.getElementById('f_solicitante_dip');
  if (sd) estado.solicitante_dip = sd.value;
  const sn = document.getElementById('f_solicitante_nombre');
  if (sn) estado.solicitante_nombre = sn.value;
  if (!estado.solicitante_dip) { estado.solicitante_dip = ''; estado.solicitante_nombre = ''; }
}
function showPaso() {
  document.querySelectorAll('.wiz-step').forEach(function (w, i) { w.style.display = i === estado.paso ? '' : 'none'; });
  renderStepper();
  const prev = document.getElementById('wizPrev');
  const next = document.getElementById('wizNext');
  const present = document.getElementById('wizPresent');
  prev.style.visibility = estado.paso === 0 ? 'hidden' : 'visible';
  next.style.display = estado.paso === 3 ? 'none' : '';
  present.style.display = estado.paso === 3 ? '' : 'none';
  document.getElementById('wizCounter').textContent = 'Paso ' + (estado.paso + 1) + ' de 4';
  if (estado.paso === 3) renderResumen();
}
function wizardStep(dir) {
  if (dir === 1) {
    if (estado.paso === 0 && !estado.tipo) { toast('Selecciona un tipo de trámite', 'warning'); return; }
    if (estado.paso === 1) recogerDatos();
  }
  estado.paso = Math.max(0, Math.min(3, estado.paso + dir));
  showPaso();
}
function renderResumen() {
  recogerDatos();
  const box = document.getElementById('resumenRevisión');
  box.innerHTML =
    '<div class="v-field"><span class="v-field-label">Tipo</span><span class="v-field-value">' + estado.cfg.icono + ' ' + estado.cfg.nombre + '</span></div>' +
    '<div class="v-field"><span class="v-field-label">Solicitante</span><span class="v-field-value">' + (estado.solicitante_nombre || estado.solicitante_dip || '—') + '</span></div>' +
    '<div class="v-field"><span class="v-field-label">Documentos</span><span class="v-field-value">' + Object.values(estado.docs).filter(Boolean).length + ' adjuntado' + (Object.values(estado.docs).filter(Boolean).length !== 1 ? 's' : '') + '</span></div>';
  Object.entries(estado.datos).forEach(function (e) {
    if (e[0].startsWith('solicitante_')) return;
    box.innerHTML += '<div class="v-field"><span class="v-field-label">' + e[0].replace(/_/g, ' ') + '</span><span class="v-field-value">' + e[1] + '</span></div>';
  });
}
async function presentar() {
  recogerDatos();
  if (!estado.solicitante_dip) { toast('Reutiliza tus datos de PlacetaID o indica el DIP', 'warning'); wizardStep(-1); return; }
  const documentos = (estado.cfg.documentos || []).map(function (d) {
    return { nombre: d, estado: estado.docs[d] ? 'validado' : 'pendiente' };
  });
  const body = {
    tipo: estado.tipo,
    titulo: estado.cfg.nombre + (estado.solicitante_nombre ? ' — ' + estado.solicitante_nombre : ''),
    solicitante_dip: estado.solicitante_dip,
    solicitante_nombre: estado.solicitante_nombre,
    datos: estado.datos,
    documentos
  };
  const r = await fetch('/rsp/tramites/api/tramites', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
  const j = await r.json();
  if (!j.success) { alert('Error: ' + j.error); return; }
  const id = j.tramite.id;
  const r2 = await fetch('/rsp/tramites/api/tramites/' + id + '/accion', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ accion: 'presentar' }) });
  const j2 = await r2.json();
  if (!j2.success) { location = '/rsp/tramites/' + id; return; }
  toast('Trámite presentado: ' + id, 'success');
  setTimeout(() => { location = '/rsp/tramites/' + id; }, 900);
}
showPaso();
</script>
