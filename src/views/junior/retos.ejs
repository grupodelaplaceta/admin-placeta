<%# Retos semanales Placeta Junior %>
<div class="junior-retos-page">
  <div class="rsp-header-card mb-16 font-jakarta">
    <div style="display:flex;align-items:center;gap:16px;flex-wrap:wrap">
      <img src="/img/rsp-logo.png" alt="RSP" style="width:48px;height:48px;border-radius:10px;background:rgba(255,255,255,.12);padding:5px">
      <div>
        <h4 style="font-size:18px;font-weight:700">🧒 Placeta Junior — Retos Semanales</h4>
        <p style="font-size:12px;opacity:.7">Retos globales distribuidos desde RSP · Semana <%= reto?.semana || '-' %></p>
      </div>
    </div>
  </div>

  <% if (reto) { %>
  <!-- Reto activo -->
  <div class="info-card mb-16" style="border-left:4px solid #e91e63">
    <div class="flex items-center justify-between flex-wrap gap-8">
      <div>
        <h4 style="font-size:16px"><%= reto.icono %> <%= reto.titulo %></h4>
        <p style="font-size:13px;color:#666;margin-top:4px"><%= reto.descripcion %></p>
        <p style="font-size:11px;color:#999;margin-top:4px">
          📅 <%= new Date(reto.fechaInicio).toLocaleDateString('es-ES') %> → <%= new Date(reto.fechaFin).toLocaleDateString('es-ES') %>
          <% if (reto.desdeRSP) { %> · 🌐 Desde RSP<% } %>
        </p>
      </div>
      <span class="badge badge-rsp" style="font-size:11px">🔥 Activo</span>
    </div>
  </div>

  <!-- Juegos -->
  <div style="display:grid;gap:16px">
    <% reto.juegos.forEach(function(juego, idx) { %>
    <div class="info-card">
      <div class="flex items-center justify-between mb-8">
        <h4 style="font-size:15px">
          <% if (juego.tipo === 'relacionar') { %>🔗<% } else if (juego.tipo === 'clasificar') { %>📂<% } else if (juego.tipo === 'sopa') { %>🔤<% } %>
          Juego <%= idx+1 %>: <%= juego.titulo %>
        </h4>
        <span class="badge badge-purple"><%= juego.tipo %></span>
      </div>
      <% if (juego.instrucciones) { %>
      <p style="font-size:12px;color:#888;margin-bottom:10px">📖 <%= juego.instrucciones %></p>
      <% } %>

      <% if (juego.tipo === 'relacionar') { %>
      <!-- JUEGO: Relacionar -->
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
        <div>
          <p style="font-size:11px;font-weight:700;color:#888;margin-bottom:6px;text-align:center">🔵 Concepto</p>
          <% juego.pares.forEach(function(par) { %>
          <div class="rel-item" style="padding:8px 12px;background:#f0ecff;border-radius:8px;margin-bottom:6px;cursor:grab;font-size:13px;text-align:center;border:1px solid #d0c0f0"
               ondragstart="event.dataTransfer.setData('text', this.dataset.match)" draggable="true" data-match="<%= par.derecha %>">
            <%= par.izquierda %>
          </div>
          <% }); ?>
        </div>
        <div>
          <p style="font-size:11px;font-weight:700;color:#888;margin-bottom:6px;text-align:center">🟣 Entidad</p>
          <% juego.pares.sort(() => 0.5 - Math.random()).forEach(function(par) { %>
          <div class="rel-dropzone" style="padding:8px 12px;background:#faf8ff;border-radius:8px;margin-bottom:6px;font-size:13px;text-align:center;border:2px dashed #d0c0f0;min-height:36px"
               ondrop="event.preventDefault();this.textContent=event.dataTransfer.getData('text');this.style.background='#e6f7ed';this.style.borderColor='#22a06b'"
               ondragover="event.preventDefault()">
            <%= par.derecha %>
          </div>
          <% }); %>
        </div>
      </div>

      <% } else if (juego.tipo === 'clasificar') { %>
      <!-- JUEGO: Clasificar -->
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px">
        <% juego.categorias.forEach(function(cat) { %>
        <div style="background:#faf8ff;border-radius:10px;padding:12px;border:1px solid #e8e4f0">
          <p style="font-size:13px;font-weight:700;margin-bottom:8px;text-align:center"><%= cat.nombre %></p>
          <% cat.items.forEach(function(item) { %>
          <div style="padding:6px 10px;background:#fff;border-radius:6px;margin-bottom:4px;font-size:12px;text-align:center;border:1px solid #e8e4f0">
            <%= item %>
          </div>
          <% }); %>
        </div>
        <% }); %>
      </div>

      <% } else if (juego.tipo === 'sopa') { %>
      <!-- JUEGO: Sopa de letras -->
      <div style="display:flex;gap:20px;flex-wrap:wrap;align-items:start">
        <div style="display:grid;grid-template-columns:repeat(<%= juego.letras[0].length %>,36px);gap:3px;background:#f0ecff;padding:10px;border-radius:10px">
          <% juego.letras.forEach(function(fila) { %>
            <% fila.forEach(function(letra) { %>
            <div style="width:36px;height:36px;display:flex;align-items:center;justify-content:center;background:#fff;border-radius:4px;font-weight:700;font-size:14px;font-family:monospace;cursor:pointer;border:1px solid #e0daf0"
                 onclick="this.style.background=this.style.background==='rgb(55, 2, 179)'?'#fff':'#3702b3';this.style.color=this.style.color==='#fff'?'#111':'#fff'">
              <%= letra %>
            </div>
            <% }); %>
          <% }); %>
        </div>
        <div>
          <p style="font-size:11px;font-weight:700;color:#888;margin-bottom:6px">🔍 Palabras a encontrar:</p>
          <% juego.palabras.forEach(function(p) { %>
          <div style="padding:4px 10px;background:#fff;border-radius:6px;margin-bottom:4px;font-size:12px;border:1px solid #e8e4f0">
            <%= p %>
          </div>
          <% }); %>
        </div>
      </div>
      <% } %>

      <!-- Botón completar -->
      <div style="margin-top:12px;text-align:center">
        <button class="btn btn-sm btn-primary" onclick="completarJuego(<%= idx %>)" style="background:#e91e63;border-color:#e91e63">
          ✅ He terminado este juego
        </button>
      </div>
    </div>
    <% }); %>
  </div>

  <% } else { %>
  <!-- Sin reto activo -->
  <div class="empty-state">
    <div class="empty-icon" style="font-size:48px">🧒</div>
    <h3>No hay reto activo esta semana</h3>
    <p>Los retos semanales se publican desde RSP. Vuelve a consultar pronto.</p>
  </div>
  <% } %>
</div>

<style>
.rel-item:hover { background: #e0d8f8 !important; }
@media(max-width:600px) {
  [style*="grid-template-columns:1fr 1fr"] { grid-template-columns: 1fr !important; }
  [style*="grid-template-columns:repeat"] { grid-template-columns: repeat(5, 28px) !important; gap: 2px !important; }
  [style*="width:36px;height:36px"] { width: 28px !important; height: 28px !important; font-size: 11px !important; }
}
</style>

<script>
function completarJuego(idx) {
  mostrarToast('🎉 ¡Juego completado! Sigue así', 'success');
}
</script>
