<!-- ═══ PAGE HEADER (Vivid Infrastructure) ═══ -->
<div class="v-page">
  <div class="v-page-header">
    <div>
      <h1 class="v-title">Red de Servicios de La Placeta</h1>
      <p class="v-sub">Plataforma centralizada de datos e infraestructura</p>
      <div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap">
        <span class="v-chip v-chip--indigo">IBAN GDLP-AP64-583</span>
        <span class="v-chip">💰 Fondos: <%= stats.saldoActual.toFixed(2) %> Pz</span>
        <span class="v-chip">⚡ Conexiones: <%= stats.totalConexiones %></span>
        <span class="v-chip">🗳️ Votaciones: <%= votaciones ? votaciones.total : 0 %></span>
      </div>
    </div>
    <div class="v-page-actions">
      <a class="btn btn-secondary" href="/rsp/conexiones"><span class="ms" style="font-size:17px">download</span> Exportar Log</a>
      <a class="btn btn-secondary" href="/administracion/placetaid/sincronizacion"><span class="ms" style="font-size:17px" data-weight="fill">verified</span> Verificar PlacetaID</a>
      <a class="btn-accent" href="/rsp/conexiones"><span class="ms" style="font-size:17px">add</span> Nueva Conexión</a>
    </div>
  </div>

<!-- ═══ COMMAND CENTER ═══ -->
<div class="rsp-command">
  <div class="rsp-command-search">
    <span class="rsp-command-ico">🔍</span>
    <input type="text" id="rspHeroSearch" placeholder="Buscar ciudadano por DIP, PlacetaID, IBAN, EIP o nombre…" autocomplete="off">
    <span class="rsp-command-hint">↵ Enter para buscar</span>
    <div class="global-search-dd" id="rspHeroSearchDD"></div>
  </div>
  <div class="rsp-command-quick">
    <a href="/rsp/conexiones" class="rsp-command-chip">📡 Conexiones</a>
    <a href="/rsp/facturacion" class="rsp-command-chip">📄 Facturación</a>
    <a href="/rsp/fondos" class="rsp-command-chip">💰 Fondos</a>
    <a href="/rsp/normativo" class="rsp-command-chip">📜 Normativo</a>
    <a href="/rsp/apis" class="rsp-command-chip">🔌 APIs</a>
    <a href="/administracion/placetaid" class="rsp-command-chip">🪪 PlacetaID</a>
    <a href="/administracion/placetaid/sincronizacion" class="rsp-command-chip">🔄 Alta PlacetaID</a>
    <a href="/tributos/declaraciones" class="rsp-command-chip">📄 Declaraciones</a>
  </div>
</div>

<script>
(function () {
  const hero = document.getElementById('rspHeroSearch');
  if (!hero) return;
  let t = null;
  hero.addEventListener('input', function () {
    clearTimeout(t);
    const q = this.value.trim();
    const dd = document.getElementById('rspHeroSearchDD');
    if (q.length < 2) { dd.classList.remove('open'); return; }
    t = setTimeout(function () { buscarCiudadanos(q, 'rspHeroSearchDD'); }, 300);
  });
  hero.addEventListener('keydown', function (ev) {
    if (ev.key === 'Enter') { ev.preventDefault(); buscarCiudadanos(this.value.trim(), 'rspHeroSearchDD'); }
  });
  document.addEventListener('click', function (ev) {
    const box = hero.closest('.rsp-command-search');
    if (!box.contains(ev.target)) document.getElementById('rspHeroSearchDD').classList.remove('open');
  });
})();
</script>

<!-- ═══ BENTO KPIs (Vivid) ═══ -->
<div class="v-bento">
  <div class="v-stat v-col-3 v-stat--violet">
    <div class="v-stat-head"><span class="v-stat-label">Total Conexiones</span><span class="v-stat-ico ms">hub</span></div>
    <div class="v-stat-value"><%= stats.totalConexiones.toLocaleString() %></div>
    <div class="v-stat-meta"><span class="ms" style="font-size:15px">bolt</span> <%= stats.conexionesHoy %> hoy</div>
  </div>
  <div class="v-stat v-col-3 v-stat--indigo">
    <div class="v-stat-head"><span class="v-stat-label">Saldo (Pz)</span><span class="v-stat-ico ms">account_balance_wallet</span></div>
    <div class="v-stat-value"><%= stats.saldoActual.toFixed(2) %></div>
    <div class="v-stat-meta"><span class="ms" style="font-size:15px">savings</span> Fondos disponibles</div>
  </div>
  <div class="v-stat v-col-3 v-stat--success">
    <div class="v-stat-head"><span class="v-stat-label">Ingresos del Mes</span><span class="v-stat-ico ms">trending_up</span></div>
    <div class="v-stat-value"><%= stats.ingresosEsteMes.toFixed(3) %></div>
    <div class="v-stat-meta"><span class="up ms" style="font-size:15px">arrow_upward</span> Flujo entrante</div>
  </div>
  <div class="v-stat v-col-3 v-stat--warning">
    <div class="v-stat-head"><span class="v-stat-label">Facturas</span><span class="v-stat-ico ms">receipt_long</span></div>
    <div class="v-stat-value"><%= stats.facturasEmitidas %></div>
    <div class="v-stat-meta">
      <% if (stats.facturasPendientes > 0) { %><span class="down ms" style="font-size:15px">pending</span> <%= stats.facturasPendientes %> pendientes
      <% } else { %><span class="up ms" style="font-size:15px">check_circle</span> Al corriente<% } %>
    </div>
  </div>
  <% if (votaciones) { %>
  <div class="v-stat v-col-3 v-stat--blue">
    <div class="v-stat-head"><span class="v-stat-label">Votaciones activas</span><span class="v-stat-ico ms">how_to_vote</span></div>
    <div class="v-stat-value"><%= votaciones.activas %></div>
    <div class="v-stat-meta"><span class="ms" style="font-size:15px">group</span> <%= votaciones.total %> en total</div>
  </div>
  <div class="v-stat v-col-3 v-stat--pink">
    <div class="v-stat-head"><span class="v-stat-label">Votos emitidos</span><span class="v-stat-ico ms">how_to_vote</span></div>
    <div class="v-stat-value"><%= votaciones.totalVotos %></div>
    <div class="v-stat-meta"><span class="ms" style="font-size:15px">fact_check</span> Participación PlacetaID</div>
  </div>
  <% } %>
</div>

<!-- ═══ DIRECTORIO DE ENTIDADES (Vivid) ═══ -->
<%
const ENTIDADES_DIR = [
  { nombre:'Banco de La Placeta', id:'GDLP-AP98-605', tipo:'Banco', vol:null, nivel:'N3' },
  { nombre:'Tributos de La Placeta', id:'GDLP-TRBX-001', tipo:'Tributos', vol:null, nivel:'N3' },
  { nombre:'Junta de La Placeta', id:'GDLP-AP00-001', tipo:'Gobierno', vol:null, nivel:'N3' },
  { nombre:'Red de Servicios de La Placeta', id:'GDLP-AP64-583', tipo:'RSP', vol:stats.saldoActual, nivel:'N3' },
  { nombre:'Placeta Junior', id:'GDLP-AP76-179', tipo:'Infancia', vol:null, nivel:'N2' }
];
%>
<div class="v-card">
  <div class="v-card-head">
    <div>
      <div class="v-card-title">Directorio de Entidades</div>
      <div class="v-card-sub">Visión general del ecosistema conectado</div>
    </div>
    <div style="display:flex;gap:8px;align-items:center;width:100%;max-width:340px">
      <div class="v-search" style="flex:1"><span class="ms">search</span><input id="dirSearch" placeholder="Buscar entidad..."></div>
      <button class="btn-icon" title="Filtrar"><span class="ms" style="font-size:18px">filter_list</span></button>
    </div>
  </div>
  <div style="overflow-x:auto">
    <table class="v-table" id="dirTable">
      <thead>
        <tr><th>Entidad</th><th>Tipo</th><th>Volumen (Pz)</th><th>Estado Fiscal</th><th>Nivel Identidad</th><th class="v-cell-right">Acción</th></tr>
      </thead>
      <tbody>
        <% ENTIDADES_DIR.forEach(function(e) { %>
        <tr>
          <td>
            <div class="v-entity-name"><%= e.nombre %></div>
            <div class="v-entity-id">ID: <%= e.id %></div>
          </td>
          <td><span class="v-chip"><%= e.tipo %></span></td>
          <td class="v-cell-mono"><%= e.vol != null ? e.vol.toFixed(2) : '—' %></td>
          <td><span class="v-status v-status--ok"><span class="ms" style="font-size:15px">check_circle</span> Regular</span></td>
          <td>
            <div class="v-level">
              <div class="v-level-track"><div class="v-level-fill" style="width:<%= e.nivel === 'N3' ? '100%' : '66%' %>"></div></div>
              <span class="v-level-label"><%= e.nivel %></span>
            </div>
          </td>
          <td class="v-cell-right"><button class="v-more" title="Acciones"><span class="ms">more_vert</span></button></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<!-- ═══ TARIFAS ═══ -->
<div class="rsp-section-title">💰 Tarifas Vigentes</div>
<div class="rsp-tarifas">
  <div class="rsp-tarifa-card rsp-tarifa-consulta">
    <div class="rsp-tarifa-header">
      <span class="rsp-tarifa-badge">CONSULTA</span>
      <span class="rsp-tarifa-precio"><%= tarifas.consulta.total.toFixed(4) %></span>
      <span class="rsp-tarifa-moneda">Pz/conexión</span>
    </div>
    <div class="rsp-tarifa-body">
      <div class="rsp-tarifa-detalle">
        <span>Base</span><span><%= tarifas.consulta.precio %> Pz</span>
      </div>
      <div class="rsp-tarifa-detalle">
        <span>IVA 12%</span><span><%= tarifas.consulta.iva.toFixed(4) %> Pz</span>
      </div>
      <p class="rsp-tarifa-desc"><%= tarifas.consulta.descripcion %></p>
    </div>
  </div>
  <div class="rsp-tarifa-card rsp-tarifa-mod">
    <div class="rsp-tarifa-header">
      <span class="rsp-tarifa-badge">MODIFICACIÓN</span>
      <span class="rsp-tarifa-precio"><%= tarifas.modificacion.total.toFixed(3) %></span>
      <span class="rsp-tarifa-moneda">Pz/conexión</span>
    </div>
    <div class="rsp-tarifa-body">
      <div class="rsp-tarifa-detalle">
        <span>Base</span><span><%= tarifas.modificacion.precio %> Pz</span>
      </div>
      <div class="rsp-tarifa-detalle">
        <span>IVA 12%</span><span><%= tarifas.modificacion.iva.toFixed(3) %> Pz</span>
      </div>
      <p class="rsp-tarifa-desc"><%= tarifas.modificacion.descripcion %></p>
    </div>
  </div>
</div>

<!-- ═══ ACCIONES RÁPIDAS ═══ -->
<div class="rsp-section-title">⚡ Acceso Rápido</div>
<div class="rsp-acciones">
  <a href="/rsp/conexiones" class="rsp-btn rsp-btn-primary">
    <span class="rsp-btn-icon">📡</span>
    <span class="rsp-btn-text">Ver Conexiones</span>
    <span class="rsp-btn-arrow">→</span>
  </a>
  <a href="/rsp/facturacion" class="rsp-btn rsp-btn-secondary">
    <span class="rsp-btn-icon">📄</span>
    <span class="rsp-btn-text">Facturación</span>
    <span class="rsp-btn-arrow">→</span>
  </a>
  <a href="/rsp/fondos" class="rsp-btn rsp-btn-secondary">
    <span class="rsp-btn-icon">💰</span>
    <span class="rsp-btn-text">Fondos</span>
    <span class="rsp-btn-arrow">→</span>
  </a>
  <a href="/rsp/apis" class="rsp-btn rsp-btn-outline">
    <span class="rsp-btn-icon">🔌</span>
    <span class="rsp-btn-text">APIs</span>
    <span class="rsp-btn-arrow">→</span>
  </a>
</div>

<!-- ═══ VOTACIONES ═══ -->
<% if (votaciones) { %>
<div class="rsp-section-title">🗳️ Votaciones (PlacetaID — datos reales)</div>
<div class="rsp-card">
  <div class="rsp-card-header">
    <span>
      <% if (votaciones.total === 1) { %>1 votación<% } else { %><%= votaciones.total %> votaciones<% } %>
      ·
      <% if (votaciones.activas === 1) { %>1 activa<% } else { %><%= votaciones.activas %> activas<% } %>
    </span>
    <a href="/junta/votaciones" class="rsp-link">Gestionar →</a>
  </div>
  <div style="padding:12px;font-size:13px;display:flex;gap:20px;flex-wrap:wrap">
    <span>🟢 Activas: <strong><%= votaciones.activas %></strong></span>
    <span>✅ Cerradas: <strong><%= votaciones.cerradas %></strong></span>
    <span>📊 Votos emitidos: <strong><%= votaciones.totalVotos %></strong></span>
  </div>
</div>
<% } %>

<!-- ═══ ÚLTIMAS CONEXIONES ═══ -->
<div class="rsp-section-title">📡 Últimas Conexiones</div>
<div class="rsp-card">
  <div class="rsp-card-header">
    <span>Registro de actividad reciente</span>
    <a href="/rsp/conexiones" class="rsp-link">Ver todas →</a>
  </div>
  <% if (conexionesRecientes.length === 0) { %>
  <div class="rsp-empty">
    <div class="rsp-empty-icon">📡</div>
    <h3>Sin conexiones registradas</h3>
    <p>Las conexiones aparecerán automáticamente al usar las APIs.</p>
  </div>
  <% } else { %>
  <div class="rsp-table-wrap">
    <table>
      <thead>
        <tr><th>ID</th><th>Tipo</th><th>Endpoint</th><th>Coste</th><th>Fecha</th></tr>
      </thead>
      <tbody>
        <% conexionesRecientes.forEach(function(c) { %>
        <tr>
          <td class="text-mono"><%= c.id %></td>
          <td>
            <span class="badge <%= c.tipo === 'modificacion' ? 'badge-warning' : 'badge-info' %>">
              <%= c.tipo === 'modificacion' ? '✏️ MOD' : '👁️ CON' %>
            </span>
          </td>
          <td style="font-size:11px;max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= c.endpoint %></td>
          <td><strong><%= c.total.toFixed(4) %></strong> Pz</td>
          <td style="font-size:11px;color:#888"><%= new Date(c.timestamp).toLocaleString('es-ES') %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>

<!-- Facturas pendientes -->
<% if (facturasPendientes.length > 0) { %>
<div class="info-card mt-16">
  <div class="section-header">
    <h4>⚠️ Facturas Pendientes</h4>
    <a href="/rsp/facturacion" class="btn-link">Ver todas →</a>
  </div>
  <div class="table-container" style="border:none;border-radius:0">
    <table>
      <thead><tr><th>Factura</th><th>Entidad</th><th>Conexiones</th><th>Total</th><th>Emitida</th></tr></thead>
      <tbody>
        <% facturasPendientes.forEach(f => { %>
        <tr>
          <td class="id-cell"><%= f.id %></td>
          <td><span class="badge badge-purple"><%= f.entidad %></span></td>
          <td><%= f.detalle.consultas %> cons + <%= f.detalle.modificaciones %> mod</td>
          <td><strong style="color:var(--go)"><%= f.detalle.total.toFixed(2) %></strong> Pz</td>
          <td style="font-size:11px;color:#888"><%= new Date(f.emitida).toLocaleString('es-ES') %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

<!-- Info normativa -->
<div class="v-card mt-16">
  <div class="v-card-head">
    <div>
      <div class="v-card-title">📜 Resumen Normativo — RSP</div>
      <div class="v-card-sub">Estado del marco regulatorio y obligaciones</div>
    </div>
  </div>
  <div class="v-card-body" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px">
    <div style="padding:14px;background:var(--vs-low);border:1px solid var(--vs-stroke);border-radius:12px">
      <strong style="color:#a5b4fc;font-size:12px">💰 Transferencia Inicial</strong>
      <p style="font-size:11px;color:var(--tm);margin-top:3px">18,309.83 Pz transferidos desde "Red del Grupo de La Placeta"</p>
    </div>
    <div style="padding:14px;background:var(--vs-low);border:1px solid var(--vs-stroke);border-radius:12px">
      <strong style="color:#a5b4fc;font-size:12px">🚫 Facturas Anuladas</strong>
      <p style="font-size:11px;color:var(--tm);margin-top:3px">Facturas pendientes por cambios bancarios quedan anuladas. Más de 20,000 Pz liberados.</p>
    </div>
    <div style="padding:14px;background:rgba(245,158,11,.1);border:1px solid rgba(245,158,11,.35);border-radius:12px">
      <strong style="color:#fbbf24;font-size:12px">⚠️ Sanción IVA Pendiente</strong>
      <p style="font-size:11px;color:var(--tm);margin-top:3px">2,461.77 Pz por IVA no abonado a la administración. <a href="/rsp/fondos" class="btn-link">Gestionar →</a></p>
    </div>
    <div style="padding:14px;background:var(--vs-low);border:1px solid var(--vs-stroke);border-radius:12px">
      <strong style="color:#a5b4fc;font-size:12px">🏛️ Entidades Conectadas</strong>
      <p style="font-size:11px;color:var(--tm);margin-top:3px">Banco, Tributos, Junta, Administración y entidades públicas de GDLP</p>
    </div>
  </div>
</div>
</div>
<script>
(function () {
  const input = document.getElementById('dirSearch');
  const table = document.getElementById('dirTable');
  if (!input || !table) return;
  input.addEventListener('input', function () {
    const q = this.value.trim().toLowerCase();
    table.querySelectorAll('tbody tr').forEach(function (row) {
      row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
    });
  });
})();
</script>
