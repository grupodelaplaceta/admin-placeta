<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;flex-wrap:wrap;gap:10px">
  <div><a href="/rsp/incidencias" class="btn btn-sm btn-ghost">← Incidencias</a></div>
  <div style="display:flex;gap:8px">
    <% if (esAdmin) { %>
    <button class="btn btn-sm btn-outline" onclick="asignarResponsable()">👤 Asignar responsable</button>
    <% } %>
    <% if (esAdmin && !['resuelta','cerrada'].includes(inc.estado)) { %>
    <button class="btn btn-sm btn-warning" onclick="cambiarEstado()">↔️ Cambiar estado</button>
    <% } %>
  </div>
</div>

<div class="rsp-hero" style="background:linear-gradient(135deg,#7a2e00 0%,#e65100 100%)">
  <div class="rsp-hero-content">
    <div style="width:80px;height:80px;border-radius:16px;background:rgba(255,255,255,.13);display:flex;align-items:center;justify-content:center;font-size:38px">⚠️</div>
    <div style="flex:1">
      <div class="rsp-hero-title"><%= inc.id %></div>
      <div class="rsp-hero-sub" style="font-size:17px;opacity:.95"><%= inc.titulo %></div>
      <div class="rsp-hero-stats">
        <span>Origen: <strong><%= inc.origen %></strong></span>
        <span>Gravedad: <strong><%= inc.gravedad %></strong></span>
        <span>Estado: <strong><%= inc.estado %></strong></span>
      </div>
    </div>
  </div>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px">
  <div>
    <div class="table-container" style="margin-bottom:16px">
      <div style="padding:12px 16px;font-weight:700;font-size:13px;border-bottom:1px solid #e8e4f0">📋 Datos</div>
      <table>
        <tbody>
          <tr><th style="width:160px">Descripción</th><td><%= inc.descripcion || '—' %></td></tr>
          <tr><th>Usuario (DIP)</th><td><%= inc.usuario_dip || '—' %></td></tr>
          <tr><th>Entidad (EIP)</th><td><%= inc.entidad_eip || '—' %></td></tr>
          <tr><th>Responsable</th><td><%= inc.responsable_nombre ? inc.responsable_nombre + (inc.responsable_dip?' ('+inc.responsable_dip+')':'') : '—' %></td></tr>
          <tr><th>Resolución</th><td><%= inc.resolucion || '—' %></td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="table-container">
    <div style="padding:12px 16px;font-weight:700;font-size:13px;border-bottom:1px solid #e8e4f0">🕘 Historial</div>
    <table>
      <thead><tr><th>Fecha</th><th>Estado</th><th>Usuario</th><th>Nota</th></tr></thead>
      <tbody>
        <% (inc.historial||[]).slice().reverse().forEach(function(h) { %>
        <tr>
          <td style="font-size:11px"><%= h.fecha ? h.fecha.slice(0,16).replace('T',' ') : '—' %></td>
          <td><span class="badge badge-purple"><%= h.estado %></span></td>
          <td><%= h.usuario || h.dip || '—' %></td>
          <td style="font-size:12px"><%= h.nota || '—' %></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<script>
function cambiarEstado(){
  const estado = prompt('Nuevo estado (' + ['abierta','en_revision','en_resolucion','resuelta','cerrada'].join(', ') + '):', '<%= inc.estado %>');
  if(!estado) return;
  const nota = prompt('Nota / resolución:');
  fetch('/rsp/incidencias/api/incidencias/<%= inc.id %>/estado', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ estado, nota }) })
    .then(r=>r.json()).then(j=>{ if(!j.success){ alert('Error: '+j.error); return; } window.location.reload(); }).catch(e=>alert('Error: '+e.message));
}
function asignarResponsable(){
  const dip = prompt('DIP del responsable:');
  if(!dip) return;
  const nombre = prompt('Nombre del responsable:');
  fetch('/rsp/incidencias/api/incidencias/<%= inc.id %>/responsable', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ dip, nombre }) })
    .then(r=>r.json()).then(j=>{ if(!j.success){ alert('Error: '+j.error); return; } window.location.reload(); }).catch(e=>alert('Error: '+e.message));
}
</script>
